{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AIL",
  "scopeName": "source.ail",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#colors" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#components" },
    { "include": "#styles" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ail",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.ail",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ail",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ail",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ail",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "constant.other.color.hex.ail",
          "match": "#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ail",
          "match": "\\b[0-9]+(\\.[0-9]+)?(px|rem|em|%|vh|vw|ms|s)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ail",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.ail",
          "match": "\\b(nil|null)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ail",
          "match": "\\b(if|elif|else|match|case|ret|return|for|in|while)\\b"
        },
        {
          "name": "keyword.declaration.ail",
          "match": "\\b(module|from|import|as|type|fn|component|style|let|mut)\\b"
        },
        {
          "name": "keyword.operator.logical.ail",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ail",
          "match": "\\b(int|str|float|bool|num|byte|char|void|nil)\\b"
        },
        {
          "name": "storage.type.container.ail",
          "match": "\\b(Option|Result)\\b"
        },
        {
          "name": "entity.name.type.ail",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.ail" },
            "2": { "name": "entity.name.function.ail" }
          }
        },
        {
          "name": "support.function.call.ail",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\()"
        }
      ]
    },
    "components": {
      "patterns": [
        {
          "match": "\\b(component)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.ail" },
            "2": { "name": "entity.name.tag.component.ail" }
          }
        }
      ]
    },
    "styles": {
      "patterns": [
        {
          "match": "\\b(style)\\s+(\"[^\"]+\"|[a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.ail" },
            "2": { "name": "entity.name.tag.style.ail" }
          }
        },
        {
          "name": "support.type.property-name.css.ail",
          "match": "^\\s*(--?[a-zA-Z_][a-zA-Z0-9_-]*)(?=:)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ail",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.comparison.ail",
          "match": "(===?|!==?|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.ail",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.coalesce.ail",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.try.ail",
          "match": "\\?(?!\\.)"
        },
        {
          "name": "keyword.operator.safe-nav.ail",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.arithmetic.ail",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.ail",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.delimiter.colon.ail",
          "match": ":"
        },
        {
          "name": "punctuation.delimiter.comma.ail",
          "match": ","
        },
        {
          "name": "punctuation.delimiter.dot.ail",
          "match": "\\."
        },
        {
          "name": "punctuation.bracket.round.ail",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.ail",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.curly.ail",
          "match": "[{}]"
        }
      ]
    }
  }
}
