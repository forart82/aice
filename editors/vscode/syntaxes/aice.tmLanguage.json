{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AICE",
  "scopeName": "source.aice",
  "patterns": [
    { "include": "#comments" },
    { "include": "#idioms" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#colors" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#components" },
    { "include": "#styles" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "idioms": {
      "patterns": [
        {
          "name": "variable.parameter.idiom.aice",
          "match": "\\$[0-9]+\\b"
        },
        {
          "name": "entity.name.function.idiom.aice",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.aice",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.aice",
          "match": "//.*$"
        },
        {
          "name": "comment.block.aice",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aice",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aice",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "constant.other.color.hex.aice",
          "match": "#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.aice",
          "match": "\\b[0-9]+(\\.[0-9]+)?(px|rem|em|%|vh|vw|ms|s)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.aice",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.aice",
          "match": "\\b(nil|null)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aice",
          "match": "\\b(if|elif|else|match|case|ret|return|for|in|while|break|continue|yield|try|catch|finally|throw|async|await)\\b"
        },
        {
          "name": "keyword.declaration.aice",
          "match": "\\b(module|from|import|as|type|fn|component|style|let|mut|val|prop|class|interface|enum|struct|pub)\\b"
        },
        {
          "name": "keyword.operator.logical.aice",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.aice",
          "match": "\\b(int|str|float|bool|num|byte|char|void|nil|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|Any)\\b"
        },
        {
          "name": "storage.type.container.aice",
          "match": "\\b(Option|Result|Vec2|Vec3|Color)\\b"
        },
        {
          "name": "entity.name.type.aice",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aice" },
            "2": { "name": "entity.name.function.aice" }
          }
        },
        {
          "name": "support.function.call.aice",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\()"
        }
      ]
    },
    "components": {
      "patterns": [
        {
          "match": "\\b(component)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aice" },
            "2": { "name": "entity.name.tag.component.aice" }
          }
        }
      ]
    },
    "styles": {
      "patterns": [
        {
          "match": "\\b(style)\\s+(\"[^\"]+\"|[a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aice" },
            "2": { "name": "entity.name.tag.style.aice" }
          }
        },
        {
          "name": "support.type.property-name.css.aice",
          "match": "^\\s*(--?[a-zA-Z_][a-zA-Z0-9_-]*)(?=:)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.aice",
          "match": "(~>|->|=>)"
        },
        {
          "name": "keyword.operator.comparison.aice",
          "match": "(===?|!==?|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.shift.aice",
          "match": "(<<|>>)"
        },
        {
          "name": "keyword.operator.logical.aice",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.coalesce.aice",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.try.aice",
          "match": "\\?(?!\\.)"
        },
        {
          "name": "keyword.operator.safe-nav.aice",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.arithmetic.aice",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.aice",
          "match": "(::=|:=|\\+=|-=|\\*=|/=|%=|<<=|>>=|&=|\\|=|\\^=|=)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.delimiter.colon.aice",
          "match": ":"
        },
        {
          "name": "punctuation.delimiter.comma.aice",
          "match": ","
        },
        {
          "name": "punctuation.delimiter.dot.aice",
          "match": "\\."
        },
        {
          "name": "punctuation.bracket.round.aice",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.aice",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.curly.aice",
          "match": "[{}]"
        }
      ]
    }
  }
}
