{
  "name": "vscode-aice",
  "displayName": "AICE Language Support",
  "description": "Syntax highlighting, bracket matching, indentation rules, and language support for AICE (AI Context Engine)",
  "version": "1.0.0",
  "icon": "icon.png",
  "publisher": "antigravity",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "aice",
    "compiler",
    "bpe",
    "tokenomics",
    "transpiler"
  ],
  "activationEvents": [
    "onLanguage:aice"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "aice",
        "aliases": ["AICE", "aice"],
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        },
        "extensions": [
          ".aice",
          ".ts.aice",
          ".tsx.aice",
          ".js.aice",
          ".mjs.aice",
          ".cjs.aice",
          ".py.aice",
          ".go.aice",
          ".rs.aice",
          ".kt.aice",
          ".kts.aice",
          ".php.aice",
          ".cpp.aice",
          ".hpp.aice",
          ".h.aice",
          ".cc.aice",
          ".cxx.aice",
          ".cs.aice",
          ".css.aice",
          ".html.aice",
          ".twig.aice",
          ".json.aice",
          ".yaml.aice",
          ".yml.aice"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aice",
        "scopeName": "source.aice",
        "path": "./syntaxes/aice.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aice",
        "path": "./snippets/aice.json"
      }
    ],
    "commands": [
      {
        "command": "aice.compile",
        "title": "AICE: Compile Current File",
        "category": "AICE"
      },
      {
        "command": "aice.watch",
        "title": "AICE: Start Bidirectional Watch Daemon",
        "category": "AICE"
      },
      {
        "command": "aice.sync",
        "title": "AICE: Sync Target Changes to AICE",
        "category": "AICE"
      },
      {
        "command": "aice.outline",
        "title": "AICE: Show AST Structural Outline",
        "category": "AICE"
      },
      {
        "command": "aice.context",
        "title": "AICE: Generate Bounded Context Pack",
        "category": "AICE"
      },
      {
        "command": "aice.idiomsScan",
        "title": "AICE: Scan Project Idioms ($idiom)",
        "category": "AICE"
      },
      {
        "command": "aice.idiomsApply",
        "title": "AICE: Apply Project Idioms ($idiom)",
        "category": "AICE"
      },
      {
        "command": "aice.shieldStatus",
        "title": "AICE: Check 4-Layer AI Shield Status",
        "category": "AICE"
      },
      {
        "command": "aice.shieldLock",
        "title": "AICE: Lock Target Files (chmod 444)",
        "category": "AICE"
      },
      {
        "command": "aice.shieldUnlock",
        "title": "AICE: Unlock Target Files (chmod 644)",
        "category": "AICE"
      },
      {
        "command": "aice.test",
        "title": "AICE: Run Symbol-Mapped Test Suite",
        "category": "AICE"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "AICE Configuration",
      "properties": {
        "aice.executablePath": {
          "type": "string",
          "default": "aice",
          "description": "Path to the aice CLI executable"
        }
      }
    }
  }
}
