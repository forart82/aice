{
  "Module Declaration": {
    "prefix": "module",
    "body": [
      "module ${1:app/main}",
      "",
      "$0"
    ],
    "description": "Declare top-level AIL module"
  },
  "Function Block": {
    "prefix": "fn",
    "body": [
      "fn ${1:functionName}(${2:param}:${3:str}) -> ${4:void}:",
      "  $0"
    ],
    "description": "Standard block function"
  },
  "Single-Expression Function": {
    "prefix": "fne",
    "body": [
      "fn ${1:functionName}(${2:param}:${3:int}) = ${4:param * 2}"
    ],
    "description": "Concise single-expression function with inferred return"
  },
  "Record Type": {
    "prefix": "type",
    "body": [
      "type ${1:TypeName}:",
      "  ${2:id}:str",
      "  ${3:name}:str",
      "  $0"
    ],
    "description": "Declare structured record type"
  },
  "Enum Type": {
    "prefix": "type-enum",
    "body": [
      "type ${1:Status}:",
      "  ${2:ACTIVE}",
      "  ${3:PENDING}",
      "  ${4:INACTIVE}"
    ],
    "description": "Declare algebraic enum type"
  },
  "Component DSL": {
    "prefix": "comp",
    "body": [
      "component ${1:ComponentName}(${2:title}:${3:str}):",
      "  div(class: \"${4:container}\"): ",
      "    h1: \"{${2:title}}\"",
      "    $0"
    ],
    "description": "Declarative UI Component with indented layout"
  },
  "Style Block": {
    "prefix": "style",
    "body": [
      "style ${1:selector}:",
      "  margin: 0",
      "  padding: ${2:1rem}",
      "  color: ${3:#fff}",
      "  $0"
    ],
    "description": "Declare CSS style rule"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "  $2",
      "else:",
      "  $0"
    ],
    "description": "Boolean conditional"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "match ${1:target}:",
      "  case ${2:pattern} => ${3:expr}",
      "  case _ => ${0:default}"
    ],
    "description": "Pattern matching statement"
  }
}
