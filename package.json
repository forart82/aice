{
  "name": "aice-compiler",
  "version": "0.9.27",
  "description": "AI-Compact Expression (AICE 2.0) — High-Efficiency Agent-Native Language, Decompiler, and Tokenomics Engine",
  "license": "Apache-2.0",
  "author": {
    "name": "forart82",
    "url": "https://github.com/forart82"
  },
  "homepage": "https://github.com/forart82/aice",
  "keywords": [
    "aice",
    "ai-context-engine",
    "mcp",
    "model-context-protocol",
    "ast",
    "token-optimization",
    "llm",
    "ai-agents",
    "code-splicing",
    "idioms",
    "claude-code",
    "antigravity",
    "codex",
    "opencode",
    "aider"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt",
    "README.md"
  ],
  "bin": {
    "aice": "./bin/aice.mjs"
  },
  "scripts": {
    "aice": "tsx ./bin/aice.ts",
    "test": "vitest run --test-timeout=30000",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "verify:tokenomics": "tsx ./bin/aice.ts verify-tokenomics src",
    "benchmark": "tsx benchmarks/run.ts",
    "benchmark:offline": "tsx benchmarks/run-offline.ts",
    "benchmark:agents": "tsx benchmarks/run-real-agents.ts",
    "bump": "tsx tools/bump-version.ts",
    "build": "tsx tools/build.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "js-tiktoken": "^1.0.21",
    "parse5": "^8.0.1",
    "postcss": "^8.5.29",
    "tsx": "^4.23.15",
    "typescript-legacy": "npm:typescript@5.8.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.14.0",
    "@types/parse5": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "esbuild": "^0.28.2"
  }
}
