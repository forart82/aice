{
  "name": "ail",
  "version": "0.6.5",
  "description": "AIL: Token-Efficient Homoiconic Bidirectional Programming Language & Compiler Engine",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "ail": "./bin/ail.mjs",
    "ail-lsp": "./bin/ail-lsp.mjs"
  },
  "scripts": {
    "ail": "tsx ./bin/ail.ts",
    "fix": "tsx ./bin/ail.ts fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "verify:tokenomics": "tsx ./bin/ail.ts verify-tokenomics examples --check-drift",
    "package:vscode": "cd editors/vscode && bunx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "js-tiktoken": "^1.0.21",
    "parse5": "^8.0.1",
    "postcss": "^8.5.29",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:typescript@5.8.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.14.0",
    "@types/parse5": "^7.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
