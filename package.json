{
  "name": "aice",
  "version": "0.9.9",
  "description": "AICE: On-the-Fly AI Context Engine & Multi-Language $idioms Splicer",
  "license": "Apache-2.0",
  "author": {
    "name": "forart82",
    "url": "https://github.com/forart82"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forart82/aice.git"
  },
  "homepage": "https://github.com/forart82/aice",
  "bugs": {
    "url": "https://github.com/forart82/aice/issues"
  },
  "keywords": [
    "aice",
    "ai-context-engine",
    "mcp",
    "model-context-protocol",
    "ast",
    "token-optimization",
    "llm",
    "ai-agents",
    "code-splicing",
    "idioms",
    "claude-code",
    "antigravity",
    "codex",
    "opencode",
    "aider"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "aice": "./bin/aice.mjs"
  },
  "scripts": {
    "aice": "tsx ./bin/aice.ts",
    "test": "vitest run --test-timeout=30000",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "verify:tokenomics": "tsx ./bin/aice.ts verify-tokenomics src",
    "benchmark": "tsx benchmarks/run.ts",
    "benchmark:offline": "tsx benchmarks/run-offline.ts",
    "benchmark:agents": "tsx benchmarks/run-real-agents.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "js-tiktoken": "^1.0.21",
    "parse5": "^8.0.1",
    "postcss": "^8.5.29",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:typescript@5.8.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.14.0",
    "@types/parse5": "^7.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
