module engine

# Snake Core Game Engine.
# High-performance 2D grid-based arcade snake engine.
type Point:
  x:int
  y:int

type Velocity:
  dx:int
  dy:int

type SnakeSegment:
  position:Point
  age:int

type Direction = "UP" | "DOWN" | "LEFT" | "RIGHT"

type GameConfig:
  gridWidth:int
  gridHeight:int
  initialSpeed:int
  speedIncrement:int
  foodScoreValue:int
  goldenFoodBonus:int

type EngineStats:
  score:int
  highScore:int
  applesEaten:int
  movesCount:int
  aliveTimeSeconds:int

# Main game simulation engine.
pub class Engine:
  width: int
  height: int
  score: int = 0
  highScore: int = 0
  alive: bool = true
  paused: bool = false
  head: Point
  segments: [Point] = []
  food: Point
  goldenFood: Point? = nil
  currentDirection: Direction = "RIGHT"
  nextDirection: Direction = "RIGHT"
  movesCount: int = 0
  applesEaten: int = 0
  fn constructor(width:int = 30, height:int = 20):
    this.width = width
    this.height = height
    this.head = { x: floor(width / 2), y: floor(height / 2) }
    this.segments = [{ x: this.head.x - 1, y: this.head.y }, { x: this.head.x - 2, y: this.head.y }]
    this.food = this.spawnFood()
  fn step() -> bool:
    if not this.alive or this.paused:
      ret false
    this.currentDirection = this.nextDirection
    nextHead := this.getNextHeadPosition()
    if this.checkWallCollision(nextHead) or this.checkSelfCollision(nextHead):
      this.alive = false
      ret false
    this.segments.unshift({ x: this.head.x, y: this.head.y })
    this.head = nextHead
    this.movesCount += 1
    if this.head.x == this.food.x and this.head.y == this.food.y:
      this.score += 10
      this.applesEaten += 1
      if this.score > this.highScore:
        this.highScore = this.score
      this.food = this.spawnFood()
    else:
      this.segments.pop()
    true
  fn reset() -> void:
    this.score = 0
    this.alive = true
    this.paused = false
    this.currentDirection = "RIGHT"
    this.nextDirection = "RIGHT"
    this.movesCount = 0
    this.applesEaten = 0
    this.head = { x: floor(this.width / 2), y: floor(this.height / 2) }
    this.segments = [{ x: this.head.x - 1, y: this.head.y }, { x: this.head.x - 2, y: this.head.y }]
    this.food = this.spawnFood()
    this.goldenFood = nil
  fn changeDirection(newDir:Direction) -> bool:
    if this.currentDirection == "UP" and newDir == "DOWN":
      ret false
    if this.currentDirection == "DOWN" and newDir == "UP":
      ret false
    if this.currentDirection == "LEFT" and newDir == "RIGHT":
      ret false
    if this.currentDirection == "RIGHT" and newDir == "LEFT":
      ret false
    this.nextDirection = newDir
    true
  fn spawnFood() -> Point:
    occupied := Set()
    occupied.add(`${this.head.x},${this.head.y}`)
    for seg in this.segments:
      occupied.add(`${seg.x},${seg.y}`)
    candidateX ::= floor(Math.random() * this.width)
    candidateY ::= floor(Math.random() * this.height)
    attempts ::= 0
    while occupied.has(`${candidateX},${candidateY}`) and attempts < 100:
      candidateX = floor(Math.random() * this.width)
      candidateY = floor(Math.random() * this.height)
      attempts += 1
    { x: candidateX, y: candidateY }
  fn checkWallCollision(pos:Point) -> bool = pos.x < 0 or pos.x >= this.width or pos.y < 0 or pos.y >= this.height
  fn checkSelfCollision(pos:Point) -> bool:
    for seg in this.segments:
      if seg.x == pos.x and seg.y == pos.y:
        ret true
    false
  fn getLength() -> int = 1 + this.segments.length
  fn getStats() -> EngineStats = { score: this.score, highScore: this.highScore, applesEaten: this.applesEaten, movesCount: this.movesCount, aliveTimeSeconds: 0 }
  fn isOccupied(x:int, y:int) -> bool:
    if this.head.x == x and this.head.y == y:
      ret true
    for seg in this.segments:
      if seg.x == x and seg.y == y:
        ret true
    false
  fn setPaused(paused:bool) -> void = (this.paused = paused)
  fn isAlive() -> bool = this.alive
  fn getScore() -> int = this.score
  fn getNextHeadPosition() -> Point:
    match this.currentDirection:
      case "UP" =>
        ret { x: this.head.x, y: this.head.y - 1 }
      case "DOWN" =>
        ret { x: this.head.x, y: this.head.y + 1 }
      case "LEFT" =>
        ret { x: this.head.x - 1, y: this.head.y }
      case "RIGHT" =>
        ret { x: this.head.x + 1, y: this.head.y }
  fn calculateScoreMultiplier() -> int:
    multiplier ::= 1
    if this.applesEaten > 10:
      multiplier = 2
    if this.applesEaten > 25:
      multiplier = 3
    if this.applesEaten > 50:
      multiplier = 5
    multiplier
  fn serialize() -> str:
    payload := { score: this.score, highScore: this.highScore, alive: this.alive, head: this.head, segments: this.segments, moves: this.movesCount }
    JSON.stringify(payload)
  fn renderAscii() -> str:
    grid: [[str]] := []
    r ::= 0
    while r < this.height:
      grid.push(Array(this.width).fill("."))
      r = r + 1
    grid[this.head.y][this.head.x] = "@"
    for seg in this.segments:
      grid[seg.y][seg.x] = "o"
    grid[this.food.y][this.food.x] = "*"
    grid.map(fn(row) = row.join("")).join("""


""")
  fn tickPhysics(deltaSeconds:int) -> void:
    if not this.alive:
      ret
    this.step()
  fn applyPowerup(type:str, durationSeconds:int) -> void:
    if type == "speed":
      this.movesCount += 2
    elif type == "shield":
      this.score += 50
    elif type == "double_points":
      this.score += 100
  fn getDebugInfo() -> str:
    lines: [str] := []
    lines.push("Score: " + this.score)
    lines.push("Alive: " + this.alive)
    lines.push("Direction: " + this.currentDirection)
    lines.push("Length: " + this.getLength())
    lines.push("Head: " + this.head.x + "," + this.head.y)
    lines.join("; ")
  fn validateState() -> bool:
    if this.head.x < 0 or this.head.x >= this.width:
      ret false
    if this.head.y < 0 or this.head.y >= this.height:
      ret false
    if this.segments.length < 1:
      ret false
    true
