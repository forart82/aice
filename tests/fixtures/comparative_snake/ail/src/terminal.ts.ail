module terminal

from "../core/ai.js" import SnakeAI
from "../core/engine.js" import GameEngine
from "../core/types.js" import Direction, GameMode

# ANSI escape sequences
const ANSI = { enterAltScreen: "\u001b[?1049h", leaveAltScreen: "\u001b[?1049l", hideCursor: "\u001b[?25l", showCursor: "\u001b[?25h", clear: "\u001b[2J\u001b[H", reset: "\u001b[0m", bold: "\u001b[1m", dim: "\u001b[2m", cyan: "\u001b[36m", brightCyan: "\u001b[36;1m", green: "\u001b[32m", brightGreen: "\u001b[32;1m", yellow: "\u001b[33m", brightYellow: "\u001b[33;1m", magenta: "\u001b[35m", brightMagenta: "\u001b[35;1m", red: "\u001b[31m", brightRed: "\u001b[31;1m", white: "\u001b[37;1m", gray: "\u001b[90m", bgDark: "\u001b[40m" }

class TerminalSnakeGame:
  engine: GameEngine
  isAIBotActive: bool = false
  isRunning: bool = true
  timer: NodeJS.Timeout? = nil
  width: int = 22
  height: int = 18
  currentMode: GameMode = "CLASSIC"
  fn constructor():
    this.engine = GameEngine({ width: this.width, height: this.height, mode: this.currentMode, difficulty: "MEDIUM" })
    this.setupExitHandlers()
    this.setupInput()
  fn setupExitHandlers() -> void:
    cleanup := fn() {
      this.isRunning = false;
      if this.timer: {
        clearTimeout(this.timer);
      }
      process.stdout.write(ANSI.showCursor + ANSI.leaveAltScreen);
      if process.stdin.isTTY: {
        process.stdin.setRawMode(false);
      }
      process.exit(0);
    }
    process.on("SIGINT", cleanup)
    process.on("SIGTERM", cleanup)
    process.on("exit", fn() = process.stdout.write(ANSI.showCursor + ANSI.leaveAltScreen))
  fn setupInput() -> void:
    if process.stdin.isTTY:
      process.stdin.setRawMode(true)
    process.stdin.resume()
    process.stdin.setEncoding("utf8")
    process.stdin.on("data", fn(key:str) {
      if key == "\u0003" or key.toLowerCase() == "q": {
        this.exit();
        ret nil;
      }
      if key.toLowerCase() == "p": {
        this.engine.togglePause();
        this.render();
        ret nil;
      }
      if key.toLowerCase() == "r": {
        this.engine.restart();
        this.render();
        ret nil;
      }
      if key.toLowerCase() == "b": {
        this.isAIBotActive = not this.isAIBotActive;
        this.render();
        ret nil;
      }
      if key.toLowerCase() == "m": {
        modes: [GameMode] := ["CLASSIC", "OBSTACLES", "WARP"];
        nextIndex := (modes.indexOf(this.currentMode) + 1) % modes.length;
        this.currentMode = modes[nextIndex];
        state := this.engine.getState();
        this.engine = GameEngine({ width: this.width, height: this.height, mode: this.currentMode, difficulty: state.difficulty, highScore: state.highScore });
        this.render();
        ret nil;
      }
      dir: Direction? ::= nil;
      if key == "\u001b[A" or key.toLowerCase() == "w": {
        dir = "UP";
      } elif key == "\u001b[B" or key.toLowerCase() == "s": {
        dir = "DOWN";
      } elif key == "\u001b[D" or key.toLowerCase() == "a": {
        dir = "LEFT";
      } elif key == "\u001b[C" or key.toLowerCase() == "d": {
        dir = "RIGHT";
      }
      if dir: {
        [(this.isAIBotActive = false), this.engine.setDirection(dir), this.render()];
      }
    })
  fn start() -> void:
    process.stdout.write(ANSI.enterAltScreen + ANSI.hideCursor)
    this.tick()
  fn exit() -> void:
    this.isRunning = false
    if this.timer:
      clearTimeout(this.timer)
    process.stdout.write(ANSI.showCursor + ANSI.leaveAltScreen)
    if process.stdin.isTTY:
      process.stdin.setRawMode(false)
    process.exit(0)
  fn tick() -> void:
    if not this.isRunning:
      ret
    state := this.engine.getState()
    if not state.isPaused and not state.isGameOver:
      if this.isAIBotActive:
        nextDir := SnakeAI.getNextMove(state)
        this.engine.setDirection(nextDir)
      this.engine.step()
    this.render()
    interval := this.engine.getTickInterval()
    this.timer = setTimeout(fn() = this.tick(), interval)
  fn render() -> void:
    state := this.engine.getState()
    lines: [str] := []
    lines.push(`${ANSI.brightCyan}╔═══════════════════════════════════════════════════════╗${ANSI.reset}`)
    lines.push(`${ANSI.brightCyan}║${ANSI.bold}${ANSI.brightYellow}          ★ CYBER SNAKE TS // TERMINAL EDITION ★        ${ANSI.brightCyan}║${ANSI.reset}`)
    lines.push(`${ANSI.brightCyan}╚═══════════════════════════════════════════════════════╝${ANSI.reset}`)
    botStatus := (this.isAIBotActive and `${ANSI.brightMagenta}[AI BOT ON]${ANSI.reset}`) or `${ANSI.gray}[MANUAL]${ANSI.reset}`
    comboStr := (state.combo > 1 and `${ANSI.brightYellow}x${state.combo} COMBO!${ANSI.reset}`) or `${ANSI.gray}x1${ANSI.reset}`
    activeBuffs: [str] := []
    if state.activeEffects.some(fn(e) = e.type == "SPEED_BOOST"):
      activeBuffs.push(`${ANSI.brightYellow}⚡SPEED${ANSI.reset}`)
    if state.activeEffects.some(fn(e) = e.type == "POISON"):
      activeBuffs.push(`${ANSI.brightMagenta}☠POISON${ANSI.reset}`)
    buffStr := (activeBuffs.length > 0 and activeBuffs.join(" ")) or `${ANSI.gray}None${ANSI.reset}`
    lines.push(` ${ANSI.white}Score:${ANSI.brightGreen} ${state.score.toString().padEnd(5)}${ANSI.reset} ` + `${ANSI.white}High:${ANSI.brightYellow} ${state.highScore.toString().padEnd(5)}${ANSI.reset} ` + `${ANSI.white}Lvl:${ANSI.brightCyan} ${state.level}${ANSI.reset} ` + `${ANSI.white}Combo:${ANSI.reset} ${comboStr}  ` + `${ANSI.white}Mode:${ANSI.brightCyan} ${state.mode}${ANSI.reset}  ` + `${botStatus}`)
    lines.push(` ${ANSI.dim}Buffs: ${buffStr}${ANSI.reset}`)
    lines.push("")
    grid: [[str]] := Array.from({ length: this.height }, fn() = Array.from({ length: this.width }, fn() = "  "))
    for obs in state.obstacles:
      if obs.x >= 0 and obs.x < this.width and obs.y >= 0 and obs.y < this.height:
        grid[obs.y][obs.x] = `${ANSI.gray}██${ANSI.reset}`
    for food in state.foods:
      if food.position.x >= 0 and food.position.x < this.width and food.position.y >= 0 and food.position.y < this.height:
        icon ::= "◆ "
        match food.type:
          case "NORMAL" =>
            icon = `${ANSI.brightRed}♥ ${ANSI.reset}`
          case "GOLDEN" =>
            icon = `${ANSI.brightYellow}★ ${ANSI.reset}`
          case "SPEED_BOOST" =>
            icon = `${ANSI.brightCyan}⚡${ANSI.reset} `
          case "POISON" =>
            icon = `${ANSI.brightMagenta}☠ ${ANSI.reset}`
        grid[food.position.y][food.position.x] = icon
    body := state.snake.body
    i ::= body.length - 1
    while i >= 0:
      seg := body[i]
      if seg.x >= 0 and seg.x < this.width and seg.y >= 0 and seg.y < this.height:
        if i == 0:
          headChar ::= "► "
          if state.snake.direction == "UP":
            headChar = "▲ "
          elif state.snake.direction == "DOWN":
            headChar = "▼ "
          elif state.snake.direction == "LEFT":
            headChar = "◄ "
          elif state.snake.direction == "RIGHT":
            headChar = "► "
          headColor := (state.isGameOver and ANSI.brightRed) or ANSI.brightGreen
          grid[seg.y][seg.x] = `${headColor}${headChar}${ANSI.reset}`
        else:
          color := (i % 2 == 0 and ANSI.green) or ANSI.brightGreen
          grid[seg.y][seg.x] = `${color}██${ANSI.reset}`
      i = i - 1
    lines.push(`┌${"──".repeat(this.width)}┐`)
    y ::= 0
    while y < this.height:
      rowStr ::= "│"
      x ::= 0
      while x < this.width:
        rowStr += grid[y][x]
        x = x + 1
      rowStr += "│"
      if state.isGameOver:
        midY := floor(this.height / 2)
        if y == midY - 2:
          rowStr = `│${"  ".repeat(floor((this.width - 10) / 2))}${ANSI.brightRed}${ANSI.bold}╔════════════════════╗${ANSI.reset}${"  ".repeat(ceil((this.width - 10) / 2))}│`
        elif y == midY - 1:
          rowStr = `│${"  ".repeat(floor((this.width - 10) / 2))}${ANSI.brightRed}${ANSI.bold}║    GAME OVER!      ║${ANSI.reset}${"  ".repeat(ceil((this.width - 10) / 2))}│`
        elif y == midY:
          scoreMsg := `Score: ${state.score}`.padStart(12).padEnd(20)
          rowStr = `│${"  ".repeat(floor((this.width - 10) / 2))}${ANSI.brightYellow}${ANSI.bold}║${scoreMsg}║${ANSI.reset}${"  ".repeat(ceil((this.width - 10) / 2))}│`
        elif y == midY + 1:
          rowStr = `│${"  ".repeat(floor((this.width - 10) / 2))}${ANSI.brightRed}${ANSI.bold}║ [R] Restart [Q]Quit║${ANSI.reset}${"  ".repeat(ceil((this.width - 10) / 2))}│`
        elif y == midY + 2:
          rowStr = `│${"  ".repeat(floor((this.width - 10) / 2))}${ANSI.brightRed}${ANSI.bold}╚════════════════════╝${ANSI.reset}${"  ".repeat(ceil((this.width - 10) / 2))}│`
      elif state.isPaused:
        midY := floor(this.height / 2)
        if y == midY:
          rowStr = `│${"  ".repeat(floor((this.width - 8) / 2))}${ANSI.brightYellow}${ANSI.bold} [PAUSED - Press P] ${ANSI.reset}${"  ".repeat(ceil((this.width - 8) / 2))}│`
      lines.push(rowStr)
      y = y + 1
    lines.push(`└${"──".repeat(this.width)}┘`)
    lines.push("")
    lines.push(`${ANSI.dim}Controls:${ANSI.reset} ${ANSI.white}[WASD/Arrows]${ANSI.reset} Move  ` + `${ANSI.white}[P]${ANSI.reset} Pause  ` + `${ANSI.white}[R]${ANSI.reset} Restart  ` + `${ANSI.white}[B]${ANSI.reset} AI Bot  ` + `${ANSI.white}[M]${ANSI.reset} Mode  ` + `${ANSI.white}[Q]${ANSI.reset} Quit`)
    process.stdout.write(ANSI.clear + lines.join("""


""") + """


""")

# CLI Arguments handling
const args = process.argv.slice(2)

# Start terminal game if executed directly
const game = TerminalSnakeGame()

_ := game.start()
