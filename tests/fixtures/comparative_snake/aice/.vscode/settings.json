{
  "files.exclude": {
    "**/*.ts": {
      "when": "$(basename).ts.aice"
    },
    "**/*.tsx": {
      "when": "$(basename).tsx.aice"
    },
    "**/*.css": {
      "when": "$(basename).css.aice"
