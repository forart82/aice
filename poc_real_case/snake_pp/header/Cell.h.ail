# snake_pp.header.Cell.h

class Cell:
  key: str = ""
  top: int = 0
  left: int = 0
  bottom: int = 0
  right: int = 0
  posX: float = 0.0
  posY: float = 0.0

  fn update() -> void:
    ret
  fn setPosition(x:float, y:float) -> void:
    ret
  fn setKey() -> void:
    ret
  fn getKey() -> str:
    ret this.key
