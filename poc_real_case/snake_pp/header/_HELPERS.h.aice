# snake_pp.header._HELPERS.h

fn SNAP_TO_GRID(value:int) -> int:
  ret (value / 32) * 32

fn MAKE_CELL_KEY(top:int, right:int, bottom:int, left:int) -> str:
  ret top.toString() + right.toString() + bottom.toString() + left.toString()

fn GET_RANDOM_NUMBER(minVal:int, maxVal:int) -> int:
  ret minVal
