# snake_pp.source.Point.cpp

type Vector2f:
  x: float
  y: float

class Point:
  counter: int = 150
  score: int = 0
  posX: float = 0.0
  posY: float = 0.0

  fn init(x:float, y:float, scoreVal:int) -> void:
    this.posX = x
    this.posY = y
    this.score = scoreVal
    this.counter = 150

  fn animation() -> void:
    ret

  fn update() -> void:
    this.counter = this.counter - 1
    this.posY = this.posY - 1.0

  fn getCounter() -> int:
    ret this.counter
