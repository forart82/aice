# snake_pp.source.Grid.cpp

class Grid(numCells:int = 475):

  fn createStartZone() -> void:
    cellCounter:int ::= 0
    height:int ::= 32
    while height < 608:
      width:int ::= 0
      while width < 800:
        cellCounter = cellCounter + 1
        width = width + 32
      height = height + 32

  fn update() -> void:
    ret
