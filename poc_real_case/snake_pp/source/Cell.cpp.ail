# snake_pp.source.Cell.cpp

class Cell:
  key: str = ""
  top: int = 0
  left: int = 0
  bottom: int = 0
  right: int = 0
  posX: float = 0.0
  posY: float = 0.0

  fn setPosition(x:float, y:float) -> void:
    this.posX = x
    this.posY = y
    this.top = (y.toInt() / 32) * 32
    this.right = ((x.toInt() + 32) / 32) * 32
    this.bottom = ((y.toInt() + 32) / 32) * 32
    this.left = (x.toInt() / 32) * 32
    this.key = this.top.toString() + this.right.toString() + this.bottom.toString() + this.left.toString()

  fn setKey() -> void:
    this.key = this.top.toString() + this.right.toString() + this.bottom.toString() + this.left.toString()

  fn getKey() -> str:
    ret this.key

  fn update() -> void:
    ret
