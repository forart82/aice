# snake_pp.source.Grid.cpp

class Grid(numCells:int = 475):

  fn createStartZone() -> void:
    let mut cellCounter:int = 0
    let mut height:int = 32
    while height < 608:
      let mut width:int = 0
      while width < 800:
        cellCounter = cellCounter + 1
        width = width + 32
      height = height + 32

  fn update() -> void:
    ret
