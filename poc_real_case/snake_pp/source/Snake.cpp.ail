# snake_pp.source.Snake.cpp

enum Direction:
  Up
  Left
  Right
  Down

class Snake:
  size: int = 3
  speed: float = 0.1
  time: float = 0.0
  direction: Direction = Direction.Right
  isMoving: bool = false
  canSwitchDirection: bool = true
  score: float = 0.0
  speedCounter: float = 0.1
  isDead: bool = false
  headX: float = 300.0
  headY: float = 300.0

  fn make() -> void:
    this.size = 3
    this.speed = 0.1
    this.score = 0.0
    this.speedCounter = 0.1
    this.canSwitchDirection = true
    this.isDead = false
    this.direction = Direction.Right
    this.isMoving = false
    this.headX = 300.0
    this.headY = 300.0

  fn changePosition() -> void:
    if this.direction == Direction.Up:
      this.headY = this.headY - 32.0
    elif this.direction == Direction.Left:
      this.headX = this.headX - 32.0
    elif this.direction == Direction.Right:
      this.headX = this.headX + 32.0
    elif this.direction == Direction.Down:
      this.headY = this.headY + 32.0

  fn applyBoundaries() -> void:
    if this.headX < 0.0:
      this.headX = 768.0
    if this.headX >= 800.0:
      this.headX = 0.0
    if this.headY < 32.0:
      this.headY = 576.0
    if this.headY >= 608.0:
      this.headY = 50.0

  fn switchMoving() -> void:
    this.isMoving = not this.isMoving

  fn incrementScore() -> void:
    this.score = this.score + (this.size.toFloat() * (1.0 + this.speedCounter))

  fn incrementSpeed(value:float) -> void:
    this.speed = this.speed - value
    this.speedCounter = this.speedCounter + value

  fn decrementSpeed(value:float) -> void:
    this.speed = this.speed + value
    this.speedCounter = this.speedCounter - value

  fn incrementSize(value:int) -> void:
    if this.size < 475:
      this.size = this.size + value

  fn decrementSize(value:int) -> void:
    if this.size > 3:
      this.size = this.size - value

  fn doubleSize() -> void:
    this.size = this.size * 2
    if this.size > 475:
      this.size = 475

  fn halfSize() -> void:
    this.size = this.size / 2
    if this.size < 3:
      this.size = 3

  fn startSize() -> void:
    this.size = 3

  fn getScore() -> float:
    ret this.score
  fn getSpeed() -> float:
    ret this.speed
  fn getSpeedCounter() -> float:
    ret this.speedCounter
  fn getSize() -> int:
    ret this.size
  fn getIsDead() -> bool:
    ret this.isDead
