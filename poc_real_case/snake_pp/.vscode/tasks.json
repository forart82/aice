{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: g++.exe build project",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${workspaceFolder}\\main.cpp",
        "${workspaceFolder}\\source\\**",
        "-I\"C:/dev/SFML/include\"", // Include SFML headers
        "-o",
        "${workspaceFolder}\\snake.exe", // Output executable in the root folder
        "-L\"C:/dev/SFML/lib\"", // Link SFML libraries
        "-lsfml-graphics",
        "-lsfml-audio",
        "-lsfml-window",
        "-lsfml-system",
        "-mwindows"
      ],
      "options": {
        "cwd": "C:\\msys64\\ucrt64\\bin"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Builds the entire 'Snake' project."
    }
  ],
  "version": "2.0.0"
}