# ------------------------------------------------------------------------------
coverage/
.nyc_output/
reports/
*.telemetry.json
*.lcov
*.log
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

