  fn constructor(fxOrOptions:int | GameEngineOptions | unknown, options:int | GameEngineOptions | unknown):
    if typeof(fxOrOptions) == "number":
      this.ArenaW = fxOrOptions
    if typeof(options) == "number":
      this.ArenaH = options
    let mut opts:Option[GameEngineOptions] = options != nil and typeof(options) == "object" and options or undefined
    let isOptionsObject = fxOrOptions != nil and typeof(fxOrOptions) == "object" and "isolated" == fxOrOptions or "services" == fxOrOptions or "meta" == fxOrOptions or "headless" == fxOrOptions or "fx" == fxOrOptions or "sound" == fxOrOptions or "input" == fxOrOptions or "saveIO" == fxOrOptions or "rng" == fxOrOptions
    if isOptionsObject != nil:
      opts = fxOrOptions
    if opts?.isolated or opts?.services or opts?.meta or opts?.headless:
      this._services = opts?.services ?? Services.createIsolated()
      this._meta = opts?.meta ?? MetaProgression.createIsolated({ engine: this, services: this._services })
      this._services.engine = this
      this._services.meta = this._meta
      this._meta.engine = this
      if opts?.fx != nil:
        this._services.Fx = opts.fx
      if opts?.sound != nil:
        this._services.Sound = opts.sound
      if opts?.input != nil:
        this._services.Input = opts.input
      if opts?.headless != undefined:
        this._services.Headless = opts.headless
    else:
      this._services = nil
      this._meta = nil
      Services.registerEngineProvider(fn() = this)
      let potentialFx = fxOrOptions
      if potentialFx != nil and not (potentialFx == ServiceContainer) and not isOptionsObject and typeof(potentialFx.burst) == "function":
        Services.Fx = potentialFx
    this.Combat.Engine = this
    this.Combat.Meta = this.meta
    this.Combat.Services = this.services
  get Cfg() -> GameModeDef = GameData.Modes.Get(this.GameMode) ?? GameData.Modes.Get("rogue")
  fn SetupCanvas(cssWidth:int, cssHeight:int, dpr:int) -> void:
    let mut w = cssWidth
    let mut h = cssHeight
    if not (w > 0) or not (h > 0):
      w = 960
      h = 640
    w = Math.max(240, w)
    h = Math.max(240, h)
    let aspect = w / h
    let mut arenaH = Math.sqrt(GameEngine.BaseArenaArea / aspect)
    let mut arenaW = arenaH * aspect
    arenaW = MathX.clamp(arenaW, 520, 1600)
    arenaH = MathX.clamp(arenaH, 420, 1400)
    let oldW = this.ArenaW
    let oldH = this.ArenaH
    this.ArenaW = MathX.roundJs(arenaW)
    this.ArenaH = MathX.roundJs(arenaH)
    this.CssWidth = w
    this.CssHeight = h
    this.Dpr = MathX.clamp(dpr > 0 and dpr or 1, 1, 2.5) * Math.min(1, w / arenaW)
    this.BackingWidth = MathX.roundJs(this.ArenaW * this.Dpr)
    this.BackingHeight = MathX.roundJs(this.ArenaH * this.Dpr)
    if this.Player != nil and oldW > 0 and oldH > 0 and oldW != this.ArenaW or oldH != this.ArenaH:
      this.RescaleWorld(this.ArenaW / oldW, this.ArenaH / oldH)
    this.OnCanvasResized()
  fn setupCanvas(cssWidth:int, cssHeight:int, dpr:int) -> void:
    this.SetupCanvas(cssWidth, cssHeight, dpr)
  fn RescaleWorld(sx:int, sy:int) -> void:
    let hiX = this.ArenaW - 4
    let hiY = this.ArenaH - 4
    if this.Player != nil:
      this.Player.X = MathX.clamp(this.Player.X * sx, 4, hiX)
      this.Player.Y = MathX.clamp(this.Player.Y * sy, 4, hiY)
  fn rescaleWorld(sx:int, sy:int) -> void:
    this.RescaleWorld(sx, sy)
  fn ScreenToWorld(normX:int, normY:int) -> Vec2 = Vec2(MathX.clamp(normX, 0, 1) * this.ArenaW, MathX.clamp(normY, 0, 1) * this.ArenaH)
  fn screenToWorld(normX:int, normY:int) -> Vec2 = this.ScreenToWorld(normX, normY)
  fn ShowMenu() -> void:
    this.AbandonRun()
    this.State = GameState.Menu
    this.ClearTransientUi()
    this.SetHudVisible(false)
    this.OnShowScreen("modal-main-menu")
    this.Sound.StopMusic()
    this.Sound.SetBossMode(false)
  fn showMenu() -> void:
    this.ShowMenu()
  fn SetHudVisible(visible:bool) -> void:
