  fn toggleBot() -> bool:
    isBotEnabled = not isBotEnabled
    if isBotEnabled != nil:
      this.Banner("🤖 SPECTATOR BOT: ENGAGED", 1.8)
    else:
      this.Banner("🎮 MANUAL CONTROL: RESTORED", 1.8)
    isBotEnabled
  fn setUiRoot(uiRoot:Option[IUiRoot]) :
    if not uiRoot:
      ret
    OnShowScreen = fn(id:str, payload:unknown) = uiRoot.showScreen(id, payload)
    OnHideModals = fn() = uiRoot.closeAllModals()
    OnHudVisible = fn(visible:bool) = uiRoot.hudView.setVisible(visible)
    OnUpdateHud = fn() = uiRoot.hudView.update()
    OnBanner = fn(text:str, seconds:int) = uiRoot.hudView.showBanner(text, seconds)
    OnBannerHide = fn() = uiRoot.hudView.hideBanner()
    OnToast = fn(message:str, seconds:int) = uiRoot.hudView.showToast(message, seconds)
    OnVignette = fn(opacity:int) = uiRoot.hudView.setVignette(opacity)
    OnBossBox = fn(visible:bool, name:Option[str]) = uiRoot.hudView.setBossBox(visible, name)
    OnPerksChanged = fn() = uiRoot.hudView.updatePerks()
    OnDraftChanged = fn() = nil
  fn draw(_ctx:unknown) :
    OnDraw()
  get services = _services ?? typeof(Services) != "undefined" and Services.defaultContainer ?? Services or nil; set services(v) = _services = v
  get Services = this.services; set Services(v) = this.services = v
  get meta = _meta ?? this.services?.Meta ?? typeof(MetaProgression) != "undefined" and MetaProgression.Instance or nil; set meta(v) = _meta = v
  get Meta = this.meta; set Meta(v) = this.meta = v
  get sound = this.services?.Sound ?? Services.Sound
  get Sound = this.sound
  get fx = this.services?.Fx ?? Services.Fx
  get Fx = this.fx
  get input = this.services?.Input ?? Services.Input
  get Input = this.input
  fn constructor(fxOrOptions:int | GameEngineOptions | unknown, options:int | GameEngineOptions | unknown):
    if typeof(fxOrOptions) == "number":
      ArenaW = fxOrOptions
    if typeof(options) == "number":
      ArenaH = options
    opts:Option[GameEngineOptions] ::= options != nil and typeof(options) == "object" and options or undefined
    isOptionsObject := fxOrOptions != nil and typeof(fxOrOptions) == "object" and "isolated" == fxOrOptions or "services" == fxOrOptions or "meta" == fxOrOptions or "headless" == fxOrOptions or "fx" == fxOrOptions or "sound" == fxOrOptions or "input" == fxOrOptions or "saveIO" == fxOrOptions or "rng" == fxOrOptions
    if isOptionsObject != nil:
      opts = fxOrOptions
    if opts?.isolated or opts?.services or opts?.meta or opts?.headless:
      _services = opts?.services ?? Services.createIsolated()
      _meta = opts?.meta ?? MetaProgression.createIsolated({ engine: this, services: _services })
      _services.engine = this
      _services.meta = _meta
      _meta.engine = this
      if opts?.fx != nil:
        _services.Fx = opts.fx
      if opts?.sound != nil:
        _services.Sound = opts.sound
      if opts?.input != nil:
        _services.Input = opts.input
      if opts?.headless != undefined:
        _services.Headless = opts.headless
    else:
      _services = nil
      _meta = nil
      Services.registerEngineProvider(fn() = this)
      potentialFx := fxOrOptions
      if potentialFx != nil and not (potentialFx == ServiceContainer) and not isOptionsObject and typeof(potentialFx.burst) == "function":
        Services.Fx = potentialFx
    Combat.Engine = this
    Combat.Meta = this.meta
    Combat.Services = this.services
  get Cfg = GameData.Modes.Get(GameMode) ?? GameData.Modes.Get("rogue")
  fn SetupCanvas(cssWidth:int, cssHeight:int, dpr:int) :
    w ::= cssWidth
    h ::= cssHeight
    if not (w > 0) or not (h > 0):
      w = 960
      h = 640
    w = Math.max(240, w)
    h = Math.max(240, h)
    aspect := w / h
    arenaH ::= Math.sqrt(GameEngine.BaseArenaArea / aspect)
    arenaW ::= arenaH * aspect
    arenaW = MathX.clamp(arenaW, 520, 1600)
    arenaH = MathX.clamp(arenaH, 420, 1400)
    oldW := ArenaW
    oldH := ArenaH
    ArenaW = MathX.roundJs(arenaW)
    ArenaH = MathX.roundJs(arenaH)
    CssWidth = w
    CssHeight = h
    Dpr = MathX.clamp(dpr > 0 and dpr or 1, 1, 2.5) * Math.min(1, w / arenaW)
    BackingWidth = MathX.roundJs(ArenaW * Dpr)
    BackingHeight = MathX.roundJs(ArenaH * Dpr)
    if Player != nil and oldW > 0 and oldH > 0 and oldW != ArenaW or oldH != ArenaH:
      this.RescaleWorld(ArenaW / oldW, ArenaH / oldH)
    OnCanvasResized()
  fn setupCanvas(cssWidth:int, cssHeight:int, dpr:int) :
    this.SetupCanvas(cssWidth, cssHeight, dpr)
  fn RescaleWorld(sx:int, sy:int) :
    hiX := ArenaW - 4
    hiY := ArenaH - 4
    if Player != nil:
      Player.X = MathX.clamp(Player.X * sx, 4, hiX)
      Player.Y = MathX.clamp(Player.Y * sy, 4, hiY)
  fn rescaleWorld(sx:int, sy:int) :
    this.RescaleWorld(sx, sy)
  fn ScreenToWorld(normX:int, normY:int) -> Vec2 = Vec2(MathX.clamp(normX, 0, 1) * ArenaW, MathX.clamp(normY, 0, 1) * ArenaH)
  fn screenToWorld(normX:int, normY:int) -> Vec2 = this.ScreenToWorld(normX, normY)
  fn ShowMenu() :
    this.AbandonRun()
    State = GameState.Menu
    this.ClearTransientUi()
    this.SetHudVisible(false)
    OnShowScreen("modal-main-menu")
    this.Sound.StopMusic()
    this.Sound.SetBossMode(false)
  fn showMenu() :
    this.ShowMenu()
  fn SetHudVisible(visible:bool) :
    OnHudVisible(visible)
  fn setHudVisible(visible:bool) :
    this.SetHudVisible(visible)
  fn ChooseMode(mode:str) :
    if GameData.Modes.Has(mode):
      GameMode = mode
    else:
      GameMode = "rogue"
    this.ShowClassSelect()
  fn chooseMode(mode:str) :
    this.ChooseMode(mode)
  fn ShowClassSelect() :
    State = GameState.ClassSelect
    this.SetHudVisible(false)
