  static fn CalculateFoodTarget(floor:int, bossRush:unknown = false) -> int:
    if bossRush != nil:
      ret 0
    Math.min(42, 16 + Math.floor(Math))
  static fn calculateFoodTarget(floor:int, bossRush:unknown = false) -> int = GameEngine.CalculateFoodTarget(floor, bossRush)
