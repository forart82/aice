  fn ShowStats(tab:"run" | "global" = "run") :
    if State == GameState.Playing:
      State = GameState.Paused
      this.Sound.SetPaused(true)
    if tab == "run":
      OnShowScreen("modal-snake-lab", { tab: "telemetry" })
    else:
      OnShowScreen("modal-stats", { mode: tab })
  fn showStats(tab:"run" | "global" = "run") :
    this.ShowStats(tab)
  fn ToggleStats() :
    if State == GameState.Playing:
      this.ShowStats("run")
    elif State == GameState.Paused:
      this.Resume()
  fn toggleStats() :
    this.ToggleStats()
  fn ShowHelp() :
    if State == GameState.Playing:
      State = GameState.Paused
      this.Sound.SetPaused(true)
    elif State != GameState.Paused:
      State = GameState.Help
    OnShowScreen("modal-help")
  fn showHelp() :
    this.ShowHelp()
  fn ToggleHelp() :
    if State == GameState.Playing:
      this.ShowHelp()
    elif State == GameState.Paused or State == GameState.Help:
      this.Resume()
  fn toggleHelp() :
    this.ToggleHelp()
  fn OpenSnakeLab(tab:"lab" | "telemetry" = "lab") :
    if State == GameState.Playing:
      State = GameState.Paused
      this.Sound.SetPaused(true)
    OnShowScreen("modal-snake-lab", { tab })
  fn openSnakeLab(tab:"lab" | "telemetry" = "lab") :
