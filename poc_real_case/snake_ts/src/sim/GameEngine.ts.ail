  fn setUiRoot(uiRoot:Option[IUiRoot]) -> void:
    if not uiRoot:
      ret
    this.OnShowScreen = fn(id:str, payload:unknown) = uiRoot.showScreen(id, payload)
    this.OnHideModals = fn() = uiRoot.closeAllModals()
    this.OnHudVisible = fn(visible:bool) = uiRoot.hudView.setVisible(visible)
    this.OnUpdateHud = fn() = uiRoot.hudView.update()
    this.OnBanner = fn(text:str, seconds:int) = uiRoot.hudView.showBanner(text, seconds)
    this.OnBannerHide = fn() = uiRoot.hudView.hideBanner()
    this.OnToast = fn(message:str, seconds:int) = uiRoot.hudView.showToast(message, seconds)
    this.OnVignette = fn(opacity:int) = uiRoot.hudView.setVignette(opacity)
    this.OnBossBox = fn(visible:bool, name:Option[str]) = uiRoot.hudView.setBossBox(visible, name)
    this.OnPerksChanged = fn() = uiRoot.hudView.updatePerks()
    this.OnDraftChanged = fn() = nil
