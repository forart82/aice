  static fn CalculateFoodTarget(floor:int, bossRush:unknown = false) -> int:
    if bossRush != nil:
      ret 0
    Math.min(42, 16 + Math.floor(Math))
  static fn calculateFoodTarget(floor:int, bossRush:unknown = false) -> int = GameEngine.CalculateFoodTarget(floor, bossRush)
  get Bosses = ActiveBosses; set Bosses(v) = ActiveBosses = v ?? []
  get bosses = ActiveBosses; set bosses(v) = ActiveBosses = v ?? []
  get activeBosses = ActiveBosses; set activeBosses(v) = ActiveBosses = v ?? []
  get Boss = ActiveBosses.length > 0 and ActiveBosses[0] or nil
  set Boss(v:Option[Boss]):
    if not v:
      ActiveBosses.length = 0
    else:
