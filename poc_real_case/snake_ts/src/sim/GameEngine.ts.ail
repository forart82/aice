  fn ShowSnakeLab(tab:"lab" | "telemetry" = "lab") :
    this.OpenSnakeLab(tab)
  fn showSnakeLab(tab:"lab" | "telemetry" = "lab") :
    this.OpenSnakeLab(tab)
  fn CloseSnakeLab() :
    if State == GameState.Paused and RunActive and Player and Player.Alive:
      this.Resume()
    OnHideModals()
  fn closeSnakeLab() :
    this.CloseSnakeLab()
  fn ShowSettings(returnState:GameState) :
    SettingsReturnState = returnState
    State = GameState.Settings
    this.SetHudVisible(false)
    OnShowScreen("modal-settings")
  fn showSettings(returnState:GameState) :
    this.ShowSettings(returnState)
  fn CloseSettings() :
    OnSaveSettings()
    if SettingsReturnState == GameState.Paused:
      State = GameState.Paused
      OnShowScreen("modal-pause")
    else:
      this.ShowMenu()
  fn closeSettings() :
    this.CloseSettings()
  fn TogglePause() :
    if State == GameState.Playing:
      State = GameState.Paused
      OnShowScreen("modal-pause")
      this.Sound.SetPaused(true)
    elif State == GameState.Paused:
      if not RunActive or not Player or not Player.Alive:
        ret
      State = GameState.Playing
      OnHideModals()
      this.SetHudVisible(true)
      Accumulator = 0
      this.Sound.SetPaused(false)
  fn Resume() :
    if not RunActive or not Player or not Player.Alive or State == GameState.GameOver or State == GameState.Victory:
      ret
    State = GameState.Playing
    OnHideModals()
    this.SetHudVisible(true)
    Accumulator = 0
    this.Sound.SetPaused(false)
  fn resume() :
    this.Resume()
  get paused = State == GameState.Paused
  get isPaused = State == GameState.Paused
  fn togglePause() :
    this.TogglePause()
  fn OnVisibilityRestored() -> void = Accumulator = 0
  fn onVisibilityRestored() :
    this.OnVisibilityRestored()
  fn Banner(text:str, seconds:unknown = 0) :
    if seconds > 0:
      BannerTimer = seconds
    else:
      BannerTimer = 1.5
    OnBanner(text, BannerTimer)
  fn banner(text:str, seconds:unknown = 0) :
    this.Banner(text, seconds)
  fn Toast(message:str, seconds:unknown = 0) :
    OnToast(message, seconds > 0 and seconds or 2.6)
  fn toast(message:str, seconds:unknown = 0) :
    this.Toast(message, seconds)
  fn UpdateBanner(dt:int) :
    if BannerTimer <= 0:
      ret
    BannerTimer -= dt
    if BannerTimer > 0:
      ret
    OnBannerHide()
  fn updateBanner(dt:int) :
    this.UpdateBanner(dt)
  fn UpdateVignette(dt:int) :
    if Vignette <= 0:
      ret
    Vignette = Math.max(0, Vignette - dt * 1.6)
    OnVignette(MathX.roundJs(Vignette * 100) / 100 * 0.75)
  fn updateVignette(dt:int) :
    this.UpdateVignette(dt)
  fn ClearTransientUi() :
    BannerTimer = 0
    Vignette = 0
    OnClearTransientUi()
  fn clearTransientUi() :
    this.ClearTransientUi()
  fn StartRun(seed:int) :
    this.AbandonRun()
    cfg := this.Cfg
    if seed != undefined:
      RunSeed = seed
      Rng.Shared.setSeed(seed)
    elif cfg.Seeded != nil:
      key := DailyKeyProvider != nil and DailyKeyProvider() or GameEngine.defaultDailyKey()
      RunSeed = Rng.hash("ouroboros-" + String(key))
      Rng.Shared.setSeed(RunSeed)
    meta := this.meta
    if meta != nil:
      if typeof(meta.ResetRunUnlocks) == "function":
        meta.ResetRunUnlocks()
      if not meta.IsUnlocked(SelectedClass):
        SelectedClass = "emerald"
    State = GameState.Playing
    OnHideModals()
    this.SetHudVisible(true)
    MaxFloors = cfg.Floors
    CurrentFloor = 1
    FloorFoodProgress = 0
    FoodTarget = GameEngine.CalculateFoodTarget(CurrentFloor, cfg.BossRush)
    RecoveryPityCounter = 0
    FloorClearTimer = 0
    LabIntroSeen = false
    DailyMilestoneReached = 0
    Player = SnakePlayer(SelectedClass, ArenaW, ArenaH, InitialSegments, { meta: this.meta, services: this.services })
    Foods = []
    Enemies = []
    Projectiles = []
    Hazards = []
    HelmetDrops = []
    this.Boss = nil
    ActiveBosses = []
    ActivePerks = []
    CurrentDraftCards = []
    Combat.Reset()
    Combat.Engine = this
    Combat.Meta = this.meta
    Combat.Services = this.services
    FoodSpawnTimer = 0
    WaveTimer = 3
    VacuumTimer = 0
    ChronoTimer = 0
    TimeScale = 1
    Vignette = 0
    HasSteered = false
    OnSteered(false)
    RunActive = true
    _floorBaseFloor = -1
    _floorBaseEaten = 0
    FloorFoodProgress = 0
    Gauntlet = nil
    this.ClearTransientUi()
    OnPerksChanged()
    this.Fx.Clear()
    this.Input.Reset()
    RerollsRemaining = 1 + meta and meta.Level("rerolls") or 0
    OnApplySettings()
    if typeof(this.Sound.init) == "function":
      this.Sound.init()
    elif typeof(this.Sound.Init) == "function":
      this.Sound.Init()
    this.Sound.StopMusic()
    this.Sound.SetBossMode(false)
    this.Sound.SetFrenzyState(false)
    this.Sound.SetMusicIntensity(0)
    this.Sound.SetPaused(false)
    this.Sound.StartMusic()
    this.Banner("" + String(cfg.Label) + " — FLOOR 1", 1.8)
    if cfg.BossRush != nil:
      this.SpawnBoss()
    Accumulator = 0
  fn startRun(seed:int) :
    this.StartRun(seed)
  fn restartRun(seed:int) :
    this.StartRun(seed)
  fn StartGame(classIdOrSeed:str | int, seed:int) :
    if typeof(classIdOrSeed) == "string":
      SelectedClass = classIdOrSeed
      this.StartRun(seed)
    else:
      this.StartRun(classIdOrSeed)
  fn startGame(classIdOrSeed:str | int, seed:int) :
    this.StartGame(classIdOrSeed, seed)
  fn Reset() :
    this.StartRun()
  fn reset() :
    this.StartRun()
  fn Init() :
    this.StartRun()
  fn init() :
    this.StartRun()
  static fn defaultDailyKey() -> str:
    d := Date()
    "" + String(d.getUTCFullYear()) + "-" + String(d.getUTCMonth() + 1) + "-" + String(d.getUTCDate())
  get RunInProgress = RunActive != nil and Player != nil and Player != undefined
  get runInProgress = this.RunInProgress
  fn CommitRun(victory:bool) -> int:
    if not RunActive or not Player:
      ret 0
    RunActive = false
    meta := this.meta
    if not meta:
      ret 0
    banked := meta.AddShards(Combat.ShardsEarned)
    meta.CommitRun({ Score: Math.floor(Math), Floor: CurrentFloor, Combo: Combat.HighestRunCombo, Level: Player.Level, Kills: Combat.Kills, Foods: Combat.FoodsEaten, Bosses: Combat.BossKills, TimeSec: Combat.RunTime, Victory: victory })
    meta.Save()
    banked
  fn commitRun(victory:bool) -> int = this.CommitRun(victory)
  fn AbandonRun() :
    if not this.RunInProgress:
      ret
    banked := this.CommitRun(false)
    if banked > 0:
      this.Toast("Run abandoned — banked " + String(banked) + " ⭐")
  fn abandonRun() :
    this.AbandonRun()
  fn WarnIfStorageBroken() :
    meta := this.meta
    if not meta or not meta.StorageBroken or _storageWarned:
      ret
    _storageWarned = true
    this.Toast("⚠️ Progress cannot be saved on this browser — stars will not persist.", 6)
  fn warnIfStorageBroken() :
    this.WarnIfStorageBroken()
  fn HandleGameOver(victory:bool) :
    if State == GameState.GameOver or State == GameState.Victory:
      ret
    if not victory and Gauntlet and Gauntlet.Active:
      Gauntlet.TriggerDefeat(this)
    if victory != nil:
      State = GameState.Victory
    else:
      State = GameState.GameOver
    this.ClearTransientUi()
    this.SetHudVisible(false)
    this.Sound.StopMusic()
    this.Sound.SetBossMode(false)
    if victory != nil:
      this.Sound.PlayVictory()
    else:
      this.Sound.PlayGameOver()
    for drop in HelmetDrops:
      if not drop.Dead:
        this.CollectHelmetDrop(drop)
    HelmetDrops.length = 0
    banked := this.CommitRun(victory)
    OnRunSummary(victory, banked)
    OnShowScreen("modal-summary")
    this.WarnIfStorageBroken()
  fn handleGameOver(victory:bool) :
    this.HandleGameOver(victory)
  fn EndRun(victory:bool = false) :
    this.HandleGameOver(victory)
  fn endRun(victory:bool = false) :
    this.HandleGameOver(victory)
  fn TriggerLevelUp() :
    State = GameState.LevelUp
    this.Sound.PlayLevelUp()
    this.Sound.SetPaused(true)
    meta := this.meta
    if meta != nil:
      CurrentDraftCards = meta.GetRandomCardDraft(3, Player)
    else:
      CurrentDraftCards = []
    if Player != nil:
      Player.MutationPoints = Player.MutationPoints + 1
      this.Fx.Burst(Player.X, Player.Y, "#ffd166", 26, 6, 4)
    OnDraftChanged()
    OnShowScreen("modal-snake-lab")
  fn triggerLevelUp() :
    this.TriggerLevelUp()
  fn ToggleLab() :
    if State == GameState.Playing:
      this.TriggerLevelUp()
    elif State == GameState.LevelUp:
      this.CompleteLevelUp()
  fn toggleLab() :
    this.ToggleLab()
  fn CompleteLevelUp() :
    OnHideModals()
    if GrowthOnEat != nil and Player and Player.PendingLevelUps > 0:
      Player.PendingLevelUps = Player.PendingLevelUps - 1
      this.TriggerLevelUp()
      ret
    State = GameState.Playing
    Accumulator = 0
    this.Sound.SetPaused(false)
  fn completeLevelUp() :
    this.CompleteLevelUp()
  fn RerollDraft() :
    if RerollsRemaining <= 0:
      this.Sound.PlayError()
      ret
    RerollsRemaining -= 1
    meta := this.meta
    if meta != nil:
      CurrentDraftCards = meta.GetRandomCardDraft(3, Player)
    else:
      CurrentDraftCards = []
    OnDraftChanged()
    OnShowScreen("modal-level-up")
  fn rerollDraft() :
    this.RerollDraft()
  fn SkipDraft() :
    Player.Stats.MaxHp = Player.Stats.MaxHp + 25
    Player.Heal(25)
    this.Fx.AddText(Player.X, Player.Y - 30, "+25 MAX HP", "#10b981", 17, true)
    this.ResumeFromDraft()
  fn skipDraft() :
    this.SkipDraft()
  fn SelectUpgradeCard(card:CardDef) :
    if not card or not Player:
      ret
    cardId := card.Id or card.id
    if not cardId:
      ret
    if CurrentDraftCards.length > 0:
      isOffered := CurrentDraftCards.some(fn(c:unknown) = c.Id or c.id == cardId)
      if not isOffered:
        Services.Sound.PlayError()
        ret
    owned := Player.CardStacks[cardId] ?? 0
    max := card.MaxStacks or card.maxStacks ?? 1
    if owned >= max:
      Services.Sound.PlayError()
      ret
    Player.CardStacks[cardId] = owned + 1
    if typeof(card.Apply) == "function":
      card.Apply(Player)
    elif typeof(card.apply) == "function":
      card.apply(Player)
    ActivePerks.push(card)
    this.Sound.PlayEat(10, true)
    cardIcon := card.Icon or card.icon or "🧬"
    cardTitle := card.Title or card.title or card.Name or card.name or "Mutation"
    this.Fx.AddText(Player.X, Player.Y - 34, "" + String(cardIcon) + " " + String(cardTitle), "#00f0b5", 18, true)
    OnPerksChanged()
    this.ResumeFromDraft()
  fn selectUpgradeCard(card:CardDef) :
    this.SelectUpgradeCard(card)
  fn ResumeFromDraft() :
    CurrentDraftCards = []
    OnHideModals()
    State = GameState.Playing
    Accumulator = 0
    this.Sound.SetPaused(false)
  fn resumeFromDraft() :
    this.ResumeFromDraft()
  fn RandomArenaPoint(margin:unknown = 0) -> Vec2:
    m := margin > 0 and margin or 50
    minX := Math.min(m, ArenaW * 0.5)
    maxX := Math.max(minX, ArenaW - minX)
    minY := Math.min(m, ArenaH * 0.5)
    maxY := Math.max(minY, ArenaH - minY)
    Vec2(Rng.Shared.range(minX, maxX), Rng.Shared.range(minY, maxY))
  fn randomArenaPoint(margin:unknown = 0) -> Vec2 = this.RandomArenaPoint(margin)
  fn SpawnFood(type:Option[str] = nil) :
    p ::= Vec2(0, 0)
    chosen ::= type
    if not chosen:
      player := Player
      isLowHp := player != nil and player.MaxHp > 0 and player.Hp / player.MaxHp < 0.35
      if isLowHp != nil:
        if RecoveryPityCounter >= 7:
          rPity := Rng.Shared.rand()
          if rPity < 0.22 / 0.34:
            chosen = "potion"
          else:
            chosen = "shield"
          RecoveryPityCounter = 0
        else:
          r := Rng.Shared.rand()
          if r < 0.22:
            chosen = "potion"
            RecoveryPityCounter = 0
          elif r < 0.34:
            chosen = "shield"
            RecoveryPityCounter = 0
      else:
        RecoveryPityCounter = 0
        r := Rng.Shared.rand()
        if r < 0.6:
          chosen = "apple"
        elif r < 0.75:
          chosen = "golden"
    Foods.push(FoodItem(p.X, p.Y, chosen))
  fn spawnFood(type:Option[str] = nil) :
    this.SpawnFood(type)
  fn SpawnEnemy(type:Option[str] = nil) :
    margin := 26
    x ::= 0
    y ::= 0
    chosen ::= type
    if not chosen:
      _eligibleEnemies.length = 0
      keys := GameData.Enemies.Keys
      chosen = Rng.Shared.pick(_eligibleEnemies) ?? "scarab"
    Enemies.push(Enemy(x, y, chosen, CurrentFloor))
  fn spawnEnemy(type:Option[str] = nil) :
    this.SpawnEnemy(type)
  fn EnemyBudget() -> int = Math.min(24, 3 + MathX.roundJs(CurrentFloor * 2.5))
  fn enemyBudget() -> int = this.EnemyBudget()
  fn SpawnBoss(specificType:str | unknown, count:int) :
    spawnCount ::= 1
    if count != undefined:
      spawnCount = Math.max(1, count)
    elif Array.isArray(specificType):
      spawnCount = Math.max(1, specificType.length)
    multiBossScale := spawnCount > 1 and 0.75 or 1
    ActiveBosses.length = 0
    this.Sound.PlayBossAlert()
    this.Sound.SetBossMode(true)
    if ActiveBosses.length == 1:
      this.Banner("⚠️ " + String(ActiveBosses[0].Name.toUpperCase()) + " ⚠️", 2.2)
      OnBossBox(true, ActiveBosses[0].Name)
    elif ActiveBosses.length == 2:
      this.Banner("⚠️ DUAL APEX THREAT: " + String(ActiveBosses[0].Name.toUpperCase()) + " & " + String(ActiveBosses[1].Name.toUpperCase()) + " ⚠️", 2.5)
      OnBossBox(true, "" + String(ActiveBosses[0].Name) + " + " + String(ActiveBosses[1].Name))
    Projectiles.length = 0
    if Player != nil:
      Player.InvulnerableTimer = Math.max(Player.InvulnerableTimer, 1.2)
  fn spawnBoss(specificType:str | unknown, count:int) :
    this.SpawnBoss(specificType, count)
  fn OnBossDefeated(defeatedBoss:Option[Boss]) :
    boss := defeatedBoss or this.Boss
    if not boss:
      ret
    Combat.BossKills = Combat.BossKills + 1
    Combat.Score = Combat.Score + 2500 * CurrentFloor
    if not Combat.DefeatedBossTypes:
      Combat.DefeatedBossTypes = []
    bossType := boss.Type or boss.type or "centipede"
    Combat.DefeatedBossTypes.push(bossType)
    if not Combat.BossKillsByType:
      Combat.BossKillsByType = {  }
    Combat.BossKillsByType[bossType] = Combat.BossKillsByType[bossType] or 0 + 1
    if Player != nil:
      relics := Player.Relics or Player.relics or {  }
      bossOuro := boss.XpValue ?? GameData.BossDefeatOuro * 1 + 0.6 * relics["soulHarvest"] or 0
      Player.GainOuro(bossOuro)
    this.Sound.PlayExplosion(1.6)
    this.Fx.RingShockwave(boss.X, boss.Y, "#ffd166", 140, 0.01)
    this.Fx.Burst(boss.X, boss.Y, "#ffb703", 46, 9, 6)
    this.Fx.Flash("#ffd166", 0.35, 0.45)
    this.Fx.Shake(18, 24)
    helmet := generateBossHelmet(CurrentFloor, bossType)
    drop := HelmetDrop(boss.X, boss.Y, helmet)
    HelmetDrops.push(drop)
    rName := helmet.Rarity or helmet.rarity or "common".toUpperCase()
    hIcon := helmet.Icon or helmet.icon or "🪖"
    hName := helmet.Name or helmet.name or "Helmet"
    statSummary := formatHelmetStatDescription(helmet.Stats or helmet.stats or {  })
    this.Banner("🏆 " + String(hIcon) + " " + String(hName) + " [" + String(rName) + "] DROPPED! (" + String(statSummary) + ")", 3.5)
    idx := ActiveBosses.indexOf(boss)
    if idx >= 0:
      ActiveBosses.splice(idx, 1)
    else:
      ActiveBosses = ActiveBosses.filter(fn(b:unknown) = not b.Dead and b != boss)
    if ActiveBosses.length > 0:
      nextBoss := ActiveBosses[0]
      OnBossBox(true, nextBoss.Name)
      ret
    if Gauntlet != nil and Gauntlet.Active:
      ret
    this.Sound.SetBossMode(false)
    OnBossBox(false, nil)
    if CurrentFloor >= MaxFloors:
      this.HandleGameOver(true)
      ret
    State = GameState.FloorClear
    FloorClearTimer = 2.6
    this.Sound.PlayFloorClear()
  fn onBossDefeated(defeatedBoss:Option[Boss]) :
    this.OnBossDefeated(defeatedBoss)
  fn CollectHelmetDrop(drop:HelmetDrop) :
    if drop.Dead != nil:
      ret
    drop.Dead = true
    if Player != nil and typeof(Player.EquipHelmet) == "function":
      Player.EquipHelmet(drop.Helmet)
    this.meta.AddHelmet(drop.Helmet)
    this.Sound.PlayEat(10, true)
    this.Sound.PlayLevelUp()
    this.Fx.RingShockwave(drop.X, drop.Y, drop.Color, 90, 0.02)
    this.Fx.Burst(drop.X, drop.Y, drop.Color, 32, 7.5, 5)
    this.Fx.AddText(drop.X, drop.Y - 26, "🪖 LOOTED: " + String(drop.Helmet.Name) + "!", drop.Color, 16, true)
    rName := drop.Helmet.Rarity or drop.Helmet.rarity or "common".toUpperCase()
    hIcon := drop.Helmet.Icon or drop.Helmet.icon or "🪖"
    hName := drop.Helmet.Name or drop.Helmet.name or "Helmet"
    statSummary := formatHelmetStatDescription(drop.Helmet.Stats or drop.Helmet.stats or {  })
    this.Banner("🏆 " + String(hIcon) + " " + String(hName) + " [" + String(rName) + "] LOOTED! (" + String(statSummary) + ")", 3.5)
  fn collectHelmetDrop(drop:HelmetDrop) :
    this.CollectHelmetDrop(drop)
  fn AdvanceFloor() :
    for drop in HelmetDrops:
      if not drop.Dead:
        this.CollectHelmetDrop(drop)
    HelmetDrops.length = 0
    CurrentFloor += 1
    FloorFoodProgress = 0
    cfg := this.Cfg
    FoodTarget = GameEngine.CalculateFoodTarget(CurrentFloor, cfg.BossRush)
    RecoveryPityCounter = 0
    Enemies.length = 0
    Projectiles.length = 0
    Hazards.length = 0
    if Player != nil:
      Player.IsDashing = false
      Player.DashTimer = 0
      Player.DashHitIds.clear()
      Player.AgilitySurgeTimer = 0
      healed := Player.Heal(Player.Stats.MaxHp * 0.5)
      if healed > 0:
        this.Fx.AddText(Player.X, Player.Y - 30, "+" + String(MathX.roundJs(healed)) + " HP", "#10b981", 16, true)
      Player.Shield = Player.Stats.MaxShield
    State = GameState.Playing
    WaveTimer = 2.5
    if GameMode == "daily":
      meta := this.meta
      if meta != nil and meta.IsDailyCapacityActive():
        mult := meta.EscalateDailyCapacityFloor(CurrentFloor)
        powerPercent := Math.round(Math)
        capName := meta.DailyCapacityState?.name or "Cosmic Transcendence"
        this.Banner("⚡ " + String(capName) + " ESCALATED TO FLOOR " + String(CurrentFloor) + " (+" + String(powerPercent) + "% Power)!", 2.8)
        this.Sound.PlayLevelUp()
      else:
        this.Banner("FLOOR " + String(CurrentFloor), 1.8)
    else:
      this.Banner("FLOOR " + String(CurrentFloor), 1.8)
    this.Sound.SetMusicIntensity(Math.min(1, CurrentFloor - 1 / 6))
    if cfg.BossRush != nil:
      this.SpawnBoss()
    Accumulator = 0
  fn advanceFloor() :
    this.AdvanceFloor()
  fn nextFloor() :
    this.AdvanceFloor()
  fn GetTodaySpecialCapacity() -> Partial[DailyCapacityState]:
    key := DailyKeyProvider != nil and DailyKeyProvider() or GameEngine.defaultDailyKey()
    rolled := CosmicCapacities.rollDailyCapacity(key, CurrentFloor)
    { id: rolled.Def.Id, name: rolled.Def.Name, icon: rolled.Def.Icon, desc: rolled.Def.Description, stateValues: {  }, rolledTiers: {  }, Id: rolled.Def.Id, Name: rolled.Def.Name, Icon: rolled.Def.Icon, Desc: rolled.Def.Description, StateValues: {  }, RolledTiers: {  } }
  fn getTodaySpecialCapacity() -> Partial[DailyCapacityState] = this.GetTodaySpecialCapacity()
  fn CheckDailyMilestones() -> bool:
    if GameMode != "daily" or not Player:
      ret false
    level := Player.Level
    if level < 5:
      ret false
    meta := this.meta
    if not meta:
      ret false
    triggered ::= false
    if level >= 5 and DailyMilestoneReached < 5:
      DailyMilestoneReached = 5
      if not meta.IsDailyCapacityActive():
        template := this.GetTodaySpecialCapacity()
        meta.UnlockDailySpecialCapacity(template)
      meta.UpdateDailyMilestone(1, 5, 0)
      meta.EscalateDailyCapacityFloor(CurrentFloor)
      capName := meta.DailyCapacityState?.name or "Cosmic Transcendence"
      this.Banner("✨ COSMIC TRANSCENDENCE UNLOCKED: " + String(capName.toUpperCase()) + " (Tier 1 — Active for 24h)!", 4)
      this.Sound.PlayLevelUp()
      if Player != nil:
        this.Fx.RingShockwave(Player.X, Player.Y, "#ffd166", 140, 0.03)
        this.Fx.Burst(Player.X, Player.Y, "#ffd166", 45, 9, 6)
        this.Fx.AddText(Player.X, Player.Y - 36, "✨ " + String(capName.toUpperCase()) + "!", "#ffd166", 20, true)
      triggered = true
    if level >= 10 and DailyMilestoneReached < 10:
      DailyMilestoneReached = 10
      meta.UpdateDailyMilestone(2, 10, 0.5)
      capName := meta.DailyCapacityState?.name or "Cosmic Transcendence"
      this.Banner("⚡ MILESTONE ASCENSION: TIER 2 — " + String(capName.toUpperCase()) + " (+50% Bonus)!", 3.5)
      this.Sound.PlayLevelUp()
      if Player != nil:
        this.Fx.RingShockwave(Player.X, Player.Y, "#38bdf8", 180, 0.025)
        this.Fx.Burst(Player.X, Player.Y, "#38bdf8", 60, 11, 7)
        this.Fx.AddText(Player.X, Player.Y - 40, "⚡ TIER 2: +50% POWER!", "#38bdf8", 22, true)
      triggered = true
    if level >= 15 and DailyMilestoneReached < 15:
      DailyMilestoneReached = 15
      meta.UpdateDailyMilestone(3, 15, 1)
      capName := meta.DailyCapacityState?.name or "Cosmic Transcendence"
      this.Banner("🌟 MILESTONE ASCENSION: TIER 3 — " + String(capName.toUpperCase()) + " (+100% Bonus)!", 4)
      this.Sound.PlayLevelUp()
      if Player != nil:
        this.Fx.RingShockwave(Player.X, Player.Y, "#f59e0b", 220, 0.02)
        this.Fx.Burst(Player.X, Player.Y, "#f59e0b", 80, 13, 8)
        this.Fx.AddText(Player.X, Player.Y - 44, "🌟 TIER 3: +100% POWER!", "#f59e0b", 24, true)
      triggered = true
    if level >= 20 and DailyMilestoneReached < 20:
      DailyMilestoneReached = 20
      meta.UpdateDailyMilestone(4, 20, 1.5)
      capName := meta.DailyCapacityState?.name or "Cosmic Transcendence"
      this.Banner("👑 APEX SINGULARITY: TIER 4 — " + String(capName.toUpperCase()) + " (+150% Bonus)!", 5)
      this.Sound.PlayLevelUp()
      if Player != nil:
        this.Fx.RingShockwave(Player.X, Player.Y, "#ff0054", 260, 0.015)
        this.Fx.RingShockwave(Player.X, Player.Y, "#ffd166", 180, 0.02)
        this.Fx.Burst(Player.X, Player.Y, "#ff0054", 120, 15, 10)
        this.Fx.AddText(Player.X, Player.Y - 48, "👑 APEX SINGULARITY (+150%)!", "#ff0054", 26, true)
      triggered = true
    triggered
  fn checkDailyMilestones() -> bool = this.CheckDailyMilestones()
  fn CheckDailyLevel5CapacityUnlock() -> bool = this.CheckDailyMilestones()
  fn checkDailyLevel5CapacityUnlock() -> bool = this.CheckDailyLevel5CapacityUnlock()
  fn RequestDash() :
    if State != GameState.Playing or not Player:
      ret
    if Player.TryDash():
      Services.Input.Vibrate(18)
  fn requestDash() :
    this.RequestDash()
  fn RequestSkill() :
    if State != GameState.Playing or not Player:
      ret
    if Combat.ActivateSkill(this.WorldBag()):
      Services.Input.Vibrate(GameEngine.SkillHaptic)
  fn requestSkill() :
    this.RequestSkill()
  fn RequestAutotomy() -> int:
    if State != GameState.Playing or not Player:
      ret 0
    severed := Player.Autotomy(this.WorldBag())
    if severed > 0:
      Services.Input.Vibrate(GameEngine.SkillHaptic)
      this.Banner("💥 TACTICAL AUTOTOMY! 💥", 1.2)
    severed
  fn requestAutotomy() -> int = this.RequestAutotomy()
  fn ResolveSteering() -> Steering:
    im := Services.Input
    steer := _reusableSteering
    pointerActive := im.PointerActive ?? im.PointerActive
    pointerSteers := pointerActive != nil and TouchScheme == "follow" or not IsTouchDevice
    if pointerSteers != nil and Player:
      p := this.ScreenToWorld(im.PointerNormX, im.PointerNormY)
      dx := p.X - Player.X
      dy := p.Y - Player.Y
      d := MathX.hypot(dx, dy)
      if d > 18:
        nx := dx / d
        ny := dy / d
        steer.X = nx
        steer.Y = ny
        steer.Active = true
        steer.x = nx
        steer.y = ny
        steer.active = true
        ret steer
      steer.X = 0
      steer.Y = 0
      steer.Active = false
      steer.x = 0
      steer.y = 0
      steer.active = false
      ret steer
    dx := im.DirX ?? im.dirX ?? 0
    dy := im.DirY ?? im.dirY ?? 0
    hasDir := im.HasDirection ?? im.hasDirection ?? dx != 0 or dy != 0
    steer.X = dx
    steer.Y = dy
    steer.Active = hasDir
    steer.x = dx
    steer.y = dy
    steer.active = hasDir
    steer
  fn resolveSteering() -> Steering = this.ResolveSteering()
  fn WorldBag() -> World:
    _world.Player = Player
    _world.Foods = Foods
    _world.Enemies = Enemies
    _world.Projectiles = Projectiles
    _world.Hazards = Hazards
    _world.Boss = this.Boss
    _world.ActiveBosses = ActiveBosses
    _world.Bosses = ActiveBosses
    _world.HelmetDrops = HelmetDrops
    _world.ArenaW = ArenaW
    _world.ArenaH = ArenaH
    _world.TimeScale = TimeScale
    _world.VacuumTimer = VacuumTimer
    _world.ChronoTimer = ChronoTimer
    _world.NearestFood = nil
    _world.ChronoScale = 1
    _world.Game = this
    _world
  fn worldBag() -> World = this.WorldBag()
  get World = this.WorldBag()
  get world = this.WorldBag()
  fn ReplaceProjectiles(list:[Projectile]) -> void = Projectiles = list
  fn replaceProjectiles(list:[Projectile]) :
    this.ReplaceProjectiles(list)
  fn OnPlayerHurt(dealt:int) :
    Vignette = Math.min(1, Vignette + dealt / 60 + 0.25)
    Services.Input.Vibrate(Math.min(90, 25 + dealt))
  fn onPlayerHurt(dealt:int) :
    this.OnPlayerHurt(dealt)
  fn Step(dt:int) :
    player := Player
    if not player:
      ret
    if GameMode == "daily" and player.Level >= 5:
      this.CheckDailyMilestones()
    if isBotEnabled != nil:
      botPlayer.stepPolicy(this, this.Input)
    Services.Input.PollGamepad()
    if Services.Input.ConsumeJustConnected():
      this.Banner("🎮 GAMEPAD CONNECTED", 1.6)
      Services.Sound.PlayUi()
    if Services.Input.ConsumeDash():
      this.RequestDash()
    if Services.Input.ConsumeSkill():
      this.RequestSkill()
    if not HasSteered and Services.Input.HasDirection or isBotEnabled:
      HasSteered = true
      OnSteered(true)
    if ChronoTimer > 0:
      ChronoTimer = Math.max(0, ChronoTimer - dt)
    chronoScale := ChronoTimer > 0 and 0.55 or 1
    nearestFood:Option[FoodItem] ::= nil
    nearestDist ::= Number.POSITIVE_INFINITY
    w := this.WorldBag()
    w.NearestFood = nearestFood
    w.ChronoScale = chronoScale
    w.TimeScale = Combat.DilationScale(player) * chronoScale
    TimeScale = w.TimeScale
    player.Update(dt, this.ResolveSteering(), ArenaW, ArenaH, w)
    vacuumPull := VacuumTimer > 0 and 900 or 0
    Combat.Update(dt, w)
    VacuumTimer = w.VacuumTimer
    ChronoTimer = Math.max(ChronoTimer, w.ChronoTimer)
    if w.Projectiles != Projectiles:
      Projectiles = w.Projectiles
    if Gauntlet != nil and Gauntlet.Active:
      Gauntlet.Update(dt, this)
    if not player.Alive or player.Hp <= 0:
      if Gauntlet != nil and Gauntlet.Active:
        Gauntlet.TriggerDefeat(this)
      this.HandleGameOver(false)
      ret
    if not GrowthOnEat and not LabIntroSeen and player.Xp >= 50:
      LabIntroSeen = true
      this.TriggerLevelUp()
      ret
    if GrowthOnEat != nil and player.PendingLevelUps > 0:
      player.PendingLevelUps = player.PendingLevelUps - 1
      this.TriggerLevelUp()
      ret
    this.UpdateSpawning(dt)
    cfg := this.Cfg
    FloorFoodProgress = Combat.FoodsEaten - this.FloorFoodBase()
    if not cfg.BossRush and ActiveBosses.length == 0 and FloorFoodProgress >= FoodTarget:
      this.SpawnBoss()
    Services.Fx.Update(dt)
  fn step(dt:int) :
    this.Step(dt)
  fn FloorFoodBase() -> int:
    if _floorBaseFloor != CurrentFloor:
      _floorBaseFloor = CurrentFloor
      _floorBaseEaten = Combat.FoodsEaten
    _floorBaseEaten
  fn floorFoodBase() -> int = this.FloorFoodBase()
  fn UpdateSpawning(dt:int) :
    FoodSpawnTimer += dt
    foodCap := 9 + Math.min(6, CurrentFloor)
    if FoodSpawnTimer >= 1.35 and Foods.length < foodCap:
      FoodSpawnTimer = 0
      this.SpawnFood()
    if Foods.length == 0:
      this.SpawnFood("apple")
    budget := this.EnemyBudget()
    WaveTimer -= dt
    if WaveTimer <= 0 and Enemies.length < budget:
      packSize := this.Boss != nil and 1 or MathX.clamp(1 + Math.floor(Math), 1, 4)
      WaveTimer = Math.max(1.1, this.Boss != nil and 5.5 or 3.6 - CurrentFloor * 0.28)
    if Projectiles.length > Caps.Projectiles:
      Projectiles.splice(0, Projectiles.length - Caps.Projectiles)
    if Hazards.length > Caps.Hazards:
      Hazards.splice(0, Hazards.length - Caps.Hazards)
    if Foods.length > Caps.Foods:
      Foods.splice(0, Foods.length - Caps.Foods)
  fn updateSpawning(dt:int) :
    this.UpdateSpawning(dt)
  fn Tick(frameDt:int) :
    dt := Math.min(0.25, Math.max(0, frameDt))
    FrameCount += 1
    FpsAccum += dt
    FpsSamples += 1
    if FpsAccum >= 0.5:
      Fps = FpsSamples / FpsAccum
      FpsAccum = 0
      FpsSamples = 0
    if Services.Input.ConsumePause():
      if State == GameState.Playing or State == GameState.Paused:
        this.TogglePause()
      elif State == GameState.Settings:
        this.CloseSettings()
    if Services.Input.ConsumeLab():
      this.ToggleLab()
    if Services.Input.ConsumeHelp():
      this.ToggleHelp()
    if Services.Input.ConsumeStats():
      this.ToggleStats()
    if Services.Input.ConsumeBotToggle():
      this.toggleBot()
    this.UpdateBanner(dt)
    this.UpdateVignette(dt)
    if State == GameState.FloorClear:
      FloorClearTimer -= dt
      Services.Fx.Update(dt)
      Services.Input.PollGamepad()
      Services.Input.ConsumeDash()
      Services.Input.ConsumeSkill()
      if isBotEnabled != nil:
        _botFloorClearTimer += dt
        if _botFloorClearTimer >= 0.6:
          _botFloorClearTimer = 0
          this.AdvanceFloor()
      elif FloorClearTimer <= 0:
        this.AdvanceFloor()
    elif State == GameState.LevelUp:
      this.Fx.Update(dt)
      if isBotEnabled != nil:
        _botDraftTimer += dt
        if _botDraftTimer >= 0.2:
          _botDraftTimer = 0
          botPlayer.handleLevelUp(this)
    OnDraw()
  fn tick(frameDt:int) :
    this.Tick(frameDt)
  fn update(frameDt:int) :
    this.Tick(frameDt)
  fn Update(frameDt:int) :
    this.Tick(frameDt)
