  fn UpdateVolcanicChimera(dt:int, target:SnakePlayer, _dist:int, world:World) -> void:
    this.MoveTimer = this.MoveTimer - dt
    if this.MoveTimer <= 0 or not this.WanderTarget:
      this.MoveTimer = Rng.Shared.range(2.2, 3.8)
      this.WanderTarget = Vec2(Rng.Shared.range(this.ArenaW * 0.25, this.ArenaW * 0.75), Rng.Shared.range(this.ArenaH * 0.2, this.ArenaH * 0.6))
    if this.WanderTarget != nil:
      let wdx = this.WanderTarget.X - this.X
      let wdy = this.WanderTarget.Y - this.Y
      let wd = MathX.safeLen(wdx, wdy)
      if wd > 8:
        this.X = this.X + wdx / wd * 85 * dt
        this.Y = this.Y + wdy / wd * 85 * dt
    if this.AttackTimer <= 0:
      let ringPhase = this.Phase == 2
      if ringPhase != nil:
        this.AttackTimer = 1.4
      else:
        this.AttackTimer = 2
      let tx = target.X ?? target.x
      let ty = target.Y ?? target.y
      let mainAng = Math.atan2(ty - this.Y, tx - this.X)
      let angles = [mainAng - 0.45, mainAng, mainAng + 0.45]
      for base in angles:
        nil
      Services.Fx.RingShockwave(this.X, this.Y, "#f87171", 38, 0.04)
      Services.Sound.PlayExplosion(0.85)
      if ringPhase != nil and world.Hazards.length < 70:
        nil
  fn UpdateEternalOuroboros(dt:int, target:SnakePlayer, _dist:int, world:World) -> void:
    this.SpiralAngle = this.SpiralAngle + dt * this.Phase == 2 and 4.2 or 3
    this.MoveTimer = this.MoveTimer - dt
    let cx = this.ArenaW * 0.5
    let cy = this.ArenaH * 0.45
    let orbitR = Math.min(this.ArenaW, this.ArenaH) * 0.25
    this.X = this.X + cx + Math.cos(this.SpiralAngle * 0.45) * orbitR - this.X * Math.min(1, dt * 1.5)
    this.Y = this.Y + cy + Math.sin(this.SpiralAngle * 0.45) * orbitR * 0.75 - this.Y * Math.min(1, dt * 1.5)
    if this.AttackTimer <= 0:
      if this.Phase == 2:
        this.AttackTimer = 0.12
      else:
        this.AttackTimer = 0.18
      let arms = this.Phase == 2 and 4 or 3
    if this.MoveTimer <= 0:
      if this.Phase == 2:
        this.MoveTimer = 2.8
      else:
        this.MoveTimer = 4
      let novaCount = this.Phase == 2 and 24 or 16
      let tx = target.X ?? target.x
      let ty = target.Y ?? target.y
      Services.Fx.RingShockwave(this.X, this.Y, "#ffd166", 50, 0.035)
      Services.Sound.PlayBossAlert()
      if this.Phase == 2 and world.Hazards.length < 70:
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-100, 100), 40, this.ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-100, 100), 40, this.ArenaH - 40), "laser", { Radius: 50, Life: 1.5, ImpactDamage: 32 + this.Floor * 3, Telegraph: 0.7, Owner: "enemy" }))
  fn Parts() -> [BossSegment] = this.Segments
  fn parts() -> [BossSegment] = this.Parts()
