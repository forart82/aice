module poc_real_case/snake_ts/src/sim/Boss

from "../core/MathX.js" import MathX
from "../core/Rng.js" import Rng
from "../core/Services.js" import Services
from "../core/Vec2.js" import Vec2
from "../data/GameData.js" import GameData
from "../data/Types.js" import BossArchetypeDef
from "./StatusSet.js" import StatusSet
from "./Hazard.js" import Hazard
from "./Projectile.js" import Projectile
from "./SnakePlayer.js" import SnakePlayer
from "./World.js" import World

pub class BossSegment:
  X = 0, Y = 0, Angle = 0, R = 15, Hp = 25
  MaxHp = 25, HitFlash = 0
  fn get_x() = X; fn set_x(v) = X = v
  fn get_y() = Y; fn set_y(v) = Y = v
  fn get_angle() = Angle; fn set_angle(v) = Angle = v
  fn get_r() = R; fn set_r(v) = R = v
  fn get_hp() = Hp; fn set_hp(v) = Hp = v
  fn get_maxHp() = MaxHp; fn set_maxHp(v) = MaxHp = v
  fn get_hitFlash() = HitFlash; fn set_hitFlash(v) = HitFlash = v

type ITelegraphAttack:
  type:"circle" | "cone" | "line" | "hazard" | "ring" | str
  x:Option[int], y:Option[int], x1:Option[int], y1:Option[int], x2:Option[int]
  y2:Option[int], width:Option[int], radius:Option[int], length:Option[int], spread:Option[int]
  angle:Option[int], progress:int, color:Option[str], maxRadius:Option[int], innerRadius:Option[int]

pub class Boss:
  static readonly RomanNumerals = ["", "II", "III", "IV", "V"]
  static readonly SpreadPhase1 = [-0.28, 0, 0.28]
  static readonly SpreadPhase2 = [-0.5, -0.25, 0, 0.25, 0.5]
  static readonly NoParts: [BossSegment] = []
  Floor:int, ArenaW:int, ArenaH:int, Type:str, Name:str
  Title:str, Color:str, Accent:str, Radius:int, HeadHp = 50
  HeadMaxHp = 50, _targetTotalMaxHp = 0, X:int, Y:int, Angle = 0
  SpiralAngle = 0, Phase = 1, AttackTimer = 2.2, MoveTimer = 0, Telegraph = 0
  HitFlash = 0, StasisTimer = 0
  Status: StatusSet
  Dead = false, ContactDamage:int, XpValue:int = GameData.BossDefeatOuro, EntranceTimer = 1.4
  WanderTarget: Vec2
  Segments: [BossSegment] = []
  Telegraphs: [ITelegraphAttack] = []
  SegmentSpacing = 20, OnPhaseChange = false, MultiBossScale = 1
  fn get_headHp() = HeadHp; fn set_headHp(v) = HeadHp = v
  fn get_headMaxHp() = HeadMaxHp; fn set_headMaxHp(v) = HeadMaxHp = v
  fn get_MaxHp() -> int:
    if _targetTotalMaxHp > 0:
      ret _targetTotalMaxHp
    sum ::= HeadMaxHp
    sum
  fn set_MaxHp(v:int) :
    _targetTotalMaxHp = v
    this.InitSegmentHealth()
  fn get_Hp() -> int:
    sum ::= HeadHp
    sum
  fn set_Hp(v:int) :
    if not Number.isFinite(v) or v <= 0:
      HeadHp = 0
      for s in Segments:
        nil
      Segments.length = 0
      Dead = true
      ret
    remaining ::= v
    HeadHp = Math.min(HeadMaxHp, remaining)
    remaining -= HeadHp
  fn get_segmentSpacing() = SegmentSpacing; fn set_segmentSpacing(v) = SegmentSpacing = v
  fn get_multiBossScale() = MultiBossScale; fn set_multiBossScale(v) = MultiBossScale = v
  fn get_floor() = Floor; fn set_floor(v) = Floor = v
  fn get_arenaW() = ArenaW; fn set_arenaW(v) = ArenaW = v
  fn get_arenaH() = ArenaH; fn set_arenaH(v) = ArenaH = v
  fn get_type() = Type; fn set_type(v) = Type = v
  fn get_name() = Name; fn set_name(v) = Name = v
  fn get_title() = Title; fn set_title(v) = Title = v
  fn get_color() = Color; fn set_color(v) = Color = v
  fn get_accent() = Accent; fn set_accent(v) = Accent = v
  fn get_radius() = Radius; fn set_radius(v) = Radius = v
  fn get_maxHp() = this.MaxHp; fn set_maxHp(v) = this.MaxHp = v
  fn get_hp() = this.Hp; fn set_hp(v) = this.Hp = v
  fn get_x() = X; fn set_x(v) = X = v
  fn get_y() = Y; fn set_y(v) = Y = v
  fn get_angle() = Angle; fn set_angle(v) = Angle = v
  fn get_spiralAngle() = SpiralAngle; fn set_spiralAngle(v) = SpiralAngle = v
  fn get_phase() = Phase; fn set_phase(v) = Phase = v
  fn get_attackTimer() = AttackTimer; fn set_attackTimer(v) = AttackTimer = v
  fn get_moveTimer() = MoveTimer; fn set_moveTimer(v) = MoveTimer = v
  fn get_telegraph() = Telegraph; fn set_telegraph(v) = Telegraph = v
  fn get_telegraphs() = Telegraphs; fn set_telegraphs(v) = Telegraphs = v
  fn get_hitFlash() = HitFlash; fn set_hitFlash(v) = HitFlash = v
  fn get_stasisTimer() = StasisTimer; fn set_stasisTimer(v) = StasisTimer = v
  fn get_status() = Status; fn set_status(v) = Status = v
  fn get_dead() = Dead; fn set_dead(v) = Dead = v
  fn get_Alive() = not Dead and this.Hp > 0
  fn get_alive() = this.Alive
  fn get_contactDamage() = ContactDamage; fn set_contactDamage(v) = ContactDamage = v
  fn get_xpValue() = XpValue; fn set_xpValue(v) = XpValue = v
  fn get_entranceTimer() = EntranceTimer; fn set_entranceTimer(v) = EntranceTimer = v
  fn get_wanderTarget() = WanderTarget; fn set_wanderTarget(v) = WanderTarget = v
  fn get_segments() = Segments; fn set_segments(v) = Segments = v
  fn get_onPhaseChange() = OnPhaseChange; fn set_onPhaseChange(v) = OnPhaseChange = v
  fn constructor(floor:int, arenaW:int, arenaH:int, specificTypeOrArchetype:str | BossArchetypeDef, startX:int, startY:int, multiBossScale:unknown = 1):
    Floor = Math.max(1, floor)
    ArenaW = arenaW
    ArenaH = arenaH
    MultiBossScale = multiBossScale
    arch ::= GameData.Bosses[Floor - 1 % GameData.Bosses.length]
    if specificTypeOrArchetype != nil:
      if typeof(specificTypeOrArchetype) == "object" and specificTypeOrArchetype != nil:
        arch = specificTypeOrArchetype
      elif typeof(specificTypeOrArchetype) == "string":
        str := specificTypeOrArchetype.toLowerCase()
        found := GameData.Bosses.find(fn(b:unknown) = b.Type.toLowerCase() == str or b.type.toLowerCase() == str or b.Name.toLowerCase() == str or b.name.toLowerCase() == str)
        if found != nil:
          arch = found
    cycle := Math.floor(Math)
    cycleFloor := cycle * GameData.Bosses.length
    Type = arch.Type
    if cycle > 0:
      Name = "" + String(arch.Name) + " " + String(Boss.RomanNumerals[Math.min(cycle, 4)]).trim()
    else:
      Name = arch.Name
    Title = arch.Title
    Color = arch.Color
    Accent = arch.Accent
    Radius = arch.Radius
    unscaledHp := MathX.roundJs(arch.BaseHp + arch.HpPerFloor * cycleFloor * 1 + cycle * 0.35)
    if MultiBossScale != 1:
      _targetTotalMaxHp = MathX.roundJs(unscaledHp * MultiBossScale)
    else:
      _targetTotalMaxHp = unscaledHp
    if startX != undefined:
      X = startX
    else:
      X = arenaW * 0.5
    if startY != undefined:
      Y = startY
    else:
      Y = arenaH * 0.28
    Status = StatusSet()
    ContactDamage = 16 + Floor * 3
    WanderTarget = Vec2(X, arenaH * 0.3)
    segCount ::= 14
    baseRad ::= 15
    spacing ::= 20
    if Type == "centipede":
      segCount = 14 + Math.min(10, Floor * 2)
      baseRad = 15
      spacing = 21
    elif Type == "gorgon":
      segCount = 12 + Math.min(8, Floor * 2)
      baseRad = 14
      spacing = 20
    SegmentSpacing = spacing
    this.InitSegmentHealth()
  fn InitSegmentHealth() :
    total := _targetTotalMaxHp
    n := Segments.length
    if n == 0:
      HeadMaxHp = total
      HeadHp = total
      ret
    totalWeights := n + 2
    unitHp := Math.max(1, Math.floor(Math))
    headHp := total - unitHp * n
    HeadMaxHp = headHp
    HeadHp = headHp
  fn get_Vulnerable() = EntranceTimer <= 0 and not Dead
  fn set_Vulnerable(v:bool) :
    if v != nil:
      EntranceTimer = 0
    else:
      EntranceTimer = 999
  fn get_vulnerable() = this.Vulnerable; fn set_vulnerable(v) = this.Vulnerable = v
  fn get_HpPct() = MathX.clamp(this.Hp / this.MaxHp, 0, 1)
  fn get_hpPct() = this.HpPct
  fn ApplyDamage(amount:int) -> bool:
    if not this.Vulnerable or not (amount > 0):
      ret false
    effectiveDmg := amount * Status.DamageTakenMult
    toHp ::= effectiveDmg
    HitFlash = 1
    while toHp > 0 and Segments.length > 0:
      lastIdx := Segments.length - 1
      lastSeg := Segments[lastIdx]
      if lastSeg.Hp > toHp:
        lastSeg.Hp = lastSeg.Hp - toHp
        lastSeg.HitFlash = 1
        toHp = 0
      else:
        toHp -= lastSeg.Hp
        Services.Fx.Burst(lastSeg.X, lastSeg.Y, Color, 8, 3, 2)
        Segments.pop()
    if toHp > 0:
      HeadHp = Math.max(0, HeadHp - toHp)
    if this.Hp > 0 and this.Hp <= this.MaxHp * 0.5 and Phase == 1:
      Phase = 2
      AttackTimer = 0.9
      OnPhaseChange = true
    if Segments.length == 0 and HeadHp <= 0:
      HeadHp = 0
      Dead = true
      ret true
    false
  fn applyDamage(amount:int) -> bool = this.ApplyDamage(amount)
  fn DamageHead(amount:int) -> bool = this.ApplyDamage(amount)
  fn damageHead(amount:int) -> bool = this.DamageHead(amount)
  fn DamageSegment(index:int, amount:int) -> bool:
    if typeof(index) != "number" or not Number.isInteger(index) or index < 0 or index >= Segments.length:
      ret false
    if not this.Vulnerable or not (amount > 0) or not Number.isFinite(amount):
      ret false
    effectiveDmg := amount * Status.DamageTakenMult
    seg := Segments[index]
    seg.Hp = seg.Hp - effectiveDmg
    seg.HitFlash = 1
    HitFlash = 0.6
    if seg.Hp <= 0:
      this.SeverFrom(index)
    if this.Hp > 0 and this.Hp <= this.MaxHp * 0.5 and Phase == 1:
      Phase = 2
      AttackTimer = 0.9
      OnPhaseChange = true
    if Segments.length == 0 and HeadHp <= 0:
      HeadHp = 0
      Dead = true
      ret true
    false
  fn damageSegment(index:int, amount:int) -> bool = this.DamageSegment(index, amount)
  fn SeverFrom(index:int) :
    if typeof(index) != "number" or not Number.isInteger(index) or index < 0 or index >= Segments.length:
      ret
    Services.Sound.PlayExplosion()
    Segments.splice(index)
    if Segments.length == 0 and HeadHp <= 0:
      HeadHp = 0
      Dead = true
  fn severFrom(index:int) :
    this.SeverFrom(index)
  fn Update(dt:int, target:SnakePlayer, world:World) :
    if not Number.isFinite(dt) or dt <= 0 or not target or not world:
      ret
    if not Number.isFinite(X):
      X = ArenaW * 0.5
    if not Number.isFinite(Y):
      Y = ArenaH * 0.3
    if not Number.isFinite(Angle):
      Angle = 0
    if HitFlash > 0:
      HitFlash = Math.max(0, HitFlash - dt * 5)
    burn := Status.Update(dt)
    if burn > 0:
      this.ApplyDamage(burn)
    if EntranceTimer > 0:
      EntranceTimer -= dt
      ret
    if Status.Immobile != nil:
      ret
    if StasisTimer > 0:
      StasisTimer = Math.max(0, StasisTimer - dt)
    stasisMult := StasisTimer > 0 and 0.2 or 1
    worldScale := world != nil and world.TimeScale != undefined and world.TimeScale or 1
    scale := Status.SpeedMult * stasisMult * worldScale != 0 and worldScale or 1
    tx := target.X ?? target.x
    ty := target.Y ?? target.y
    dx := tx - X
    dy := ty - Y
    dist := MathX.safeLen(dx, dy)
    AttackTimer -= dt * scale
    if Type == "centipede":
      this.UpdateCentipede(dt * scale, dx, dy, dist, world)
    elif Type == "gorgon":
      this.UpdateGorgon(dt * scale, dx, dy, dist, target, world)
    this.UpdateSegments(dt * scale)
    aw := ArenaW or world.ArenaW or world.arenaW
    ah := ArenaH or world.ArenaH or world.arenaH
    X = MathX.clamp(X, Radius, aw - Radius)
    Y = MathX.clamp(Y, Radius, ah - Radius)
  fn update(dt:int, target:SnakePlayer, world:World) :
    this.Update(dt, target, world)
  fn UpdateSegments(_dt:int) :
    px ::= Number.isFinite(X) and X or ArenaW * 0.5
    py ::= Number.isFinite(Y) and Y or ArenaH * 0.5
    spacing := SegmentSpacing
    n := Segments.length
  fn updateSegments(dt:int) :
    this.UpdateSegments(dt)
  fn stepIK(dt:int) :
    this.UpdateSegments(dt)
  fn stepIk(dt:int) :
    this.UpdateSegments(dt)
  fn UpdateCentipede(dt:int, dx:int, dy:int, _dist:int, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 6.5 or 4.5 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 185 or 130
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1.4
      else:
        AttackTimer = 2.2
      spread := Phase == 2 and Boss.SpreadPhase2 or Boss.SpreadPhase1
      Services.Sound.PlayShoot()
  fn UpdateGorgon(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 6 or 4 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 145 or 92
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1.3
      else:
        AttackTimer = 2
      count := Phase == 2 and 8 or 4
      baseAng := Angle
      Services.Fx.RingShockwave(X, Y, "#00f0b5", 28, 0.04)
      Services.Sound.PlayThunder()
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-120, 120), 40, ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-120, 120), 40, ArenaH - 40), "laser", { Radius: 40, Life: 1.2, ImpactDamage: 24 + Floor * 3, Telegraph: 0.9, Owner: "enemy" }))
  fn UpdateColossus(dt:int, target:SnakePlayer, _dist:int, world:World) :
    MoveTimer -= dt
    if MoveTimer <= 0 or not WanderTarget:
      MoveTimer = Rng.Shared.range(2.4, 4.2)
      WanderTarget = Vec2(Rng.Shared.range(ArenaW * 0.2, ArenaW * 0.8), Rng.Shared.range(ArenaH * 0.18, ArenaH * 0.6))
    if WanderTarget != nil:
      wdx := WanderTarget.X - X
      wdy := WanderTarget.Y - Y
      wd := MathX.safeLen(wdx, wdy)
      if wd > 8:
        X += wdx / wd * 62 * dt
        Y += wdy / wd * 62 * dt
    if AttackTimer <= 0:
      ringPhase := Phase == 2
      if ringPhase != nil:
        AttackTimer = 1.6
      else:
        AttackTimer = 2.3
      count := ringPhase != nil and 22 or 15
      baseAngle := Rng.Shared.angle()
      Services.Fx.RingShockwave(X, Y, Accent, 34, 0.035)
      Services.Sound.PlayExplosion(0.8)
      if ringPhase != nil and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
  fn UpdateFrostwyrm(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 5.5 or 3.8 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 138 or 78
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1.4
      else:
        AttackTimer = 2.2
      count := Phase == 2 and 12 or 8
      baseAng := Rng.Shared.angle()
      Services.Fx.RingShockwave(X, Y, "#38bdf8", 32, 0.03)
      Services.Sound.PlayShoot()
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
  fn UpdateLeviathan(dt:int, target:SnakePlayer, _dist:int, world:World) :
    SpiralAngle += dt * Phase == 2 and 3.4 or 2.4
    MoveTimer -= dt
    cx := ArenaW * 0.5
    cy := ArenaH * 0.42
    orbitR := Math.min(ArenaW, ArenaH) * 0.22
    ox := cx + Math.cos(SpiralAngle * 0.35) * orbitR
    oy := cy + Math.sin(SpiralAngle * 0.55) * orbitR * 0.6
    X += ox - X * Math.min(1, dt * 1.4)
    Y += oy - Y * Math.min(1, dt * 1.4)
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 0.1
      else:
        AttackTimer = 0.16
      arms := Phase == 2 and 3 or 2
    if MoveTimer <= 0:
      if Phase == 2:
        MoveTimer = 3.4
      else:
        MoveTimer = 5
      n := Phase == 2 and 3 or 2
      tx := target.X ?? target.x
      ty := target.Y ?? target.y
      Services.Sound.PlayBossAlert()
  fn UpdateChronoWyrm(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 6.2 or 4.2 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 160 or 110
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1.2
      else:
        AttackTimer = 1.9
      count := Phase == 2 and 8 or 5
      Services.Fx.RingShockwave(X, Y, "#a855f7", 30, 0.04)
      Services.Sound.PlayBossAlert()
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-100, 100), 40, ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-100, 100), 40, ArenaH - 40), "chrono", { Radius: 45, Life: 2.5, ImpactDamage: 18 + Floor * 2, Telegraph: 0.8, Owner: "enemy" }))
  fn UpdateHivemind(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 5.8 or 3.9 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 130 or 85
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1.1
      else:
        AttackTimer = 1.8
      count := Phase == 2 and 10 or 6
      Services.Fx.RingShockwave(X, Y, "#84cc16", 28, 0.05)
      Services.Sound.PlayShoot()
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-120, 120), 40, ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-120, 120), 40, ArenaH - 40), "poison", { Radius: 50, Life: 3.5, Dps: 15 + Floor * 2, Telegraph: 0.85, Owner: "enemy" }))
  fn UpdateSuperconductor(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 6.8 or 4.6 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 180 or 125
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1
      else:
        AttackTimer = 1.6
      count := Phase == 2 and 12 or 8
      Services.Fx.RingShockwave(X, Y, "#06d6a0", 36, 0.03)
      Services.Sound.PlayThunder()
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-90, 90), 40, ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-90, 90), 40, ArenaH - 40), "laser", { Radius: 42, Life: 1.5, ImpactDamage: 28 + Floor * 3, Telegraph: 0.75, Owner: "enemy" }))
  fn UpdateQuantumHydra(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 7.2 or 5 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 190 or 135
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1
      else:
        AttackTimer = 1.7
      count := Phase == 2 and 10 or 5
      Services.Fx.RingShockwave(X, Y, "#c084fc", 34, 0.035)
      Services.Sound.PlayShoot()
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-110, 110), 40, ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-110, 110), 40, ArenaH - 40), "laser", { Radius: 44, Life: 1.4, ImpactDamage: 26 + Floor * 3, Telegraph: 0.8, Owner: "enemy" }))
  fn UpdateMirrorWyrm(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 7.5 or 5.2 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 195 or 140
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 0.95
      else:
        AttackTimer = 1.6
      count := Phase == 2 and 6 or 3
      Services.Fx.RingShockwave(X, Y, "#f43f5e", 30, 0.04)
      Services.Sound.PlayShoot()
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-100, 100), 40, ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-100, 100), 40, ArenaH - 40), "poison", { Radius: 42, Life: 2.8, Dps: 18 + Floor * 2, Telegraph: 0.7, Owner: "enemy" }))
  fn UpdateVoidDevourer(dt:int, target:SnakePlayer, _dist:int, world:World) :
    SpiralAngle += dt * Phase == 2 and 3.8 or 2.6
    MoveTimer -= dt
    cx := ArenaW * 0.5
    cy := ArenaH * 0.45
    orbitR := Math.min(ArenaW, ArenaH) * 0.24
    ox := cx + Math.cos(SpiralAngle * 0.4) * orbitR
    oy := cy + Math.sin(SpiralAngle * 0.6) * orbitR * 0.65
    X += ox - X * Math.min(1, dt * 1.5)
    Y += oy - Y * Math.min(1, dt * 1.5)
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 0.12
      else:
        AttackTimer = 0.18
      arms := Phase == 2 and 4 or 3
    if MoveTimer <= 0:
      if Phase == 2:
        MoveTimer = 3
      else:
        MoveTimer = 4.5
      tx := target.X ?? target.x
      ty := target.Y ?? target.y
      Services.Fx.RingShockwave(X, Y, "#7928ca", 45, 0.04)
      Services.Sound.PlayBossAlert()
  fn UpdateOrbitalDreadnought(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 5.2 or 3.6 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 140 or 95
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1.1
      else:
        AttackTimer = 1.8
      world.Projectiles.push(Projectile(X, Y, Angle - 0.15, 310, 26 + Floor * 2, "enemy", "#06b6d4", { life: 2.8 }), Projectile(X, Y, Angle + 0.15, 310, 26 + Floor * 2, "enemy", "#06b6d4", { life: 2.8 }))
      if Phase == 2:
        nil
      Services.Fx.RingShockwave(X, Y, "#06b6d4", 38, 0.03)
      Services.Sound.PlayShoot()
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-120, 120), 40, ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-120, 120), 40, ArenaH - 40), "laser", { Radius: 45, Life: 1.3, ImpactDamage: 28 + Floor * 3, Telegraph: 0.75, Owner: "enemy" }))
  fn UpdateIronJuggernaut(dt:int, target:SnakePlayer, _dist:int, world:World) :
    MoveTimer -= dt
    if MoveTimer <= 0 or not WanderTarget:
      MoveTimer = Rng.Shared.range(2, 3.8)
      WanderTarget = Vec2(Rng.Shared.range(ArenaW * 0.2, ArenaW * 0.8), Rng.Shared.range(ArenaH * 0.2, ArenaH * 0.6))
    if WanderTarget != nil:
      wdx := WanderTarget.X - X
      wdy := WanderTarget.Y - Y
      wd := MathX.safeLen(wdx, wdy)
      if wd > 8:
        X += wdx / wd * 80 * dt
        Y += wdy / wd * 80 * dt
    if AttackTimer <= 0:
      ringPhase := Phase == 2
      if ringPhase != nil:
        AttackTimer = 1.5
      else:
        AttackTimer = 2.2
      count := ringPhase != nil and 24 or 16
      baseAngle := Rng.Shared.angle()
      Services.Fx.RingShockwave(X, Y, "#64748b", 42, 0.04)
      Services.Sound.PlayExplosion(0.9)
      if ringPhase != nil and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
