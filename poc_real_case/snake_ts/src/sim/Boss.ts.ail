  fn UpdateNaniteTitan(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) :
    targetAngle := Math.atan2(dy, dx)
    maxTurnRate := Phase == 2 and 5.8 or 4 * dt
    diff := MathX.angleDelta(Angle, targetAngle)
    Angle += Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    speed := Phase == 2 and 145 or 100
    X += Math.cos(Angle) * speed * dt
    Y += Math.sin(Angle) * speed * dt
    if AttackTimer <= 0:
      if Phase == 2:
        AttackTimer = 1
      else:
        AttackTimer = 1.7
      count := Phase == 2 and 10 or 6
      Services.Fx.RingShockwave(X, Y, "#34d399", 32, 0.04)
      Services.Sound.PlayShoot()
      if Phase == 2 and Segments.length < 24 and Rng.Shared.chance(0.35):
        lastSeg := Segments[Segments.length - 1]
        newSeg := BossSegment()
        if lastSeg != nil:
          newSeg.X = lastSeg.X
        else:
          newSeg.X = X
        if lastSeg != nil:
          newSeg.Y = lastSeg.Y + SegmentSpacing
        else:
          newSeg.Y = Y
        newSeg.R = 12
        newSeg.MaxHp = 30
        newSeg.Hp = 30
        Segments.push(newSeg)
        Services.Fx.Burst(newSeg.X, newSeg.Y, "#10b981", 8, 3, 2)
      if Phase == 2 and world.Hazards.length < 70:
        tx := target.X ?? target.x
        ty := target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-120, 120), 40, ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-120, 120), 40, ArenaH - 40), "poison", { Radius: 48, Life: 3, Dps: 18 + Floor * 2, Telegraph: 0.8, Owner: "enemy" }))
