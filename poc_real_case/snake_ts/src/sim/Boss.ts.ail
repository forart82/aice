  fn UpdateNaniteTitan(dt:int, dx:int, dy:int, _dist:int, target:SnakePlayer, world:World) -> void:
    let targetAngle = Math.atan2(dy, dx)
    let maxTurnRate = this.Phase == 2 and 5.8 or 4 * dt
    let diff = MathX.angleDelta(this.Angle, targetAngle)
    this.Angle = this.Angle + Math.sign(diff) * Math.min(Math.abs(diff), maxTurnRate)
    let speed = this.Phase == 2 and 145 or 100
    this.X = this.X + Math.cos(this.Angle) * speed * dt
    this.Y = this.Y + Math.sin(this.Angle) * speed * dt
    if this.AttackTimer <= 0:
      if this.Phase == 2:
        this.AttackTimer = 1
      else:
        this.AttackTimer = 1.7
      let count = this.Phase == 2 and 10 or 6
      Services.Fx.RingShockwave(this.X, this.Y, "#34d399", 32, 0.04)
      Services.Sound.PlayShoot()
      if this.Phase == 2 and this.Segments.length < 24 and Rng.Shared.chance(0.35):
        let lastSeg = this.Segments[this.Segments.length - 1]
        let newSeg = BossSegment()
        if lastSeg != nil:
          newSeg.X = lastSeg.X
        else:
          newSeg.X = this.X
        if lastSeg != nil:
          newSeg.Y = lastSeg.Y + this.SegmentSpacing
        else:
          newSeg.Y = this.Y
        newSeg.R = 12
        newSeg.MaxHp = 30
        newSeg.Hp = 30
        this.Segments.push(newSeg)
        Services.Fx.Burst(newSeg.X, newSeg.Y, "#10b981", 8, 3, 2)
      if this.Phase == 2 and world.Hazards.length < 70:
        let tx = target.X ?? target.x
        let ty = target.Y ?? target.y
        world.Hazards.push(Hazard(MathX.clamp(tx + Rng.Shared.range(-120, 120), 40, this.ArenaW - 40), MathX.clamp(ty + Rng.Shared.range(-120, 120), 40, this.ArenaH - 40), "poison", { Radius: 48, Life: 3, Dps: 18 + this.Floor * 2, Telegraph: 0.8, Owner: "enemy" }))
