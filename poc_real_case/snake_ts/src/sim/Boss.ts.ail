        Y += wdy / wd * 85 * dt
    if AttackTimer <= 0:
      ringPhase := Phase == 2
      if ringPhase != nil:
        AttackTimer = 1.4
      else:
        AttackTimer = 2
      tx := target.X ?? target.x
      ty := target.Y ?? target.y
      mainAng := Math.atan2(ty - Y, tx - X)
      angles := [mainAng - 0.45, mainAng, mainAng + 0.45]
      for base in angles:
        nil
      Services.Fx.RingShockwave(X, Y, "#f87171", 38, 0.04)
      Services.Sound.PlayExplosion(0.85)
      if ringPhase != nil and world.Hazards.length < 70:
        nil
