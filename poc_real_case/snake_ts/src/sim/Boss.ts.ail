  fn UpdateVolcanicChimera(dt:int, target:SnakePlayer, _dist:int, world:World) :
    MoveTimer -= dt
    if MoveTimer <= 0 or not WanderTarget:
      MoveTimer = Rng.Shared.range(2.2, 3.8)
      WanderTarget = Vec2(Rng.Shared.range(ArenaW * 0.25, ArenaW * 0.75), Rng.Shared.range(ArenaH * 0.2, ArenaH * 0.6))
