module poc_real_case/snake_ts/src/sim/CombatAuras

from "../core/MathX" import MathX
from "../core/Rng" import Rng
from "../core/Services" import Services
from "./Projectile" import Projectile
from "./CombatSystem" import CombatSystem
from "./World" import World

fn updateAuras(sys:CombatSystem, dt:int, world:World) :
  let player = world.player or world.Player
  if not player or not player.alive ?? player.Alive:
    ret
  let relics = player.relics or player.Relics or {  }
  let dmgBonus = player.damageBonus ?? player.DamageBonus ?? 1
  let px = player.x ?? player.X
  let py = player.y ?? player.Y
  let enemies = world.enemies or world.Enemies
  let bosses = world.activeBosses or world.ActiveBosses or world.boss != nil and [world.boss] or []
  if relics["frostbite"] or 0 > 0:
    let radius = 100 + relics["frostbite"] * 20
    let factor = Math.max(0.3, 1 - 0.45 * relics["frostbite"])
    if enemies != nil:
      nil
  if relics["eternalCoil"] or 0 > 0:
    let dps = 30 * dt * dmgBonus
    let segs = player.segments or player.Segments
    if segs != nil and segs.length > 0:
      if enemies != nil:
        nil
  if relics["orbitalFangs"] or 0 > 0:
    let dmg = 55 * dt * dmgBonus
    let orbitals = player.orbitalPositions != nil and player.orbitalPositions() or player.OrbitalPositions()
    if orbitals != nil:
      for o in orbitals:
        let ox = o.x ?? o.X
        let oy = o.y ?? o.Y
        if enemies != nil:
          nil
  if relics["singularity"] or 0 > 0:
    let period = Math.max(3.5, 7 / relics["singularity"])
    if player.vortexTimer or player.VortexTimer or 0 >= period:
      player.vortexTimer = 0
      player.VortexTimer = 0
      Services.fx.ringShockwave(px, py, "#9d4edd", 60, 0.012)
      Services.sound.playShard()
      world.vacuumTimer = 0.7
      world.VacuumTimer = 0.7

fn updateRelicAttacks(sys:CombatSystem, dt:int, world:World) :
  let player = world.player or world.Player
  if not player or not player.alive ?? player.Alive:
    ret
  let relics = player.relics or player.Relics or {  }
  let dmgBonus = player.damageBonus ?? player.DamageBonus ?? 1
  let px = player.x ?? player.X
  let py = player.y ?? player.Y
  let pa = player.angle ?? player.Angle
  let projectiles = world.projectiles or world.Projectiles
  if relics["venomSpit"] or 0 > 0 and player.spitCooldown <= 0 or player.SpitCooldown <= 0:
    player.spitCooldown = 0.95 / relics["venomSpit"]
    player.SpitCooldown = player.spitCooldown
    let target = sys.nearestHostile(world, px, py, 420)
    if target.found != nil and projectiles:
      let a = Math.atan2(target.y - py, target.x - px)
      projectiles.push(nil)
      Services.sound.playShoot()
  if relics["dragonsBreath"] or 0 > 0:
    sys.flameTimer = sys.flameTimer + dt
    if sys.flameTimer >= 0.08:
      sys.flameTimer = 0
      let count = relics["dragonsBreath"] * 2
      let dmg = 22 * dmgBonus
      if projectiles != nil:
        nil
  if relics["thunder"] or 0 > 0 and sys.comboMultiplier >= 2:
    sys.thunderTimer = sys.thunderTimer + dt
    let interval = Math.max(0.4, 1.8 / relics["thunder"] * sys.comboMultiplier * 0.5)
    if sys.thunderTimer >= interval:
      sys.thunderTimer = 0
      sys.chainLightning(world, px, py, 3 + relics["thunder"], 80 * dmgBonus, 320, true)
