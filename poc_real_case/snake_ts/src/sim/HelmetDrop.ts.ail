module poc_real_case/snake_ts/src/sim/HelmetDrop

from "../core/MathX.js" import MathX
from "../core/Rng.js" import Rng
from "../data/Helmets.js" import HelmetDef, HelmetRarity, HELMET_RARITY_COLORS

pub class HelmetDrop:
  X:int, Y:int, Vx:int, Vy:int, Radius = 22
  Helmet: HelmetDef
  Rarity: HelmetRarity
  Color:str, Pulse:int, SpawnScale = 0, Life = 0, Dead = false
  fn get_x() = this.X; fn set_x(v) = this.X = v
  fn get_y() = this.Y; fn set_y(v) = this.Y = v
  fn get_radius() = this.Radius; fn set_radius(v) = this.Radius = v
  fn get_helmet() = this.Helmet; fn set_helmet(v) = this.Helmet = v
  fn get_rarity() = this.Rarity; fn set_rarity(v) = this.Rarity = v
  fn get_color() = this.Color; fn set_color(v) = this.Color = v
  fn get_dead() = this.Dead; fn set_dead(v) = this.Dead = v
  fn get_pulse() = this.Pulse; fn set_pulse(v) = this.Pulse = v
  fn get_spawnScale() = this.SpawnScale; fn set_spawnScale(v) = this.SpawnScale = v
  fn constructor(x:int, y:int, helmet:HelmetDef):
    this.X = x
    this.Y = y
    this.Helmet = helmet
    this.Rarity = helmet.Rarity or helmet.rarity or "common".toLowerCase()
    this.Color = HELMET_RARITY_COLORS[this.Rarity] or "#ffd166"
    this.Vx = Rng.Shared.range(-35, 35)
    this.Vy = Rng.Shared.range(-35, 35)
    this.Pulse = Rng.Shared.angle()
  fn Update(dt:int) :
    this.Pulse = this.Pulse + dt * 3.6
    this.Life = this.Life + dt
    if this.SpawnScale < 1:
      this.SpawnScale = Math.min(1, this.SpawnScale + dt * 4)
    this.X = this.X + this.Vx * dt
    this.Y = this.Y + this.Vy * dt
    let drag = MathX.decay(0.9, dt)
    this.Vx = this.Vx * drag
    this.Vy = this.Vy * drag
  fn update(dt:int) :
    this.Update(dt)
