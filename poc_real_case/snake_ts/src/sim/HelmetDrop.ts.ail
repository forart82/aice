module poc_real_case/snake_ts/src/sim/HelmetDrop

from "../core/MathX.js" import MathX
from "../core/Rng.js" import Rng
from "../data/Helmets.js" import HelmetDef, HelmetRarity, HELMET_RARITY_COLORS

pub class HelmetDrop:
  X:int, Y:int, Vx:int, Vy:int, Radius = 22
  Helmet: HelmetDef
  Rarity: HelmetRarity
  Color:str, Pulse:int, SpawnScale = 0, Life = 0, Dead = false
  fn get_x() = X; fn set_x(v) = X = v
  fn get_y() = Y; fn set_y(v) = Y = v
  fn get_radius() = Radius; fn set_radius(v) = Radius = v
  fn get_helmet() = Helmet; fn set_helmet(v) = Helmet = v
  fn get_rarity() = Rarity; fn set_rarity(v) = Rarity = v
  fn get_color() = Color; fn set_color(v) = Color = v
  fn get_dead() = Dead; fn set_dead(v) = Dead = v
  fn get_pulse() = Pulse; fn set_pulse(v) = Pulse = v
  fn get_spawnScale() = SpawnScale; fn set_spawnScale(v) = SpawnScale = v
  fn constructor(x:int, y:int, helmet:HelmetDef):
    X = x
    Y = y
    Helmet = helmet
    Rarity = helmet.Rarity or helmet.rarity or "common".toLowerCase()
    Color = HELMET_RARITY_COLORS[Rarity] or "#ffd166"
    Vx = Rng.Shared.range(-35, 35)
    Vy = Rng.Shared.range(-35, 35)
    Pulse = Rng.Shared.angle()
  fn Update(dt:int) :
    Pulse += dt * 3.6
    Life += dt
    if SpawnScale < 1:
      SpawnScale = Math.min(1, SpawnScale + dt * 4)
    X += Vx * dt
    Y += Vy * dt
    let drag = MathX.decay(0.9, dt)
    Vx *= drag
    Vy *= drag
  fn update(dt:int) :
    this.Update(dt)
