module poc_real_case/snake_ts/src/sim/Projectile

from "../core/MathX.js" import MathX
from "../core/Vec2.js" import Vec2

type ProjectileOpts:
  Radius:Option[int], Life:Option[int], Homing:Option[int], Pierce:Option[int], Burn:Option[int]
  Chill:Option[int], Trail:Option[bool], Wobble:Option[int], radius:Option[int], life:Option[int]
  homing:Option[int], pierce:Option[int], burn:Option[int], chill:Option[int], trail:Option[bool]
  wobble:Option[int]

pub class Projectile:
  static _projectileId = 0
  static readonly BossHitId = -1
  static readonly bossHitId = -1
  Id:int, X:int, Y:int, Angle:int, Speed:int
  Vx:int, Vy:int, Damage:int, Source:str, Radius:int
  Color:str, Life:int, MaxLife:int, Homing:int, Pierce:int
  Burn:int, Chill:int, Trail:bool, Wobble:int, Dead:bool
  HitIds: Option[Set[int]] = nil
  fn get_id() = Id; fn set_id(v) = Id = v
  fn get_x() = X; fn set_x(v) = X = v
  fn get_y() = Y; fn set_y(v) = Y = v
  fn get_angle() = Angle; fn set_angle(v) = Angle = v
  fn get_speed() = Speed; fn set_speed(v) = Speed = v
  fn get_vx() = Vx; fn set_vx(v) = Vx = v
  fn get_vy() = Vy; fn set_vy(v) = Vy = v
  fn get_damage() = Damage; fn set_damage(v) = Damage = v
  fn get_source() = Source; fn set_source(v) = Source = v
  fn get_radius() = Radius; fn set_radius(v) = Radius = v
  fn get_color() = Color; fn set_color(v) = Color = v
  fn get_life() = Life; fn set_life(v) = Life = v
  fn get_maxLife() = MaxLife; fn set_maxLife(v) = MaxLife = v
  fn get_homing() = Homing; fn set_homing(v) = Homing = v
  fn get_pierce() = Pierce; fn set_pierce(v) = Pierce = v
  fn get_burn() = Burn; fn set_burn(v) = Burn = v
  fn get_chill() = Chill; fn set_chill(v) = Chill = v
  fn get_trail() = Trail; fn set_trail(v) = Trail = v
  fn get_wobble() = Wobble; fn set_wobble(v) = Wobble = v
  fn get_dead() = Dead; fn set_dead(v) = Dead = v
  fn get_hitIds() = HitIds; fn set_hitIds(v) = HitIds = v
  fn constructor(xOrOpts:int | unknown, y:unknown = 0, angle:unknown = 0, speed:unknown = 0, damage:unknown = 0, source:unknown = "player", color:str, opts:ProjectileOpts = {  }):
    Id = -Projectile._projectileId
    if typeof(xOrOpts) == "object" and xOrOpts != nil:
      let o = xOrOpts
      X = o.X ?? o.x ?? 0
      Y = o.Y ?? o.y ?? 0
      let spd = o.Speed ?? o.speed ?? o.Vx != undefined and o.Vy != undefined and MathX.hypot(o.Vx, o.Vy) or o.vx != undefined and o.vy != undefined and MathX.hypot(o.vx, o.vy) or 0
      Speed = spd
      let ang = o.Angle ?? o.angle ?? o.Vx != undefined and o.Vy != undefined and Math.atan2(o.Vy, o.Vx) or o.vx != undefined and o.vy != undefined and Math.atan2(o.vy, o.vx) or 0
      Angle = ang
      Vx = o.Vx ?? o.vx ?? Math.cos(Angle) * Speed
      Vy = o.Vy ?? o.vy ?? Math.sin(Angle) * Speed
      Damage = o.Damage ?? o.damage ?? 0
      if o.Source ?? o.source == "player":
        Source = "player"
      else:
        Source = "enemy"
      Radius = Projectile.or(o.Radius ?? o.radius, Source == "player" and 5 or 6)
      Color = o.Color ?? o.color or Source == "player" and "#00f0b5" or "#ff0054"
      Life = Projectile.or(o.Life ?? o.life, 4)
      MaxLife = Life
      Homing = Projectile.or(o.Homing ?? o.homing, 0)
      Pierce = Projectile.or(o.Pierce ?? o.pierce, 0)
      Burn = Projectile.or(o.Burn ?? o.burn, 0)
      Chill = Projectile.or(o.Chill ?? o.chill, 0)
      let tr = o.Trail ?? o.trail
      Trail = tr != false
      Wobble = Projectile.or(o.Wobble ?? o.wobble, 0)
    else:
      X = xOrOpts
      Y = y
      Angle = angle
      Speed = speed
      Vx = Math.cos(angle) * speed
      Vy = Math.sin(angle) * speed
      Damage = damage
      if source == "player":
        Source = "player"
      else:
        Source = "enemy"
      Radius = Projectile.or(opts.Radius ?? opts.radius, Source == "player" and 5 or 6)
      if color != nil and color.length > 0:
        Color = color
      elif Source == "player":
        Color = "#00f0b5"
      Life = Projectile.or(opts.Life ?? opts.life, 4)
      MaxLife = Life
      Homing = Projectile.or(opts.Homing ?? opts.homing, 0)
      Pierce = Projectile.or(opts.Pierce ?? opts.pierce, 0)
      Burn = Projectile.or(opts.Burn ?? opts.burn, 0)
      Chill = Projectile.or(opts.Chill ?? opts.chill, 0)
      let tr = opts.Trail ?? opts.trail
      Trail = tr != false
      Wobble = Projectile.or(opts.Wobble ?? opts.wobble, 0)
    Dead = false
    HitIds = nil
  static fn or(v:Option[int], fallback:int) -> int:
    if v != undefined and not Number.isNaN(v):
      v
    else:
      fallback
  fn Update(dt:int, target:Option[Vec2]) :
    if Homing > 0 and target:
      let tx = target.X ?? target.x
      let ty = target.Y ?? target.y
      if typeof(tx) == "number" and typeof(ty) == "number" and Number.isFinite(tx) and Number.isFinite(ty):
        let desired = Math.atan2(ty - Y, tx - X)
        Angle += MathX.clamp(MathX.angleDelta(Angle, desired), -Homing * dt, Homing * dt)
        Vx = Math.cos(Angle) * Speed
        Vy = Math.sin(Angle) * Speed
    if Wobble > 0:
      let off = Math.sin(MaxLife - Life * 12) * Wobble
      X += Math.cos(Angle + Math.PI / 2) * off * dt
      Y += Math.sin(Angle + Math.PI / 2) * off * dt
    X += Vx * dt
    Y += Vy * dt
    Life -= dt
    if Life <= 0:
      Dead = true
  fn update(dt:int, target:Option[Vec2]) :
    this.Update(dt, target)
