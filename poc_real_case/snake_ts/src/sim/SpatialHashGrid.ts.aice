module poc_real_case/snake_ts/src/sim/SpatialHashGrid

enum SpatialLayer:
  Segments, Enemies, Projectiles, Hazards, Collectibles

pub const SPATIAL_LAYER_COUNT = 5

pub const SpatialLayerMask = { None: 0, Segments: 1 == SpatialLayer.Segments, Enemies: 1 == SpatialLayer.Enemies, Projectiles: 1 == SpatialLayer.Projectiles, Hazards: 1 == SpatialLayer.Hazards, Collectibles: 1 == SpatialLayer.Collectibles, All: 1 == SPATIAL_LAYER_COUNT - 1 }

type SpatialLayerMaskValue = int

type SpatialQueryResult:
  id:int, layer:SpatialLayer, distSq:int, dist:int, x:int
  y:int, radius:int

pub class SpatialHashGrid:
  _cellSize:int, _invCellSize:int, _cols:int, _rows:int, _maxCells:int
  _gridHead: Int32Array
  _capacities: Int32Array
  _gridNext: [Int32Array]
  _posX: [Float64Array]
  _posY: [Float64Array]
  _radius: [Float64Array]
  _itemCount: Int32Array
  _maxRadius: Float64Array
  fn constructor(cellSize:unknown = 48, maxArenaW:unknown = 3200, maxArenaH:unknown = 2400):
    _cellSize = cellSize
    _invCellSize = 1 / cellSize
    _cols = ceil(Math) + 2
    _rows = ceil(Math) + 2
    _maxCells = _cols * _rows
    _gridHead = Int32Array(SPATIAL_LAYER_COUNT * _maxCells)
    _gridHead.fill(-1)
    _capacities = Int32Array([2048, 512, 2048, 512, 1024])
    _itemCount = Int32Array(SPATIAL_LAYER_COUNT)
    _maxRadius = Float64Array(SPATIAL_LAYER_COUNT)
    _gridNext = Array(SPATIAL_LAYER_COUNT)
    _posX = Array(SPATIAL_LAYER_COUNT)
    _posY = Array(SPATIAL_LAYER_COUNT)
    _radius = Array(SPATIAL_LAYER_COUNT)
  fn get_cellSize() = _cellSize
  fn get_cols() = _cols
  fn get_rows() = _rows
  fn get_maxCells() = _maxCells
  fn get_layerCount() = SPATIAL_LAYER_COUNT
  fn getCapacity(layer:SpatialLayer) -> int = _capacities[layer] ?? 0
  fn getItemCount(layer:SpatialLayer) -> int = _itemCount[layer] ?? 0
  fn getTotalItemCount() -> int:
    total ::= 0
    total
  fn getMaxRadius(layer:SpatialLayer) -> int = _maxRadius[layer] ?? 0
  fn clear() :
    _gridHead.fill(-1)
    _itemCount.fill(0)
    _maxRadius.fill(0)
  fn clearLayer(layer:SpatialLayer) :
    if layer < 0 or layer >= SPATIAL_LAYER_COUNT:
      ret
    offset := layer * _maxCells
    _gridHead.fill(-1, offset, offset + _maxCells)
    _itemCount[layer] = 0
    _maxRadius[layer] = 0
  fn _ensureCapacity(layer:int, minCapacity:int) :
    current := _capacities[layer]
    if minCapacity <= current:
      ret
    nextCap := max(minCapacity * 2, current * 2)
    _capacities[layer] = nextCap
    newNext := Int32Array(nextCap)
    newNext.set(_gridNext[layer])
    newNext.fill(-1, current)
    _gridNext[layer] = newNext
    newPosX := Float64Array(nextCap)
    newPosX.set(_posX[layer])
    _posX[layer] = newPosX
    newPosY := Float64Array(nextCap)
    newPosY.set(_posY[layer])
    _posY[layer] = newPosY
    newRad := Float64Array(nextCap)
    newRad.set(_radius[layer])
    _radius[layer] = newRad
  fn insert(x:int, y:int, id:int) :
    pass
  fn insert(layer:SpatialLayer, x:int, y:int, id:int, radius:int) :
    pass
  fn insert(arg0:int, arg1:int, arg2:int, arg3:int, arg4:int) :
    layer:int ::= undefined
    x:int ::= undefined
    y:int ::= undefined
    id:int ::= undefined
    radius:int ::= undefined
    if arg3 == undefined:
      layer = SpatialLayer.Segments
      x = arg0
      y = arg1
      id = arg2
      radius = 0
    else:
      layer = arg0
      x = arg1
      y = arg2
      id = arg3
      radius = arg4 ?? 0
    if layer < 0 or layer >= SPATIAL_LAYER_COUNT or id < 0 or not Number.isFinite(id):
      ret
    if not Number.isFinite(x) or not Number.isFinite(y):
      ret
    if not Number.isFinite(radius) or radius < 0:
      radius = 0
    if id >= _capacities[layer]:
      this._ensureCapacity(layer, id + 1)
    _posX[layer][id] = x
    _posY[layer][id] = y
    _radius[layer][id] = radius
    if radius > _maxRadius[layer]:
      _maxRadius[layer] = radius
    invCs := _invCellSize
    cols := _cols
    rows := _rows
    cx ::= floor(Math)
    cy ::= floor(Math)
    if cx < 0:
      cx = 0
    elif cx >= cols:
      cx = cols - 1
    if cy < 0:
      cy = 0
    elif cy >= rows:
      cy = rows - 1
    cellIdx := layer * _maxCells + cy * cols + cx
    _gridNext[layer][id] = _gridHead[cellIdx]
    _gridHead[cellIdx] = id
    _itemCount[layer] = _itemCount[layer] + 1
  fn insertSegments(segs:[unknown]) :
    n := segs.length
    this.clearLayer(SpatialLayer.Segments)
    if n == 0:
      ret
    if n > _capacities[SpatialLayer.Segments]:
      this._ensureCapacity(SpatialLayer.Segments, n)
    invCs := _invCellSize
    cols := _cols
    rows := _rows
    layer := SpatialLayer.Segments
    layerOffset := layer * _maxCells
    gridHead := _gridHead
    next := _gridNext[layer]
    posX := _posX[layer]
    posY := _posY[layer]
    rad := _radius[layer]
    maxR ::= 0
    _maxRadius[SpatialLayer.Segments] = maxR
    _itemCount[SpatialLayer.Segments] = n
  fn queryRadius(x:int, y:int, radius:int, callback:(number) => boolean | void) -> bool:
    pass
  fn queryRadius(layerMask:SpatialLayerMaskValue, x:int, y:int, radius:int, callback:(number, SpatialLayer, number) => boolean | void) -> bool:
    pass
  fn queryRadius(arg0:int, arg1:int, arg2:int, arg3:int | (number) => boolean | void, arg4:(number, SpatialLayer, number) => boolean | void) -> bool:
    layerMask:int ::= undefined
    x:int ::= undefined
    y:int ::= undefined
    radius:int ::= undefined
    callback:(number, SpatialLayer, number) => boolean | void ::= undefined
    if typeof(arg3) == "function":
      layerMask = SpatialLayerMask.Segments
      x = arg0
      y = arg1
      radius = arg2
      callback = arg3
    else:
      layerMask = arg0
      x = arg1
      y = arg2
      radius = arg3
      callback = arg4
    if layerMask == 0:
      ret false
    if not Number.isFinite(x) or not Number.isFinite(y) or not Number.isFinite(radius) or radius < 0:
      ret false
    invCs := _invCellSize
    cols := _cols
    rows := _rows
    maxCells := _maxCells
    gridHead := _gridHead
    false
  fn findFirst(layerMask:SpatialLayerMaskValue, x:int, y:int, radius:int) -> int:
    pass
  fn findFirst(x:int, y:int, radius:int) -> int:
    pass
  fn findFirst(arg0:int, arg1:int, arg2:int, arg3:int) -> int:
    layerMask:int ::= undefined
    x:int ::= undefined
    y:int ::= undefined
    radius:int ::= undefined
    if arg3 == undefined:
      layerMask = SpatialLayerMask.Segments
      x = arg0
      y = arg1
      radius = arg2
    else:
      layerMask = arg0
      x = arg1
      y = arg2
      radius = arg3
    if layerMask == 0:
      ret -1
    if not Number.isFinite(x) or not Number.isFinite(y) or not Number.isFinite(radius) or radius < 0:
      ret -1
    invCs := _invCellSize
    cols := _cols
    rows := _rows
    maxCells := _maxCells
    gridHead := _gridHead
    -1
  fn findFirstSegment(x:int, y:int, radius:int, minIndex:unknown = 0) -> int:
    if not Number.isFinite(x) or not Number.isFinite(y) or not Number.isFinite(radius) or radius < 0:
      ret -1
    invCs := _invCellSize
    cols := _cols
    rows := _rows
    maxCells := _maxCells
    gridHead := _gridHead
    l := SpatialLayer.Segments
    layerMaxRad := _maxRadius[l]
    searchR := radius + layerMaxRad
    minCx ::= floor(Math)
    if minCx < 0:
      minCx = 0
    maxCx ::= floor(Math)
    if maxCx >= cols:
      maxCx = cols - 1
    minCy ::= floor(Math)
    if minCy < 0:
      minCy = 0
    maxCy ::= floor(Math)
    if maxCy >= rows:
      maxCy = rows - 1
    if minCx > maxCx or minCy > maxCy:
      ret -1
    layerOffset := l * maxCells
    next := _gridNext[l]
    posX := _posX[l]
    posY := _posY[l]
    rad := _radius[l]
    maxLayerRSq := searchR * searchR
    -1
  fn queryRadiusBuffer(layerMask:SpatialLayerMaskValue, x:int, y:int, radius:int, outBuffer:Int32Array, maxHits:int = outBuffer.length) -> int:
    if layerMask == 0 or maxHits <= 0:
      ret 0
    if not Number.isFinite(x) or not Number.isFinite(y) or not Number.isFinite(radius) or radius < 0:
      ret 0
    hitCount ::= 0
    invCs := _invCellSize
    cols := _cols
    rows := _rows
    maxCells := _maxCells
    gridHead := _gridHead
    hitCount
  fn queryNearest(layerMask:SpatialLayerMaskValue, x:int, y:int, maxRadius:int) -> Option[SpatialQueryResult]:
    pass
  fn queryNearest(layerMask:SpatialLayerMaskValue, x:int, y:int, maxRadius:int, outResult:SpatialQueryResult) -> bool:
    pass
  fn queryNearest(layerMask:SpatialLayerMaskValue, x:int, y:int, maxRadius:unknown = Infinity, outResult:SpatialQueryResult) -> unknown | bool:
    if layerMask == 0 or not Number.isFinite(x) or not Number.isFinite(y) or not Number.isFinite(maxRadius) or maxRadius <= 0:
      if outResult != nil:
        ret false
      else:
        ret nil
    cs := _cellSize
    invCs := _invCellSize
    cols := _cols
    rows := _rows
    maxCells := _maxCells
    gridHead := _gridHead
    bestDistSq ::= maxRadius * maxRadius
    bestDist ::= maxRadius
    bestId ::= -1
    bestLayer ::= SpatialLayer.Segments
    bestX ::= 0
    bestY ::= 0
    bestRadius ::= 0
    centerCx := floor(Math)
    centerCy := floor(Math)
    if centerCx >= 0 and centerCx < cols and centerCy >= 0 and centerCy < rows:
      nil
    minCx ::= floor(Math)
    if minCx < 0:
      minCx = 0
    maxCx ::= floor(Math)
    if maxCx >= cols:
      maxCx = cols - 1
    minCy ::= floor(Math)
    if minCy < 0:
      minCy = 0
    maxCy ::= floor(Math)
    if maxCy >= rows:
      maxCy = rows - 1
    if minCx > maxCx or minCy > maxCy:
      if bestId == -1:
        if outResult != nil:
          ret false
        else:
          ret nil
    else:
      nil
    if bestId == -1:
      if outResult != nil:
        ret false
      else:
        ret nil
    if outResult != nil:
      outResult.id = bestId
      outResult.layer = bestLayer
      outResult.distSq = bestDistSq
      outResult.dist = bestDist
      outResult.x = bestX
      outResult.y = bestY
      outResult.radius = bestRadius
      ret true
    { id: bestId, layer: bestLayer, distSq: bestDistSq, dist: bestDist, x: bestX, y: bestY, radius: bestRadius }
  fn queryRay(layerMask:SpatialLayerMaskValue, startX:int, startY:int, dirX:int, dirY:int, maxDistance:int, callback:(number, SpatialLayer, number, number, number) => boolean | void) -> bool:
    if layerMask == 0 or not Number.isFinite(maxDistance) or maxDistance <= 0:
      ret false
    if not Number.isFinite(startX) or not Number.isFinite(startY) or not Number.isFinite(dirX) or not Number.isFinite(dirY):
      ret false
    len := hypot(dirX, dirY)
    if not Number.isFinite(len) or len <= 0.000001:
      ret false
    dx := dirX / len
    dy := dirY / len
    cs := _cellSize
    invCs := _invCellSize
    cols := _cols
    rows := _rows
    maxCells := _maxCells
    gridHead := _gridHead
    gridW := cols * cs
    gridH := rows * cs
    if startX < 0 and dx <= 0 or startX >= gridW and dx >= 0:
      ret false
    if startY < 0 and dy <= 0 or startY >= gridH and dy >= 0:
      ret false
    cx ::= floor(Math)
    cy ::= floor(Math)
    stepX := dx > 0 and 1 or dx < 0 and -1 or 0
    stepY := dy > 0 and 1 or dy < 0 and -1 or 0
    tMaxX ::= dx > 0 and cx + 1 * cs - startX / dx or dx < 0 and cx * cs - startX / dx or Infinity
    tMaxY ::= dy > 0 and cy + 1 * cs - startY / dy or dy < 0 and cy * cs - startY / dy or Infinity
    tDeltaX := dx != 0 and abs(cs / dx) or Infinity
    tDeltaY := dy != 0 and abs(cs / dy) or Infinity
    tCurrent ::= 0
    while tCurrent <= maxDistance:
      if cx >= 0 and cx < cols and cy >= 0 and cy < rows:
        nil
      if tMaxX < tMaxY:
        tCurrent = tMaxX
        tMaxX += tDeltaX
        cx += stepX
      else:
        tCurrent = tMaxY
        tMaxY += tDeltaY
        cy += stepY
      if stepX > 0 and cx >= cols or stepX < 0 and cx < 0:
        nil
      if stepY > 0 and cy >= rows or stepY < 0 and cy < 0:
        nil
    false

pub const SegmentSpatialGrid = SpatialHashGrid

type SegmentSpatialGrid = SpatialHashGrid
