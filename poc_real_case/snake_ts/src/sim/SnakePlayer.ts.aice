module poc_real_case/snake_ts/src/sim/SnakePlayer

from "../core/MathX.js" import MathX
from "../core/Rng.js" import Rng
from "../core/Services.js" import Services, IServiceContainer
from "../core/Contracts.js" import IDamageable
from "../data/GameData.js" import GameData
from "../data/MetaProgression.js" import MetaProgression
from "../data/Types.js" import SnakeClassDef, HelmetDef
from "./PlayerStats.js" import PlayerStats
from "./Hazard.js" import Hazard
from "./Projectile.js" import Projectile
from "./FoodItem.js" import FoodItem
from "./Enemy.js" import Enemy
from "./Boss.js" import Boss
from "./CombatSystem.js" import CombatSystem
from "./World.js" import World

type ISteerInput:
  X:Option[int], Y:Option[int], x:Option[int], y:Option[int], Active:Option[bool]
  active:Option[bool]

type IHelmetLike:
  id:Option[str], Id:Option[str], name:Option[str], Name:Option[str], icon:Option[str]
  Icon:Option[str], rarity:Option[str], Rarity:Option[str]
  stats:Option[Record[str, unknown]]
  Stats:Option[Record[str, unknown]]
  tier:Option[int], Tier:Option[int], bossId:Option[str], BossId:Option[str], perks:Option[[str]]
  Perks:Option[[str]], lore:Option[str], Lore:Option[str], activeCapacity:Option[str], ActiveCapacity:Option[str]
  specialCapacity:Option[str], SpecialCapacity:Option[str], isOmni:Option[bool], IsOmni:Option[bool]

type HelmetLike = HelmetDef | IHelmetLike

pub class SnakeSegment:
  prop X, x: int
  prop Y, y: int
  prop Angle, angle: int
  prop R, r: int
  prop Hp, hp: int
  prop MaxHp, maxHp: int
  prop HitFlash, hitFlash: int = 0
  prop SelfHitCooldown, selfHitCooldown: int = 0
  prop BossHitCooldown, bossHitCooldown: int = 0
  fn constructor(x:int, y:int, angle:int, r:int, maxHp:unknown = 25):
    X = x
    Y = y
    Angle = angle
    R = r
    MaxHp = maxHp
    Hp = maxHp

type BiteHead:
  X:int, Y:int, R:int, Mult:int, x:Option[int]
  y:Option[int], r:Option[int], mult:Option[int]

type Orbital:
  X:int, Y:int, A:int, x:Option[int], y:Option[int]
  a:Option[int]

pub class Afterimage:
  prop X, x: int
  prop Y, y: int
  prop Angle, angle: int
  prop Life, life: int
  prop Max, max: int
  fn constructor(x:unknown = 0, y:unknown = 0, angle:unknown = 0, life:unknown = 0, max:unknown = 0):
    X = x
    Y = y
    Angle = angle
    Life = life
    Max = max

pub class SnakePlayer:
  prop ClassConfig, classConfig: SnakeClassDef
  prop ClassId, classId: str
  prop Stats, stats: PlayerStats
  prop Shield, shield: int
  prop Xp, xp: int
  prop TotalXpCollected, totalXpCollected = 0
  prop Level, level = 1
  prop XpToNext, xpToNext = 100
  prop PendingLevelUps, pendingLevelUps = 0
  prop Alive, alive = true
  HeadRadius = 14
  prop HeadRadiusMultiplier, headRadiusMultiplier = 1
  prop TitanGorgingTimer, titanGorgingTimer = 0
  prop SegmentRadius, segmentRadius = 11
  prop SegmentSpacing, segmentSpacing = 15
  prop BaseSpeed, baseSpeed = 195
  prop TurnSpeed, turnSpeed = 9.5
  prop X, x: int
  prop Y, y: int
  prop Angle, angle: int
  prop TargetAngle, targetAngle: int
  prop VelocityX, velocityX: int
  prop VelocityY, velocityY: int
  prop MaxSegments, maxSegments = 12000
  prop Segments, segments: [SnakeSegment] = []
  HeadHp = 50, HeadMaxHp = 50, _cachedHp = -1, _hpDirty = true, _cachedMaxHp = -1
  _maxHpDirty = true, _cachedSegCount = -1
  prop DashDuration, dashDuration = 0.32
  prop DashTimer, dashTimer, dashDurationTimer = 0
  prop DashCooldownTimer, dashCooldownTimer = 0
  prop IsDashing, isDashing = false
  prop DashSpeedMultiplier, dashSpeedMultiplier = 2.5
  prop InvulnerableTimer, invulnerableTimer = 0
  prop DashHitIds, dashHitIds: Set[int] = Set()
  prop SkillCooldownTimer, skillCooldownTimer = 0
  prop SkillActiveTimer, skillActiveTimer = 0
  prop ArmorBuffTimer, armorBuffTimer = 0
  prop Relics, relics: Record[str, int]
  prop CardStacks, cardStacks: Record[str, int] = {  }
  prop OrbitalAngle, orbitalAngle = 0
  prop OrbitDistance, orbitDistance = 54
  prop SpitCooldown, spitCooldown = 0
  prop VortexTimer, vortexTimer = 0
  prop RegenTimer, regenTimer = 0
  prop ShieldRechargeTimer, shieldRechargeTimer = 0
  prop ShieldBrokenTimer, shieldBrokenTimer = 0
  prop TrailTimer, trailTimer = 0
  prop MagmaTimer, magmaTimer = 0
  prop GluttonCounter, gluttonCounter = 0
  prop DevourerCounter, devourerCounter = 0
  prop DevourerStacks, devourerStacks = 0
  prop DamageBonus, damageBonus = 1
  prop EyeBlinkTimer, eyeBlinkTimer: int
  prop EyeBlinking, eyeBlinking = false
  prop MouthOpen, mouthOpen = 0
  prop BodyPulse, bodyPulse = 0
  prop HurtFlash, hurtFlash = 0
  prop Afterimages, afterimages: [Afterimage] = []
  prop EmberTimer, emberTimer = 0
  prop FoodsEaten, foodsEaten = 0
  prop PendingRevive, pendingRevive = false
  prop MutationPoints, mutationPoints = 1
  prop HeadAugment, headAugment: Option[str] = nil
  prop HeadAugmentLevel, headAugmentLevel = 0
  prop HeadLaserTimer, headLaserTimer = 0
  prop HeadCrownTimer, headCrownTimer = 0
  prop AgilitySurgeTimer, agilitySurgeTimer = 0
  prop HeadSelfHitCooldown, headSelfHitCooldown = 0
  prop PeakLength, peakLength = 0
  prop HeadModules, headModules: Record[str, int] = {  }
  prop HeadModuleTimers, headModuleTimers: Record[str, int] = {  }
  prop HeadPurchaseCount, headPurchaseCount = 0
  prop EquippedHelmet, equippedHelmet, helmet: Option[HelmetLike] = nil
  prop meta, Meta: Option[MetaProgression]
  prop services, Services: Option[IServiceContainer]
  readonly _biteHeads: [BiteHead] = []
  readonly _orbitalPositions: [Orbital] = []
  _head0: BiteHead = { X: 0, Y: 0, R: 14, Mult: 1, x: 0, y: 0, r: 14, mult: 1 }
  _head1: BiteHead = { X: 0, Y: 0, R: 9, Mult: 0.55, x: 0, y: 0, r: 9, mult: 0.55 }
  _head2: BiteHead = { X: 0, Y: 0, R: 9, Mult: 0.55, x: 0, y: 0, r: 9, mult: 0.55 }
  _xpForNextLevel = 155
  static fn isOffenseModule(type:Option[str]) -> bool:
    if not type:
      ret false
    def := GameData.SocketModules.Get(type)
    if def != nil:
      ret def.Category == "offense"
    type == "turret" or type == "tesla" or type == "magma" or type == "venom" or type == "laser" or type == "tachyon" or type == "cryo" or type == "plasma" or type == "flak" or type == "scattershot" or type == "needler" or type == "mortar" or type == "sonic" or type == "gatling" or type == "caltrop" or type == "singularity" or type == "solar"
  static fn IsOffenseModule(type:Option[str]) -> bool = SnakePlayer.isOffenseModule(type)
  static fn isDefenseModule(type:Option[str]) -> bool:
    if not type:
      ret false
    def := GameData.SocketModules.Get(type)
    if def != nil:
      ret def.Category == "defense"
    type == "shield" or type == "spikes" or type == "regen" or type == "magnet" or type == "chrono" or type == "nanite" or type == "reactive" or type == "magnetic_aegis" or type == "cryo_carapace" or type == "heatsink" or type == "cloak" or type == "emp_coil"
  static fn IsDefenseModule(type:Option[str]) -> bool = SnakePlayer.isDefenseModule(type)
  fn RecalculateHp() :
    sum ::= HeadHp
    len := Segments.length
    _cachedHp = sum
    _hpDirty = false
    _cachedSegCount = len
  fn recalculateHp() :
    this.RecalculateHp()
  fn RecalculateMaxHp() :
    sum ::= HeadMaxHp
    len := Segments.length
    _cachedMaxHp = sum
    _maxHpDirty = false
    _cachedSegCount = len
  fn recalculateMaxHp() :
    this.RecalculateMaxHp()
  get headHp = HeadHp
  set headHp(v:int):
    HeadHp = v
    _hpDirty = true
  get headMaxHp = HeadMaxHp
  set headMaxHp(v:int):
    HeadMaxHp = v
    _maxHpDirty = true
  get Hp() -> int:
    if _hpDirty or _cachedHp < 0 or _cachedSegCount != Segments.length:
      this.RecalculateHp()
    _cachedHp
  set Hp(v:int):
    remaining ::= Number.isFinite(v) and max(0, v) or 0
    if remaining > this.MaxHp:
      this.MaxHp = remaining
    HeadHp = min(HeadMaxHp, remaining)
    remaining -= HeadHp
    this.RecalculateHp()
  get MaxHp() -> int:
    if _maxHpDirty or _cachedMaxHp < 0 or _cachedSegCount != Segments.length:
      this.RecalculateMaxHp()
    _cachedMaxHp
  set MaxHp(v:int):
    if not Number.isFinite(v) or v <= 0:
      ret
    Stats.MaxHp = v
    if Segments.length > 0:
      totalUnits := 2 + Segments.length
      unitHp := max(10, round(Math))
      HeadMaxHp = unitHp * 2
      HeadHp = min(HeadHp, HeadMaxHp)
    else:
      HeadMaxHp = v
      HeadHp = min(HeadHp, HeadMaxHp)
    this.RecalculateMaxHp()
    this.RecalculateHp()
  get hp = this.Hp; set hp(v) = this.Hp = v
  get maxHp = this.MaxHp; set maxHp(v) = this.MaxHp = v
  get ouro = Xp; set ouro(v) = Xp = v
  get Ouro = Xp; set Ouro(v) = Xp = v
  get totalOuroCollected = TotalXpCollected; set totalOuroCollected(v) = TotalXpCollected = v
  get TotalOuroCollected = TotalXpCollected; set TotalOuroCollected(v) = TotalXpCollected = v
  get Length = Segments.length + 1
  get length = this.Length
  get TotalLength = Segments.length + 1
  get totalLength = this.TotalLength
  get headRadius = HeadRadius * HeadRadiusMultiplier; set headRadius(v) = HeadRadius = v
  get EffectiveTurnSpeed = AgilitySurgeTimer > 0 and TurnSpeed * 1.45 or TurnSpeed
  get effectiveTurnSpeed = this.EffectiveTurnSpeed
  fn EquipHelmet(v:Option[HelmetLike]) -> void = EquippedHelmet = v ?? nil
  fn equipHelmet(v:Option[HelmetLike]) :
    this.EquipHelmet(v)
  fn triggerTitanGorging(duration:int = 3) :
    HeadRadiusMultiplier = 2
    TitanGorgingTimer = duration
  fn TriggerTitanGorging(duration:int = 3) :
    this.triggerTitanGorging(duration)
  fn GetHeadModuleLevel(key:str) -> int = HeadModules[key] or 0
  fn getHeadModuleLevel(key:str) -> int = this.GetHeadModuleLevel(key)
  fn SetHeadModuleLevel(key:str, level:int) -> void = HeadModules[key] = max(0, level)
  fn setHeadModuleLevel(key:str, level:int) :
    this.SetHeadModuleLevel(key, level)
  fn GetHeadAugmentLevel(key:str) -> int = HeadAugment == key and HeadAugmentLevel or 0 or 0
  fn getHeadAugmentLevel(key:str) -> int = this.GetHeadAugmentLevel(key)
  fn GetHeadModuleCost(key:str, targetLvl:int) -> int:
    lvl := targetLvl != undefined and targetLvl or this.GetHeadModuleLevel(key) + 1
    30 * lvl + HeadPurchaseCount * 15
  fn getHeadModuleCost(key:str, targetLvl:int) -> int = this.GetHeadModuleCost(key, targetLvl)
  fn GetHeadAugmentCost(key:str, targetLvl:int) -> int:
    cur := HeadAugment == key and HeadAugmentLevel or 0
    lvl := targetLvl != undefined and targetLvl or cur + 1
    40 * lvl + HeadPurchaseCount * 20
  fn getHeadAugmentCost(key:str, targetLvl:int) -> int = this.GetHeadAugmentCost(key, targetLvl)
  fn InstallHeadModule(key:str) -> int:
    cur := this.GetHeadModuleLevel(key)
    if cur >= 3:
      ret cur
    next := cur + 1
    HeadModules[key] = next
    HeadPurchaseCount += 1
    if key == "shield":
      shieldBonus := 25
      Stats.MaxShield = Stats.MaxShield + shieldBonus
      Shield = min(Stats.MaxShield, Shield + shieldBonus)
    elif key == "spikes":
      Stats.Thorns = Stats.Thorns + 0.2
    next
  fn installHeadModule(key:str) -> int = this.InstallHeadModule(key)
  fn UninstallHeadModule(key:str) :
    nil
  fn uninstallHeadModule(key:str) :
    this.UninstallHeadModule(key)
  fn InstallHeadAugment(key:str) -> int:
    cur := HeadAugment == key and HeadAugmentLevel or 0
    if cur >= 3:
      ret cur
    next := cur + 1
    this.SetHeadAugment(key, next)
    HeadPurchaseCount += 1
    next
  fn installHeadAugment(key:str) -> int = this.InstallHeadAugment(key)
  fn constructor(classId:Option[str] = "emerald", arenaW:unknown = 0, arenaH:unknown = 0, initialSegments:unknown = 2, metaOrOptions:MetaProgression | unknown):
    if metaOrOptions == MetaProgression:
      meta = metaOrOptions
    elif metaOrOptions != nil and typeof(metaOrOptions) == "object":
      meta = metaOrOptions.meta
      services = metaOrOptions.services
    cfg := classId != nil and GameData.Classes.Get(classId) or nil ?? GameData.Classes.Get("emerald")
    ClassConfig = cfg
    ClassId = ClassConfig.Id
    if arenaW > 0:
      X = arenaW * 0.5
    else:
      X = 480
    if arenaH > 0:
      Y = arenaH * 0.5
    else:
      Y = 320
    Angle = 0
    TargetAngle = 0
    VelocityX = BaseSpeed
    VelocityY = 0
    meta := meta ?? services?.meta ?? typeof(Services) != "undefined" and Services.Meta and Services.Meta or MetaProgression.Instance
    b := ClassConfig.BaseStats
    Stats = PlayerStats()
    Stats.MaxHp = b.MaxHp + meta and meta.Level("vitality") * 10 or 0
    Stats.Speed = b.Speed * 1 + meta and meta.Level("agility") * 0.04 or 0
    Stats.DashCooldown = max(0.8, b.DashCooldown - meta and meta.Level("swiftness") * 0.15 or 0)
    Stats.BitePower = b.BitePower * 1 + meta and meta.Level("ferocity") * 0.06 or 0
    Stats.MagnetRadius = b.MagnetRadius * 1 + meta and meta.Level("magnet") * 0.15 or 0
    Stats.CritChance = b.CritChance
    Stats.CritMult = b.CritMult
    Stats.Armor = min(0.8, b.Armor + meta and meta.Level("resilience") * 0.03 or 0)
    Stats.MaxShield = 0
    Stats.XpGain = 1
    Stats.ShardGain = 1
    Stats.ComboWindow = 1
    Stats.Thorns = 0
    Stats.SkillCooldown = ClassConfig.Skill.Cooldown
    if ClassId == "emerald":
      Stats.MagnetRadius = Stats.MagnetRadius * 1.3
    segCount := initialSegments != undefined and initialSegments >= 0 and initialSegments or 2
    baseSegHp := this.BaseSegmentHp
    HeadMaxHp = 2 * baseSegHp
    HeadHp = HeadMaxHp
    PeakLength = Segments.length
    this.RecalculateMaxHp()
    this.RecalculateHp()
    Stats.MaxHp = this.MaxHp
    equippedHelmet := meta != nil and meta.GetEquippedHelmet and meta.GetEquippedHelmet() or nil
    EquippedHelmet = equippedHelmet
    if EquippedHelmet != nil and EquippedHelmet.Stats or EquippedHelmet.stats:
      hs := EquippedHelmet.Stats or EquippedHelmet.stats
      hHp := hs.MaxHp or hs.maxHp or 0
      if hHp > 0:
        Stats.MaxHp = Stats.MaxHp + hHp
        extraPerPart := round(Math)
        HeadMaxHp += 2 * extraPerPart
        HeadHp = HeadMaxHp
        for seg in Segments:
          seg.MaxHp = seg.MaxHp + extraPerPart
          seg.Hp = seg.MaxHp
        this.RecalculateMaxHp()
        this.RecalculateHp()
      if hs.Armor or hs.armor:
        Stats.Armor = min(0.85, Stats.Armor + hs.Armor or hs.armor or 0)
      if hs.Speed or hs.speed:
        Stats.Speed = Stats.Speed + hs.Speed or hs.speed or 0
      if hs.BitePower or hs.bitePower:
        Stats.BitePower = Stats.BitePower + hs.BitePower or hs.bitePower or 0
      if hs.MagnetRadius or hs.magnetRadius:
        Stats.MagnetRadius = Stats.MagnetRadius + hs.MagnetRadius or hs.magnetRadius or 0
      if hs.CritChance or hs.critChance:
        Stats.CritChance = min(1, Stats.CritChance + hs.CritChance or hs.critChance or 0)
      if hs.CritMult or hs.critMult:
        Stats.CritMult = Stats.CritMult + hs.CritMult or hs.critMult or 0
      if hs.DashCooldown or hs.dashCooldown:
        Stats.DashCooldown = max(0.6, Stats.DashCooldown - hs.DashCooldown or hs.dashCooldown or 0)
      if hs.Thorns or hs.thorns:
        Stats.Thorns = Stats.Thorns + hs.Thorns or hs.thorns or 0
      if hs.XpMultiplier or hs.xpMultiplier:
        Stats.XpGain = Stats.XpGain + hs.XpMultiplier or hs.xpMultiplier or 0
      if hs.ShardMultiplier or hs.shardMultiplier:
        Stats.ShardGain = Stats.ShardGain + hs.ShardMultiplier or hs.shardMultiplier or 0
      if hs.HpRegen or hs.hpRegen:
        Stats.HpRegen = Stats.HpRegen + hs.HpRegen or hs.hpRegen or 0
      if hs.Shield or hs.shield:
        sVal := hs.Shield or hs.shield or 0
        Shield = Shield or 0 + sVal
        Stats.MaxShield = Stats.MaxShield or 0 + sVal
    Shield = Shield or 0
    Xp = 0
    Level = 1
    XpToNext = 155
    _xpForNextLevel = 155
    PendingLevelUps = 0
    Alive = true
    Relics = GameData.newRelics()
    EyeBlinkTimer = Rng.Shared.range(2, 5)
  get BitePower() -> int:
    p ::= Stats.BitePower * DamageBonus
    adrenal := Relics["adrenal"] ?? 0
    if adrenal > 0 and this.Hp < Stats.MaxHp * 0.4:
      p *= 1 + 0.2 * adrenal
    p
  get bitePower = this.BitePower
  get MoveSpeed() -> int:
    s ::= BaseSpeed * Stats.Speed
    adrenal := Relics["adrenal"] ?? 0
    if adrenal > 0 and this.Hp < Stats.MaxHp * 0.4:
      s *= 1 + 0.35 * adrenal
    if IsDashing != nil:
      s *= DashSpeedMultiplier
    s
  get moveSpeed = this.MoveSpeed
  get EffectiveArmor() -> int:
    a ::= Stats.Armor + this.SegmentArmorBonus
    if ArmorBuffTimer > 0:
      a += 0.25
    if HeadModules["spikes"]:
      a += 0.04 * HeadModules["spikes"]
    MathX.clamp(a, 0, 0.85)
  get effectiveArmor = this.EffectiveArmor
  get SkillReady = SkillCooldownTimer <= 0
  get skillReady = this.SkillReady
  get DashReady = DashCooldownTimer <= 0 and not IsDashing
  get dashReady = this.DashReady
  fn BiteHeads() -> [BiteHead]:
    _biteHeads.length = 0
    currentR := this.headRadius
    _head0.X = X
    _head0.Y = Y
    _head0.R = currentR
    _head0.x = X
    _head0.y = Y
    _head0.r = currentR
    _head0.Mult = 1
    _head0.mult = 1
    _biteHeads.push(_head0)
    if ClassId == "hydra":
      nx := cos(Angle + Math.PI / 2)
      ny := sin(Angle + Math.PI / 2)
      back := 6
      bx := X - cos(Angle) * back
      by := Y - sin(Angle) * back
      h1x := bx + nx * 15
      h1y := by + ny * 15
      _head1.X = h1x
      _head1.Y = h1y
      _head1.x = h1x
      _head1.y = h1y
      _biteHeads.push(_head1)
      h2x := bx - nx * 15
      h2y := by - ny * 15
      _head2.X = h2x
      _head2.Y = h2y
      _head2.x = h2x
      _head2.y = h2y
      _biteHeads.push(_head2)
    _biteHeads
  fn biteHeads() -> [BiteHead] = this.BiteHeads()
  fn OrbitalPositions() -> [Orbital]:
    n := Relics["orbitalFangs"] ?? 0
    while _orbitalPositions.length < n:
      _orbitalPositions.push({ X: 0, Y: 0, A: 0, x: 0, y: 0, a: 0 })
    _orbitalPositions.length = n
    _orbitalPositions
  fn orbitalPositions() -> [Orbital] = this.OrbitalPositions()
  fn Update(dt:int, steer:ISteerInput, arenaW:int, arenaH:int, world:World) :
    if not Number.isFinite(dt) or dt <= 0:
      ret
    if not Number.isFinite(X):
      if arenaW > 0:
        X = arenaW * 0.5
      else:
        X = 480
    if not Number.isFinite(Y):
      if arenaH > 0:
        Y = arenaH * 0.5
      else:
        Y = 320
    if not Number.isFinite(Angle):
      Angle = 0
    if not Number.isFinite(TargetAngle):
      TargetAngle = Angle
    DashCooldownTimer = MathX.decayTimer(DashCooldownTimer, dt)
    SkillCooldownTimer = MathX.decayTimer(SkillCooldownTimer, dt)
    InvulnerableTimer = MathX.decayTimer(InvulnerableTimer, dt)
    ArmorBuffTimer = MathX.decayTimer(ArmorBuffTimer, dt)
    AgilitySurgeTimer = MathX.decayTimer(AgilitySurgeTimer, dt)
    HeadSelfHitCooldown = MathX.decayTimer(HeadSelfHitCooldown, dt)
    HurtFlash = MathX.decayTimer(HurtFlash, dt * 3)
    if TitanGorgingTimer > 0:
      TitanGorgingTimer = MathX.decayTimer(TitanGorgingTimer, dt)
      if TitanGorgingTimer <= 0:
        HeadRadiusMultiplier = 1
    if IsDashing != nil:
      DashTimer -= dt
      if DashTimer <= 0:
        IsDashing = false
        DashHitIds.clear()
    steerActive := steer != nil and steer.Active ?? steer.active ?? false or false
    steerX := steer != nil and steer.X ?? steer.x ?? 0 or 0
    steerY := steer != nil and steer.Y ?? steer.y ?? 0 or 0
    if steerActive != nil:
      len := sqrt(steerX * steerX + steerY * steerY)
      if len > 0.001 and Number.isFinite(len):
        TargetAngle = atan2(steerY, steerX)
    turn := this.EffectiveTurnSpeed * IsDashing and 0.65 or 1
    diff := MathX.angleDelta(Angle, TargetAngle)
    Angle += diff * MathX.clamp(turn * dt, 0, 1)
    if Angle > Math.PI:
      Angle -= MathX.Tau
    if Angle < -Math.PI:
      Angle += MathX.Tau
    speed := this.MoveSpeed
    VelocityX = cos(Angle) * speed
    VelocityY = sin(Angle) * speed
    X += VelocityX * dt
    Y += VelocityY * dt
    m := HeadRadius
    hitLeft := X < m
    hitRight := X > arenaW - m
    hitTop := Y < m
    hitBottom := Y > arenaH - m
    if hitLeft or hitRight != nil and hitTop or hitBottom:
      nx := hitLeft != nil and 1 or -1
      ny := hitTop != nil and 1 or -1
      if hitLeft != nil:
        X = m + 1
      else:
        X = arenaW - m - 1
      if hitTop != nil:
        Y = m + 1
      else:
        Y = arenaH - m - 1
      this.Deflect(nx * Math.SQRT1_2, ny * Math.SQRT1_2)
    else:
      if hitLeft != nil:
        X = m
        this.Deflect(1, 0)
      elif hitRight != nil:
        X = arenaW - m
        this.Deflect(-1, 0)
      if hitTop != nil:
        Y = m
        this.Deflect(0, 1)
      elif hitBottom != nil:
        Y = arenaH - m
        this.Deflect(0, -1)
    this.UpdateSegments(dt)
    if world != nil:
      this.UpdatePassives(dt, world)
      this.UpdateCosmetics(dt, world)
  fn update(dt:int, steer:ISteerInput, arenaW:int, arenaH:int, world:World) :
    this.Update(dt, steer, arenaW, arenaH, world)
  fn Deflect(nx:int, ny:int) :
    if not Number.isFinite(nx) or not Number.isFinite(ny):
      ret
    nLen := hypot(nx, ny)
    if not Number.isFinite(nLen) or nLen < 0.0001:
      ret
    nx /= nLen
    ny /= nLen
    dot := cos(Angle) * nx + sin(Angle) * ny
    if dot >= 0:
      ret
    tx := cos(Angle) - dot * nx
    ty := sin(Angle) - dot * ny
    len := sqrt(tx * tx + ty * ty)
    if len > 0.01:
      Angle = atan2(ty / len, tx / len)
      tdot := cos(TargetAngle) * nx + sin(TargetAngle) * ny
      if tdot < 0:
        TargetAngle = Angle
    else:
      tangentX := -ny
      tangentY := nx
      Angle = atan2(tangentY, tangentX)
      tdot := cos(TargetAngle) * nx + sin(TargetAngle) * ny
      if tdot < 0:
        TargetAngle = Angle
  fn deflect(nx:int, ny:int) :
    this.Deflect(nx, ny)
  fn UpdateSegments(_dt:int) :
    px ::= Number.isFinite(X) and X or 480
    py ::= Number.isFinite(Y) and Y or 320
    spacing := SegmentSpacing
    spacingSq := spacing * spacing
    n := Segments.length
    segRadius := SegmentRadius
    invN := n > 0 and 0.4 / n or 0
  fn updateSegments(dt:int) :
    this.UpdateSegments(dt)
  fn stepIK(dt:int) :
    this.UpdateSegments(dt)
  fn stepIk(dt:int) :
    this.UpdateSegments(dt)
  fn UpdatePassives(dt:int, world:World) :
    if Stats.HpRegen > 0:
      RegenTimer += dt
      if RegenTimer >= 3:
        RegenTimer -= 3
        healAmt := max(1, round(Math))
        if this.Hp < Stats.MaxHp:
          this.Heal(healAmt)
          Services.Fx.AddText(X, Y - 18, "+" + String(healAmt), "#10b981", 12, false)
    elif ClassId == "emerald":
      RegenTimer += dt
      if RegenTimer >= 6:
        RegenTimer -= 6
        if this.Hp < Stats.MaxHp:
          this.Heal(1)
          Services.Fx.AddText(X, Y - 18, "+1", "#10b981", 12, false)
    magmaStacks := ClassId == "solar" and 1 or 0 + Relics["moltenWake"] ?? 0
    hazards := world != nil and world.Hazards or world.hazards or nil
    if magmaStacks > 0 and hazards:
      MagmaTimer += dt
      interval := 0.34 / magmaStacks
      if MagmaTimer >= interval:
        MagmaTimer = 0
        if hazards.length < 90:
          tail := Segments.length > 0 and Segments[min(3, Segments.length - 1)] or nil
          tx := tail != nil and tail.X or X
          ty := tail != nil and tail.Y or Y
          hazards.push(Hazard(tx, ty, "magma", { Radius: 22, Life: 3.2, Dps: 26 * magmaStacks * DamageBonus, Owner: "player" }))
    if Stats.MaxShield > 0:
      if ShieldBrokenTimer > 0:
        ShieldBrokenTimer = max(0, ShieldBrokenTimer - dt)
      if Shield < Stats.MaxShield and ShieldBrokenTimer <= 0:
        ShieldRechargeTimer += dt
        if ShieldRechargeTimer >= 8:
          ShieldRechargeTimer = 0
          Shield = Stats.MaxShield
          Services.Fx.RingShockwave(X, Y, "#3a86ff", 18, 0.035)
          Services.Sound.PlayShield()
    if Relics["orbitalFangs"] ?? 0 > 0:
      OrbitalAngle += dt * 3.4 % MathX.Tau
    if Relics["singularity"] ?? 0 > 0:
      VortexTimer += dt
    if SpitCooldown > 0:
      SpitCooldown -= dt
  fn updatePassives(dt:int, world:World) :
    this.UpdatePassives(dt, world)
  fn UpdateCosmetics(dt:int, world:World) :
    BodyPulse += dt * 2.4 % MathX.Tau
    EyeBlinkTimer -= dt
    if EyeBlinkTimer <= 0:
      EyeBlinking = not EyeBlinking
      if EyeBlinking != nil:
        EyeBlinkTimer = 0.12
      else:
        EyeBlinkTimer = Rng.Shared.range(2, 5)
    nearest:Option[FoodItem] := world != nil and world.NearestFood or world.nearestFood or nil or nil
    if nearest != nil:
      nx := nearest.X ?? nearest.x ?? 0
      ny := nearest.Y ?? nearest.y ?? 0
      d := MathX.safeLen(nx - X, ny - Y)
      if d < 80:
        MouthOpen = MathX.clamp(80 - d / 55, 0, 1)
      else:
        MouthOpen = 0
    else:
      MouthOpen *= max(0, 1 - dt * 6)
    EmberTimer += dt
    emberInterval := IsDashing != nil and 0.016 or 0.07
    while EmberTimer >= emberInterval:
      EmberTimer -= emberInterval
      Services.Fx.TrailEmbers(X + Rng.Shared.range(-5, 5), Y + Rng.Shared.range(-5, 5), ClassConfig.Color, IsDashing != nil and 4 or 2)
    if IsDashing != nil and ClassId == "stalker" and Afterimages.length < 14:
      Afterimages.push(Afterimage(X, Y, Angle, 0.35, 0.35))
  fn updateCosmetics(dt:int, world:World) :
    this.UpdateCosmetics(dt, world)
  fn TryDash() -> bool:
    if not this.DashReady:
      ret false
    IsDashing = true
    DashTimer = DashDuration
    DashCooldownTimer = Stats.DashCooldown
    DashHitIds.clear()
    invulnWindow := ClassId == "stalker" and min(0.4, max(0.05, Stats.DashCooldown * 0.5 - DashDuration)) or 0.12
    InvulnerableTimer = max(InvulnerableTimer, DashDuration + invulnWindow)
    Services.Sound.PlayDash()
    Services.Fx.RingShockwave(X, Y, ClassConfig.Color, 14, 0.05)
    true
  fn tryDash() -> bool = this.TryDash()
  fn TriggerDash() -> bool = this.TryDash()
  fn triggerDash() -> bool = this.TryDash()
  fn TriggerSkill(world:World, combat:CombatSystem) -> bool:
    if not this.SkillReady:
      ret false
    if combat != nil and world and typeof(combat.ActivateSkill) == "function":
      ret combat.ActivateSkill(world)
    if world != nil and world.Game?.Combat:
      ret world.Game.Combat.ActivateSkill(world)
    stats := Stats
    scooldown := stats.SkillCooldown ?? 20
    SkillCooldownTimer = scooldown
    Services.Sound.PlaySkill()
    pcol := ClassConfig?.Color or "#00f0b5"
    Services.Fx.RingShockwave(X, Y, pcol, 24, 0.05)
    true
  fn triggerSkill(world:World, combat:CombatSystem) -> bool = this.TriggerSkill(world, combat)
  get BaseSegmentHp() -> int:
    meta := meta ?? services?.meta ?? typeof(Services) != "undefined" and Services.Meta and Services.Meta or MetaProgression.Instance
    base := ClassConfig != nil and ClassConfig.BaseStats.MaxHp or 100
    max(15, round(Math) + meta and meta.Level("vitality") * 5 or 0)
  get baseSegmentHp = this.BaseSegmentHp
  fn AddGrowth(count:int) :
    lx ::= X
    ly ::= Y
    la ::= Angle
    if Segments.length > 0:
      last := Segments[Segments.length - 1]
      lx = last.X
      ly = last.Y
      la = last.Angle
    segHp := this.BaseSegmentHp
    PeakLength = max(PeakLength, Segments.length)
    this.RecalculateMaxHp()
    this.RecalculateHp()
    Stats.MaxHp = this.MaxHp
  fn addGrowth(count:int) :
    this.AddGrowth(count)
  fn SetHeadAugment(augmentId:str, level:int) :
    HeadAugment = augmentId
    HeadAugmentLevel = max(0, level)
    if augmentId == "fangs" and level > 0:
      Stats.BitePower = ClassConfig.BaseStats.BitePower * 1 + 0.15 * level
  fn setHeadAugment(augmentId:str, level:int) :
    this.SetHeadAugment(augmentId, level)
  fn SetHeadAugmentLevel(augmentId:str, level:int) :
    this.SetHeadAugment(augmentId, level)
  fn setHeadAugmentLevel(augmentId:str, level:int) :
    this.SetHeadAugment(augmentId, level)
  get SegmentArmorBonus = min(0.5, Segments.length * 0.03)
  get segmentArmorBonus = this.SegmentArmorBonus
  fn AddBodySegment() :
    if Segments.length >= MaxSegments:
      ret
    this.AddGrowth(1)
  fn addBodySegment() :
    this.AddBodySegment()
  fn DamageHead(amount:int, applyArmor:unknown = true, setInvulnerable:unknown = true, silent:unknown = false) -> int:
    if not Alive or setInvulnerable != nil and InvulnerableTimer > 0 or not (amount > 0) or not Number.isFinite(amount):
      ret 0
    dealt := applyArmor != nil and max(1, MathX.roundJs(amount * 1 - this.EffectiveArmor)) or amount
    toHp ::= dealt
    if Shield > 0:
      toShield := min(Shield, dealt)
      Shield -= toShield
      toHp = dealt - toShield
      if Shield <= 0:
        ShieldBrokenTimer = 2.5
      ShieldRechargeTimer = 0
    while toHp > 0 and Segments.length > 0:
      lastIdx := Segments.length - 1
      lastSeg := Segments[lastIdx]
      if lastSeg.Hp > toHp:
        lastSeg.Hp = lastSeg.Hp - toHp
        lastSeg.HitFlash = 1
        if not silent:
          Services.Fx.Burst(lastSeg.X, lastSeg.Y, "#ff3366", 6, 2, 2)
        toHp = 0
      else:
        toHp -= lastSeg.Hp
        if not silent:
          Services.Fx.Burst(lastSeg.X, lastSeg.Y, "#ff5400", 10, 4, 3)
          Services.Fx.AddText(lastSeg.X, lastSeg.Y - 20, "⚡ LIFE SOURCED", "#ffb703", 14, true)
        Segments.pop()
        this.RecalculateHp()
        this.RecalculateMaxHp()
        Stats.MaxHp = this.MaxHp
    if toHp > 0:
      HeadHp = max(0, HeadHp - toHp)
    if setInvulnerable != nil:
      InvulnerableTimer = 0.6
    HurtFlash = 1
    if not silent:
      Services.Fx.Burst(X, Y, "#ff3366", 8, 3, 2)
      Services.Fx.AddText(X, Y - 18, "-" + String(floor(Math)), "#ff3366", 16, true)
      Services.Sound.PlayHit()
    if Segments.length == 0 and HeadHp <= 0:
      HeadHp = 0
      charges := Relics["phoenixCharges"] ?? 0
      if charges > 0:
        Relics["phoenixCharges"] = charges - 1
        HeadHp = HeadMaxHp
        if Segments.length == 0:
          this.AddGrowth(2)
        InvulnerableTimer = 3
        PendingRevive = true
        Services.Fx.AddText(X, Y - 46, "🔥 PHOENIX REBIRTH 🔥", "#ffb703", 22, true)
        Services.Sound.PlayRevive()
        this.RecalculateHp()
        ret dealt
      Alive = false
    this.RecalculateHp()
    dealt
  fn damageHead(amount:int, applyArmor:unknown = true, setInvulnerable:unknown = true, silent:unknown = false) -> int = this.DamageHead(amount, applyArmor, setInvulnerable, silent)
  fn DamageSegment(segmentIndex:int, amount:int, applyArmor:unknown = true, setInvulnerable:unknown = true, silent:unknown = false) -> int:
    if not Alive or setInvulnerable != nil and InvulnerableTimer > 0 or not (amount > 0) or not Number.isFinite(amount):
      ret 0
    if typeof(segmentIndex) != "number" or not Number.isInteger(segmentIndex) or segmentIndex < 0 or segmentIndex >= Segments.length:
      ret 0
    seg := Segments[segmentIndex]
    dealt := applyArmor != nil and max(1, MathX.roundJs(amount * 1 - this.EffectiveArmor)) or amount
    toHp ::= dealt
    if toHp > 0 and Shield > 0:
      toShield := min(Shield, toHp)
      Shield -= toShield
      toHp -= toShield
      if Shield <= 0:
        ShieldBrokenTimer = 2.5
      ShieldRechargeTimer = 0
    seg.Hp = seg.Hp - toHp
    seg.HitFlash = 1
    if setInvulnerable != nil:
      InvulnerableTimer = 0.6
    HurtFlash = 1
    if not silent:
      Services.Fx.Burst(seg.X, seg.Y, "#ff3366", 8, 3, 2)
      Services.Fx.AddText(seg.X, seg.Y - 18, "-" + String(floor(Math)), "#ff3366", 16, true)
      Services.Sound.PlayHit()
    if seg.Hp <= 0:
      this.SeverFrom(segmentIndex)
    else:
      this.RecalculateHp()
    dealt
  fn damageSegment(segmentIndex:int, amount:int, applyArmor:unknown = true, setInvulnerable:unknown = true, silent:unknown = false) -> int = this.DamageSegment(segmentIndex, amount, applyArmor, setInvulnerable, silent)
  fn SeverFrom(index:int) :
    if typeof(index) != "number" or not Number.isInteger(index) or index < 0 or index >= Segments.length:
      ret
    severCount := Segments.length - index
    if severCount > 10:
      step := max(1, floor(Math))
      if Segments[index]:
        Services.Fx.AddText(Segments[index].X, Segments[index].Y - 24, "⚡ SEVERED (-" + String(severCount) + ")!", "#ff5400", 16, true)
    else:
      nil
    if Segments[index]:
      Services.Fx.RingShockwave(Segments[index].X, Segments[index].Y, "#ff3366", 22, 0.08)
    Services.Sound.PlayExplosion()
    Segments.splice(index)
    this.RecalculateHp()
    this.RecalculateMaxHp()
    Stats.MaxHp = this.MaxHp
    if Segments.length == 0 and HeadHp <= 0:
      charges := Relics["phoenixCharges"] ?? 0
      if charges > 0:
        Relics["phoenixCharges"] = charges - 1
        HeadHp = HeadMaxHp
        this.AddGrowth(2)
        InvulnerableTimer = 3
        PendingRevive = true
        Services.Fx.AddText(X, Y - 46, "🔥 PHOENIX REBIRTH 🔥", "#ffb703", 22, true)
        Services.Sound.PlayRevive()
        this.RecalculateHp()
        ret
      Alive = false
  fn severFrom(index:int) :
    this.SeverFrom(index)
  fn SwapSegments(i:int, j:int) :
    if typeof(i) != "number" or not Number.isInteger(i) or typeof(j) != "number" or not Number.isInteger(j):
      ret
    if i < 0 or i >= Segments.length or j < 0 or j >= Segments.length or i == j:
      ret
    temp := Segments[i]
    Segments[i] = Segments[j]
    Segments[j] = temp
  fn swapSegments(i:int, j:int) :
    this.SwapSegments(i, j)
  fn ReorderSegment(fromIndex:int, toIndex:int) :
    if typeof(fromIndex) != "number" or not Number.isInteger(fromIndex) or typeof(toIndex) != "number" or not Number.isInteger(toIndex):
      ret
    if fromIndex < 0 or fromIndex >= Segments.length or toIndex < 0 or toIndex >= Segments.length or fromIndex == toIndex:
      ret
    item := Segments.splice(fromIndex, 1)[0]
    Segments.splice(toIndex, 0, item)
  fn reorderSegment(fromIndex:int, toIndex:int) :
    this.ReorderSegment(fromIndex, toIndex)
  static fn GetAddSegmentCost(currentSegmentCount:int) -> int = 35 + max(0, currentSegmentCount - 2) * 15
  static fn getAddSegmentCost(currentSegmentCount:int) -> int = SnakePlayer.GetAddSegmentCost(currentSegmentCount)
  fn Heal(amount:int) -> int:
    if not Alive or not (amount > 0) or not Number.isFinite(amount):
      ret 0
    remaining ::= amount
    totalHealed ::= 0
    headMissing := HeadMaxHp - HeadHp
    if headMissing > 0:
      headAdd := min(headMissing, remaining)
      HeadHp += headAdd
      remaining -= headAdd
      totalHealed += headAdd
    this.RecalculateHp()
    totalHealed
  fn heal(amount:int) -> int = this.Heal(amount)
  static fn CalibratedXpThreshold(level:int) -> int:
    if not Number.isFinite(level) or level <= 1:
      ret 0
    floor(Math)
  static fn calibratedXpThreshold(level:int) -> int = SnakePlayer.CalibratedXpThreshold(level)
  fn GainXp(amount:int) -> bool:
    if not (amount > 0):
      ret false
    earned := amount * (Stats?.XpGain ?? 1)
    Xp += earned
    TotalXpCollected += earned
    levelled ::= false
    guard ::= 0
    while TotalXpCollected >= _xpForNextLevel and guard < 50:
      Level += 1
      _xpForNextLevel = SnakePlayer.CalibratedXpThreshold(Level + 1)
      XpToNext = max(1, _xpForNextLevel - SnakePlayer.CalibratedXpThreshold(Level))
      PendingLevelUps += 1
      levelled = true
    levelled
  fn gainXp(amount:int) -> bool = this.GainXp(amount)
  fn GainOuro(amount:int) -> bool = this.GainXp(amount)
  fn gainOuro(amount:int) -> bool = this.GainXp(amount)
  fn SpendOuro(cost:int) -> bool:
    if not Number.isFinite(cost):
      ret false
    if cost <= 0:
      ret true
    if Xp < cost:
      ret false
    Xp -= cost
    true
  fn spendOuro(cost:int) -> bool = this.SpendOuro(cost)
  fn AddOuro(amount:int) :
    if Number.isFinite(amount) and amount > 0:
      Xp += amount
      TotalXpCollected += amount
  fn addOuro(amount:int) :
    this.AddOuro(amount)
  fn TakeDamage(amount:int, _source:Option[str] = nil) -> int:
    if not Alive or InvulnerableTimer > 0 or not (amount > 0):
      ret 0
    if HeadModules["cloak"] and HeadModules["cloak"] > 0:
      if Math.random() < 0.15 * HeadModules["cloak"]:
        Services.Fx.AddText(X, Y - 24, "💨 EVADED!", "#a855f7", 15, true)
        InvulnerableTimer = 0.8
        ret 0
    if HeadModules["reactive"] and HeadModules["reactive"] > 0:
      Services.Fx.RingShockwave(X, Y, "#f97316", 36, 0.06)
      Services.Sound.PlayExplosion()
    dealt := max(1, MathX.roundJs(amount * 1 - this.EffectiveArmor))
    toShield ::= 0
    toHp ::= dealt
    if Shield > 0:
      toShield = min(Shield, dealt)
      Shield -= toShield
      toHp = dealt - toShield
      if Shield <= 0:
        ShieldBrokenTimer = 2.5
      ShieldRechargeTimer = 0
    while toHp > 0 and Segments.length > 0:
      lastIdx := Segments.length - 1
      lastSeg := Segments[lastIdx]
      if lastSeg.Hp > toHp:
        lastSeg.Hp = lastSeg.Hp - toHp
        lastSeg.HitFlash = 1
        Services.Fx.Burst(lastSeg.X, lastSeg.Y, "#ff3366", 8, 3, 2)
        toHp = 0
      else:
        toHp -= lastSeg.Hp
        Services.Fx.Burst(lastSeg.X, lastSeg.Y, "#ff5400", 10, 4, 3)
        Services.Fx.AddText(lastSeg.X, lastSeg.Y - 20, "⚡ LIFE SOURCED", "#ffb703", 14, true)
        Segments.pop()
        this.RecalculateHp()
        this.RecalculateMaxHp()
        Stats.MaxHp = this.MaxHp
    if toHp > 0:
      HeadHp = max(0, HeadHp - toHp)
    InvulnerableTimer = 0.6
    HurtFlash = 1
    if toShield > 0 and toHp == 0:
      Services.Fx.AddText(X, Y - 22, "-" + String(floor(Math)) + " 🛡️", "#3a86ff", 14, true)
      Services.Sound.PlayShield()
    else:
      Services.Fx.AddText(X, Y - 22, "-" + String(floor(Math)), "#ff3366", 17, true)
      Services.Fx.Shake(9, 12)
      Services.Sound.PlayHit()
    if Segments.length == 0 and HeadHp <= 0:
      charges := Relics["phoenixCharges"] ?? 0
      if charges > 0:
        Relics["phoenixCharges"] = charges - 1
        HeadHp = HeadMaxHp
        this.AddGrowth(2)
        InvulnerableTimer = 3
        PendingRevive = true
        Services.Fx.AddText(X, Y - 46, "🔥 PHOENIX REBIRTH 🔥", "#ffb703", 22, true)
        Services.Sound.PlayRevive()
        ret 0
      Alive = false
    dealt
  fn takeDamage(amount:int, source:Option[str] = nil) -> int = this.TakeDamage(amount, source)
  fn Autotomy(world:World) -> int:
    if not Alive or Segments.length <= 1:
      ret 0
    cutIndex := max(1, floor(Math))
    severedCount := Segments.length - cutIndex
    cutSegment := Segments[cutIndex]
    if cutSegment != nil:
      Services.Fx.RingShockwave(cutSegment.X, cutSegment.Y, "#ff5400", 32, 0.06)
      combat := world != nil and world.combat ?? world.Combat ?? world.game?.combat ?? world.Game?.Combat or nil
      if world != nil and combat and typeof(combat.explodeAt) == "function":
        combat.explodeAt(world, cutSegment.X, cutSegment.Y, 140, 80 * DamageBonus, "#ff5400")
    Services.Sound.PlayExplosion(1.5)
    Services.Fx.Shake(12, 16)
    Segments.splice(cutIndex)
    this.RecalculateHp()
    this.RecalculateMaxHp()
    Stats.MaxHp = this.MaxHp
    InvulnerableTimer = 1.2
    AgilitySurgeTimer = 4
    severedCount
  fn autotomy(world:World) -> int = this.Autotomy(world)
  fn GetSegmentTangentialSpeed(segmentIndex:int) -> int:
    if typeof(segmentIndex) != "number" or not Number.isInteger(segmentIndex) or segmentIndex < 0 or segmentIndex >= Segments.length:
      ret BaseSpeed
    BaseSpeed + this.EffectiveTurnSpeed * segmentIndex * SegmentSpacing
  fn getSegmentTangentialSpeed(segmentIndex:int) -> int = this.GetSegmentTangentialSpeed(segmentIndex)
  fn GetTailWhipDamageMultiplier(segmentIndex:int) -> int:
    v := this.GetSegmentTangentialSpeed(segmentIndex)
    ratio := v / max(1, BaseSpeed)
    1 + 0.85 * pow(ratio, 2)
  fn getTailWhipDamageMultiplier(segmentIndex:int) -> int = this.GetTailWhipDamageMultiplier(segmentIndex)
  fn ResolveTailWhipCollision(segmentIndex:int, enemy:Enemy | IDamageable | unknown | Record | null) -> int:
    if typeof(segmentIndex) != "number" or not Number.isInteger(segmentIndex) or segmentIndex < 0 or segmentIndex >= Segments.length:
      ret 0
    if not enemy or typeof(enemy.takeDamage) != "function":
      ret 0
    mult := this.GetTailWhipDamageMultiplier(segmentIndex)
    rawDmg := round(Math)
    dealt := enemy.takeDamage(rawDmg, this)
    seg := Segments[segmentIndex]
    if seg != nil and "x" == enemy and typeof(enemy.x) == "number" or "X" == enemy and typeof(enemy.X) == "number":
      ex := "X" == enemy and typeof(enemy.X) == "number" and enemy.X or "x" == enemy and typeof(enemy.x) == "number" and enemy.x or 0
      ey := "Y" == enemy and typeof(enemy.Y) == "number" and enemy.Y or "y" == enemy and typeof(enemy.y) == "number" and enemy.y or 0
      dx := ex - seg.X
      dy := ey - seg.Y
      dist := hypot(dx, dy)
      nx := dist > 0.001 and Number.isFinite(dist) and dx / dist or cos(Angle)
      ny := dist > 0.001 and Number.isFinite(dist) and dy / dist or sin(Angle)
      if Number.isFinite(nx) and Number.isFinite(ny):
        if "X" == enemy and typeof(enemy.X) == "number":
          enemy.X = enemy.X + nx * 180
        if "Y" == enemy and typeof(enemy.Y) == "number":
          enemy.Y = enemy.Y + ny * 180
        if "x" == enemy and typeof(enemy.x) == "number":
          enemy.x = enemy.X ?? enemy.x + nx * 180
        if "y" == enemy and typeof(enemy.y) == "number":
          enemy.y = enemy.Y ?? enemy.y + ny * 180
    enemyCoordX := "X" == enemy and typeof(enemy.X) == "number" and enemy.X or "x" == enemy and typeof(enemy.x) == "number" and enemy.x or 0
    enemyCoordY := "Y" == enemy and typeof(enemy.Y) == "number" and enemy.Y or "y" == enemy and typeof(enemy.y) == "number" and enemy.y or 0
    Services.Fx.Burst(enemyCoordX, enemyCoordY, "#38bdf8", 12, 4, 3)
    Services.Fx.AddText(enemyCoordX, enemyCoordY - 20, "WHIP! -" + String(floor(Math)), "#38bdf8", 17, true)
    Services.Sound.PlayHit(1.2)
    Services.Fx.Shake(6, 8)
    dealt
  fn resolveTailWhipCollision(segmentIndex:int, enemy:Enemy | IDamageable | unknown) -> int = this.ResolveTailWhipCollision(segmentIndex, enemy)
  fn GetActiveAlchemicalFusions() -> [str]:
    installed := Set()
    if HeadModules != nil:
      for [k, lvl] in Object.entries(HeadModules):
        if lvl > 0:
          installed.add(k.toLowerCase())
    active:[str] := []
    for fusion in GameData.AlchemicalFusions:
      if installed.has(fusion.ModuleA.toLowerCase()) and installed.has(fusion.ModuleB.toLowerCase()):
        active.push(fusion.Id)
    active
  fn getActiveAlchemicalFusions() -> [str] = this.GetActiveAlchemicalFusions()
