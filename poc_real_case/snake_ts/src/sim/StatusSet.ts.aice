module poc_real_case/snake_ts/src/sim/StatusSet

pub class StatusSet:
  SlowTimer = 0, SlowFactor = 1, FreezeTimer = 0, StunTimer = 0, BurnTimer = 0
  BurnDps = 0, MarkTimer = 0
  fn get_slowTimer() = SlowTimer; fn set_slowTimer(v) = SlowTimer = v
  fn get_slowFactor() = SlowFactor; fn set_slowFactor(v) = SlowFactor = v
  fn get_freezeTimer() = FreezeTimer; fn set_freezeTimer(v) = FreezeTimer = v
  fn get_stunTimer() = StunTimer; fn set_stunTimer(v) = StunTimer = v
  fn get_burnTimer() = BurnTimer; fn set_burnTimer(v) = BurnTimer = v
  fn get_burnDps() = BurnDps; fn set_burnDps(v) = BurnDps = v
  fn get_markTimer() = MarkTimer; fn set_markTimer(v) = MarkTimer = v
  fn get_isFrozen() = FreezeTimer > 0
  fn get_isStunned() = StunTimer > 0
  fn get_isBurning() = BurnTimer > 0
  fn get_isSlowed() = SlowTimer > 0
  fn get_isChilled() = SlowTimer > 0
  fn get_isMarked() = MarkTimer > 0
  fn Chill(seconds:int, factor:int) :
    SlowTimer = max(SlowTimer, seconds)
    SlowFactor = min(SlowFactor == 1 and factor or SlowFactor, factor)
  fn chill(seconds:int, factor:int) :
    this.Chill(seconds, factor)
  fn Freeze(seconds:int) -> void = FreezeTimer = max(FreezeTimer, seconds)
  fn freeze(seconds:int) :
    this.Freeze(seconds)
  fn Stun(seconds:int) -> void = StunTimer = max(StunTimer, seconds)
  fn stun(seconds:int) :
    this.Stun(seconds)
  fn Mark(seconds:int) -> void = MarkTimer = max(MarkTimer, seconds)
  fn mark(seconds:int) :
    this.Mark(seconds)
  fn Burn(seconds:int, dps:int) :
    BurnTimer = max(BurnTimer, seconds)
    BurnDps = max(BurnDps, dps)
  fn burn(seconds:int, dps:int) :
    this.Burn(seconds, dps)
  fn get_Immobile() = FreezeTimer > 0 or StunTimer > 0
  fn get_immobile() = this.Immobile
  fn get_SpeedMult() -> int:
    if SlowTimer > 0:
      SlowFactor
    else:
      1
  fn get_speedMult() = this.SpeedMult
  fn get_DamageTakenMult() -> int:
    if MarkTimer > 0:
      1.25
    else:
      1
  fn get_damageTakenMult() = this.DamageTakenMult
  fn Update(dt:int) -> int:
    if SlowTimer > 0:
      SlowTimer -= dt
      if SlowTimer <= 0:
        SlowTimer = 0
        SlowFactor = 1
    if FreezeTimer > 0:
      FreezeTimer = max(0, FreezeTimer - dt)
    if StunTimer > 0:
      StunTimer = max(0, StunTimer - dt)
    if MarkTimer > 0:
      MarkTimer = max(0, MarkTimer - dt)
    burnDamage ::= 0
    if BurnTimer > 0:
      step := min(dt, BurnTimer)
      burnDamage = BurnDps * step
      BurnTimer -= dt
      if BurnTimer <= 0:
        BurnTimer = 0
        BurnDps = 0
    burnDamage
  fn update(dt:int) -> int = this.Update(dt)
