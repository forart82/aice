module poc_real_case/snake_ts/src/sim/CombatModules

from "../core/MathX" import MathX
from "../core/Services" import Services
from "./Projectile" import Projectile
from "./Hazard" import Hazard
from "./Enemy" import Enemy
from "./Boss" import Boss
from "./SnakePlayer" import SnakePlayer
from "./CombatSystem" import CombatSystem
from "./World" import World

type ModuleActionContext:
  sys:CombatSystem, dt:int, world:World, player:SnakePlayer
  moduleType:str
  level:int, isHead:bool, originX:int, originY:int, angle:int
  dmgBonus:int
  getTimer:() => number
  setTimer:(number) => void
  socket:Option[unknown], slotIndex:Option[int]

type ModuleActionHandler = (ModuleActionContext) => void

const _cachedNearestTarget: unknown = { x: 0, y: 0 }

fn findNearestTarget(ctx:ModuleActionContext, maxRange:int) -> Option[unknown]:
  let enemies = World.getEnemies(ctx.world)
  let mut found = false
  let mut bestX = 0
  let mut bestY = 0
  let mut minDist = maxRange
  if enemies != nil:
    nil
  let bosses = World.getBosses(ctx.world)
  if found != nil:
    _cachedNearestTarget.x = bestX
    _cachedNearestTarget.y = bestY
    ret _cachedNearestTarget
  nil

pub class ModuleActionRegistry:
  static readonly _handlers: Map[str, ModuleActionHandler] = Map()
  static fn register(key:str, handler:ModuleActionHandler) :
    this._handlers.set(key, handler)
  static fn get(key:str) -> Option[ModuleActionHandler] = this._handlers.at(key) ?? nil
  static fn has(key:str) -> bool = this._handlers.has(key)
  static fn getRegisteredKeys() -> [str] = Array.from(this._handlers.keys())
  static fn execute(ctx:ModuleActionContext) :
    let handler = this._handlers.at(ctx.moduleType) ?? nil
    if handler != nil:
      handler(ctx)

fn executeHeadModules(sys:CombatSystem, dt:int, world:World) :
  let player = World.getPlayer(world)
  if not player or not (player.alive ?? player.Alive):
    ret
  let dmgBonus = player.damageBonus ?? player.DamageBonus ?? 1
  let px = player.x ?? player.X
  let py = player.y ?? player.Y
  let pa = player.angle ?? player.Angle
  let headMods = player.headModules or player.HeadModules
  if headMods != nil and typeof(headMods) == "object":
    if not player.headModuleTimers:
      player.headModuleTimers = {  }
    let timers = player.headModuleTimers
    for [mType, mLvl] in Object.entries(headMods):
      if not mType or typeof(mLvl) != "number" or mLvl <= 0:
        nil
      let ctx:ModuleActionContext = { sys, dt, world, player, moduleType: mType, level: mLvl, isHead: true, originX: px, originY: py, angle: pa, dmgBonus, getTimer: fn() = timers[mType] or 0, setTimer: fn(val:unknown) = nil }
      ModuleActionRegistry.execute(ctx)
