  _head1: BiteHead = { X: 0, Y: 0, R: 9, Mult: 0.55, x: 0, y: 0, r: 9, mult: 0.55 }
  _head2: BiteHead = { X: 0, Y: 0, R: 9, Mult: 0.55, x: 0, y: 0, r: 9, mult: 0.55 }
  _xpForNextLevel = 155
  static fn isOffenseModule(type:Option[str]) -> bool:
    if not type:
      ret false
    let def = GameData.SocketModules.Get(type)
    if def != nil:
      ret def.Category == "offense"
    type == "turret" or type == "tesla" or type == "magma" or type == "venom" or type == "laser" or type == "tachyon" or type == "cryo" or type == "plasma" or type == "flak" or type == "scattershot" or type == "needler" or type == "mortar" or type == "sonic" or type == "gatling" or type == "caltrop" or type == "singularity" or type == "solar"
  static fn IsOffenseModule(type:Option[str]) -> bool = SnakePlayer.isOffenseModule(type)
  static fn isDefenseModule(type:Option[str]) -> bool:
    if not type:
      ret false
    let def = GameData.SocketModules.Get(type)
    if def != nil:
      ret def.Category == "defense"
    type == "shield" or type == "spikes" or type == "regen" or type == "magnet" or type == "chrono" or type == "nanite" or type == "reactive" or type == "magnetic_aegis" or type == "cryo_carapace" or type == "heatsink" or type == "cloak" or type == "emp_coil"
  static fn IsDefenseModule(type:Option[str]) -> bool = SnakePlayer.isDefenseModule(type)
  fn RecalculateHp() -> void:
    let mut sum = this.HeadHp
    let len = this.Segments.length
    this._cachedHp = sum
    this._hpDirty = false
    this._cachedSegCount = len
  fn recalculateHp() -> void:
    this.RecalculateHp()
  fn RecalculateMaxHp() -> void:
    let mut sum = this.HeadMaxHp
    let len = this.Segments.length
    this._cachedMaxHp = sum
    this._maxHpDirty = false
    this._cachedSegCount = len
  fn recalculateMaxHp() -> void:
    this.RecalculateMaxHp()
  get headHp() -> int = this.HeadHp
  set headHp(v:int):
    this.HeadHp = v
    this._hpDirty = true
  get headMaxHp() -> int = this.HeadMaxHp
  set headMaxHp(v:int):
    this.HeadMaxHp = v
    this._maxHpDirty = true
  get Hp() -> int:
    if this._hpDirty or this._cachedHp < 0 or this._cachedSegCount != this.Segments.length:
      this.RecalculateHp()
    this._cachedHp
  set Hp(v:int):
    let mut remaining = Number.isFinite(v) and Math.max(0, v) or 0
    if remaining > this.MaxHp:
      this.MaxHp = remaining
    this.HeadHp = Math.min(this.HeadMaxHp, remaining)
    remaining = remaining - this.HeadHp
    this.RecalculateHp()
  get MaxHp() -> int:
    if this._maxHpDirty or this._cachedMaxHp < 0 or this._cachedSegCount != this.Segments.length:
      this.RecalculateMaxHp()
    this._cachedMaxHp
  set MaxHp(v:int):
    if not Number.isFinite(v) or v <= 0:
      ret
    this.Stats.MaxHp = v
    if this.Segments.length > 0:
      let totalUnits = 2 + this.Segments.length
      let unitHp = Math.max(10, Math.round(Math))
      this.HeadMaxHp = unitHp * 2
      this.HeadHp = Math.min(this.HeadHp, this.HeadMaxHp)
    else:
      this.HeadMaxHp = v
      this.HeadHp = Math.min(this.HeadHp, this.HeadMaxHp)
    this.RecalculateMaxHp()
    this.RecalculateHp()
