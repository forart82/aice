  SegmentRadius = 11, SegmentSpacing = 15, BaseSpeed = 195, TurnSpeed = 9.5, X:int
  Y:int, Angle:int, TargetAngle:int, VelocityX:int, VelocityY:int
  MaxSegments = 12000
  Segments: [SnakeSegment] = []
  HeadHp = 50, HeadMaxHp = 50, _cachedHp = -1, _hpDirty = true, _cachedMaxHp = -1
  _maxHpDirty = true, _cachedSegCount = -1, DashDuration = 0.32, DashTimer = 0, DashCooldownTimer = 0
  IsDashing = false, DashSpeedMultiplier = 2.5, InvulnerableTimer = 0
  DashHitIds: Set[int] = Set()
  SkillCooldownTimer = 0, SkillActiveTimer = 0, ArmorBuffTimer = 0
  Relics: Record[str, int]
  CardStacks: Record[str, int] = {  }
  OrbitalAngle = 0, OrbitDistance = 54, SpitCooldown = 0, VortexTimer = 0, RegenTimer = 0
  ShieldRechargeTimer = 0, ShieldBrokenTimer = 0, TrailTimer = 0, MagmaTimer = 0, GluttonCounter = 0
  DevourerCounter = 0, DevourerStacks = 0, DamageBonus = 1, EyeBlinkTimer:int, EyeBlinking = false
  MouthOpen = 0, BodyPulse = 0, HurtFlash = 0
  Afterimages: [Afterimage] = []
  EmberTimer = 0, FoodsEaten = 0, PendingRevive = false, MutationPoints = 1
  HeadAugment: Option[str] = nil
  HeadAugmentLevel = 0, HeadLaserTimer = 0, HeadCrownTimer = 0, AgilitySurgeTimer = 0, HeadSelfHitCooldown = 0
  PeakLength = 0
  HeadModules: Record[str, int] = {  }
  HeadModuleTimers: Record[str, int] = {  }
  HeadPurchaseCount = 0
  EquippedHelmet: Option[HelmetLike] = nil
  meta: Option[MetaProgression]
  services: Option[IServiceContainer]
  readonly _biteHeads: [BiteHead] = []
  readonly _orbitalPositions: [Orbital] = []
  _head0: BiteHead = { X: 0, Y: 0, R: 14, Mult: 1, x: 0, y: 0, r: 14, mult: 1 }
  _head1: BiteHead = { X: 0, Y: 0, R: 9, Mult: 0.55, x: 0, y: 0, r: 9, mult: 0.55 }
  _head2: BiteHead = { X: 0, Y: 0, R: 9, Mult: 0.55, x: 0, y: 0, r: 9, mult: 0.55 }
  _xpForNextLevel = 155
  static fn isOffenseModule(type:Option[str]) -> bool:
    if not type:
      ret false
    let def = GameData.SocketModules.Get(type)
    if def != nil:
      ret def.Category == "offense"
    type == "turret" or type == "tesla" or type == "magma" or type == "venom" or type == "laser" or type == "tachyon" or type == "cryo" or type == "plasma" or type == "flak" or type == "scattershot" or type == "needler" or type == "mortar" or type == "sonic" or type == "gatling" or type == "caltrop" or type == "singularity" or type == "solar"
  static fn IsOffenseModule(type:Option[str]) -> bool = SnakePlayer.isOffenseModule(type)
  static fn isDefenseModule(type:Option[str]) -> bool:
    if not type:
      ret false
    let def = GameData.SocketModules.Get(type)
    if def != nil:
      ret def.Category == "defense"
    type == "shield" or type == "spikes" or type == "regen" or type == "magnet" or type == "chrono" or type == "nanite" or type == "reactive" or type == "magnetic_aegis" or type == "cryo_carapace" or type == "heatsink" or type == "cloak" or type == "emp_coil"
  static fn IsDefenseModule(type:Option[str]) -> bool = SnakePlayer.isDefenseModule(type)
  fn RecalculateHp() :
    let mut sum = HeadHp
    let len = Segments.length
    _cachedHp = sum
    _hpDirty = false
    _cachedSegCount = len
  fn recalculateHp() :
    this.RecalculateHp()
  fn RecalculateMaxHp() :
    let mut sum = HeadMaxHp
    let len = Segments.length
    _cachedMaxHp = sum
    _maxHpDirty = false
    _cachedSegCount = len
  fn recalculateMaxHp() :
    this.RecalculateMaxHp()
  get headHp = HeadHp
  set headHp(v:int):
    HeadHp = v
    _hpDirty = true
  get headMaxHp = HeadMaxHp
  set headMaxHp(v:int):
    HeadMaxHp = v
    _maxHpDirty = true
  get Hp() -> int:
    if _hpDirty or _cachedHp < 0 or _cachedSegCount != Segments.length:
      this.RecalculateHp()
    _cachedHp
  set Hp(v:int):
    let mut remaining = Number.isFinite(v) and Math.max(0, v) or 0
    if remaining > this.MaxHp:
      this.MaxHp = remaining
    HeadHp = Math.min(HeadMaxHp, remaining)
    remaining -= HeadHp
    this.RecalculateHp()
  get MaxHp() -> int:
    if _maxHpDirty or _cachedMaxHp < 0 or _cachedSegCount != Segments.length:
      this.RecalculateMaxHp()
    _cachedMaxHp
  set MaxHp(v:int):
    if not Number.isFinite(v) or v <= 0:
      ret
    Stats.MaxHp = v
    if Segments.length > 0:
      let totalUnits = 2 + Segments.length
      let unitHp = Math.max(10, Math.round(Math))
      HeadMaxHp = unitHp * 2
      HeadHp = Math.min(HeadHp, HeadMaxHp)
    else:
      HeadMaxHp = v
      HeadHp = Math.min(HeadHp, HeadMaxHp)
    this.RecalculateMaxHp()
    this.RecalculateHp()
  get classConfig = ClassConfig; set classConfig(v) = ClassConfig = v
  get classId = ClassId; set classId(v) = ClassId = v
  get stats = Stats; set stats(v) = Stats = v
  get hp = this.Hp; set hp(v) = this.Hp = v
  get maxHp = this.MaxHp; set maxHp(v) = this.MaxHp = v
  get totalXpCollected = TotalXpCollected; set totalXpCollected(v) = TotalXpCollected = v
  get ouro = Xp; set ouro(v) = Xp = v
  get Ouro = Xp; set Ouro(v) = Xp = v
  get totalOuroCollected = TotalXpCollected; set totalOuroCollected(v) = TotalXpCollected = v
  get TotalOuroCollected = TotalXpCollected; set TotalOuroCollected(v) = TotalXpCollected = v
  get Length = Segments.length + 1
  get length = this.Length
  get TotalLength = Segments.length + 1
  get totalLength = this.TotalLength
  get shield = Shield; set shield(v) = Shield = v
  get xp = Xp; set xp(v) = Xp = v
  get level = Level; set level(v) = Level = v
  get xpToNext = XpToNext; set xpToNext(v) = XpToNext = v
  get pendingLevelUps = PendingLevelUps; set pendingLevelUps(v) = PendingLevelUps = v
  get alive = Alive; set alive(v) = Alive = v
  get headRadius = HeadRadius * HeadRadiusMultiplier; set headRadius(v) = HeadRadius = v
  get headRadiusMultiplier = HeadRadiusMultiplier; set headRadiusMultiplier(v) = HeadRadiusMultiplier = v
  get titanGorgingTimer = TitanGorgingTimer; set titanGorgingTimer(v) = TitanGorgingTimer = v
  get segmentRadius = SegmentRadius; set segmentRadius(v) = SegmentRadius = v
  get segmentSpacing = SegmentSpacing; set segmentSpacing(v) = SegmentSpacing = v
  get baseSpeed = BaseSpeed; set baseSpeed(v) = BaseSpeed = v
  get turnSpeed = TurnSpeed; set turnSpeed(v) = TurnSpeed = v
  get agilitySurgeTimer = AgilitySurgeTimer; set agilitySurgeTimer(v) = AgilitySurgeTimer = v
  get headSelfHitCooldown = HeadSelfHitCooldown; set headSelfHitCooldown(v) = HeadSelfHitCooldown = v
  get EffectiveTurnSpeed = AgilitySurgeTimer > 0 and TurnSpeed * 1.45 or TurnSpeed
  get effectiveTurnSpeed = this.EffectiveTurnSpeed
  get x = X; set x(v) = X = v
  get y = Y; set y(v) = Y = v
  get angle = Angle; set angle(v) = Angle = v
  get targetAngle = TargetAngle; set targetAngle(v) = TargetAngle = v
  get velocityX = VelocityX; set velocityX(v) = VelocityX = v
  get velocityY = VelocityY; set velocityY(v) = VelocityY = v
  get maxSegments = MaxSegments; set maxSegments(v) = MaxSegments = v
  get segments = Segments; set segments(v) = Segments = v
  get dashDuration = DashDuration; set dashDuration(v) = DashDuration = v
  get dashTimer = DashTimer; set dashTimer(v) = DashTimer = v
  get dashDurationTimer = DashTimer; set dashDurationTimer(v) = DashTimer = v
  get dashCooldownTimer = DashCooldownTimer; set dashCooldownTimer(v) = DashCooldownTimer = v
  get isDashing = IsDashing; set isDashing(v) = IsDashing = v
  get dashSpeedMultiplier = DashSpeedMultiplier; set dashSpeedMultiplier(v) = DashSpeedMultiplier = v
  get invulnerableTimer = InvulnerableTimer; set invulnerableTimer(v) = InvulnerableTimer = v
  get dashHitIds = DashHitIds; set dashHitIds(v) = DashHitIds = v
  get skillCooldownTimer = SkillCooldownTimer; set skillCooldownTimer(v) = SkillCooldownTimer = v
  get skillActiveTimer = SkillActiveTimer; set skillActiveTimer(v) = SkillActiveTimer = v
  get armorBuffTimer = ArmorBuffTimer; set armorBuffTimer(v) = ArmorBuffTimer = v
  get relics = Relics; set relics(v) = Relics = v
  get cardStacks = CardStacks; set cardStacks(v) = CardStacks = v
  get orbitalAngle = OrbitalAngle; set orbitalAngle(v) = OrbitalAngle = v
  get orbitDistance = OrbitDistance; set orbitDistance(v) = OrbitDistance = v
  get spitCooldown = SpitCooldown; set spitCooldown(v) = SpitCooldown = v
  get vortexTimer = VortexTimer; set vortexTimer(v) = VortexTimer = v
  get regenTimer = RegenTimer; set regenTimer(v) = RegenTimer = v
  get shieldRechargeTimer = ShieldRechargeTimer; set shieldRechargeTimer(v) = ShieldRechargeTimer = v
  get shieldBrokenTimer = ShieldBrokenTimer; set shieldBrokenTimer(v) = ShieldBrokenTimer = v
  get trailTimer = TrailTimer; set trailTimer(v) = TrailTimer = v
  get magmaTimer = MagmaTimer; set magmaTimer(v) = MagmaTimer = v
  get gluttonCounter = GluttonCounter; set gluttonCounter(v) = GluttonCounter = v
  get devourerCounter = DevourerCounter; set devourerCounter(v) = DevourerCounter = v
  get devourerStacks = DevourerStacks; set devourerStacks(v) = DevourerStacks = v
  get damageBonus = DamageBonus; set damageBonus(v) = DamageBonus = v
  get eyeBlinkTimer = EyeBlinkTimer; set eyeBlinkTimer(v) = EyeBlinkTimer = v
  get eyeBlinking = EyeBlinking; set eyeBlinking(v) = EyeBlinking = v
  get mouthOpen = MouthOpen; set mouthOpen(v) = MouthOpen = v
  get bodyPulse = BodyPulse; set bodyPulse(v) = BodyPulse = v
  get hurtFlash = HurtFlash; set hurtFlash(v) = HurtFlash = v
  get afterimages = Afterimages; set afterimages(v) = Afterimages = v
  get emberTimer = EmberTimer; set emberTimer(v) = EmberTimer = v
  get foodsEaten = FoodsEaten; set foodsEaten(v) = FoodsEaten = v
  get pendingRevive = PendingRevive; set pendingRevive(v) = PendingRevive = v
  get mutationPoints = MutationPoints; set mutationPoints(v) = MutationPoints = v
  get peakLength = PeakLength; set peakLength(v) = PeakLength = v
  get headAugment = HeadAugment; set headAugment(v) = HeadAugment = v
  get headAugmentLevel = HeadAugmentLevel; set headAugmentLevel(v) = HeadAugmentLevel = v
  get headLaserTimer = HeadLaserTimer; set headLaserTimer(v) = HeadLaserTimer = v
  get headCrownTimer = HeadCrownTimer; set headCrownTimer(v) = HeadCrownTimer = v
  get headModules = HeadModules; set headModules(v) = HeadModules = v
  get headModuleTimers = HeadModuleTimers; set headModuleTimers(v) = HeadModuleTimers = v
  get headPurchaseCount = HeadPurchaseCount; set headPurchaseCount(v) = HeadPurchaseCount = v
  get equippedHelmet = EquippedHelmet; set equippedHelmet(v) = EquippedHelmet = v ?? nil
  get helmet = EquippedHelmet; set helmet(v) = EquippedHelmet = v ?? nil
  fn EquipHelmet(v:Option[HelmetLike]) -> void = EquippedHelmet = v ?? nil
  fn equipHelmet(v:Option[HelmetLike]) :
    this.EquipHelmet(v)
  fn triggerTitanGorging(duration:int = 3) :
    HeadRadiusMultiplier = 2
    TitanGorgingTimer = duration
  fn TriggerTitanGorging(duration:int = 3) :
    this.triggerTitanGorging(duration)
  fn GetHeadModuleLevel(key:str) -> int = HeadModules[key] or 0
  fn getHeadModuleLevel(key:str) -> int = this.GetHeadModuleLevel(key)
  fn SetHeadModuleLevel(key:str, level:int) -> void = HeadModules[key] = Math.max(0, level)
  fn setHeadModuleLevel(key:str, level:int) :
    this.SetHeadModuleLevel(key, level)
  fn GetHeadAugmentLevel(key:str) -> int = HeadAugment == key and HeadAugmentLevel or 0 or 0
  fn getHeadAugmentLevel(key:str) -> int = this.GetHeadAugmentLevel(key)
  fn GetHeadModuleCost(key:str, targetLvl:int) -> int:
    let lvl = targetLvl != undefined and targetLvl or this.GetHeadModuleLevel(key) + 1
    30 * lvl + HeadPurchaseCount * 15
  fn getHeadModuleCost(key:str, targetLvl:int) -> int = this.GetHeadModuleCost(key, targetLvl)
  fn GetHeadAugmentCost(key:str, targetLvl:int) -> int:
    let cur = HeadAugment == key and HeadAugmentLevel or 0
    let lvl = targetLvl != undefined and targetLvl or cur + 1
    40 * lvl + HeadPurchaseCount * 20
  fn getHeadAugmentCost(key:str, targetLvl:int) -> int = this.GetHeadAugmentCost(key, targetLvl)
  fn InstallHeadModule(key:str) -> int:
    let cur = this.GetHeadModuleLevel(key)
    if cur >= 3:
      ret cur
    let next = cur + 1
    HeadModules[key] = next
    HeadPurchaseCount += 1
    if key == "shield":
      let shieldBonus = 25
      Stats.MaxShield = Stats.MaxShield + shieldBonus
      Shield = Math.min(Stats.MaxShield, Shield + shieldBonus)
    elif key == "spikes":
      Stats.Thorns = Stats.Thorns + 0.2
    next
  fn installHeadModule(key:str) -> int = this.InstallHeadModule(key)
  fn UninstallHeadModule(key:str) :
    nil
  fn uninstallHeadModule(key:str) :
    this.UninstallHeadModule(key)
  fn InstallHeadAugment(key:str) -> int:
    let cur = HeadAugment == key and HeadAugmentLevel or 0
    if cur >= 3:
      ret cur
    let next = cur + 1
    this.SetHeadAugment(key, next)
    HeadPurchaseCount += 1
    next
  fn installHeadAugment(key:str) -> int = this.InstallHeadAugment(key)
  get Meta = meta; set Meta(v) = meta = v
  get Services = services; set Services(v) = services = v
  fn constructor(classId:Option[str] = "emerald", arenaW:unknown = 0, arenaH:unknown = 0, initialSegments:unknown = 2, metaOrOptions:MetaProgression | unknown):
    if metaOrOptions == MetaProgression:
      meta = metaOrOptions
    elif metaOrOptions != nil and typeof(metaOrOptions) == "object":
      meta = metaOrOptions.meta
      services = metaOrOptions.services
    let cfg = classId != nil and GameData.Classes.Get(classId) or nil ?? GameData.Classes.Get("emerald")
    ClassConfig = cfg
    ClassId = ClassConfig.Id
    if arenaW > 0:
      X = arenaW * 0.5
    else:
      X = 480
    if arenaH > 0:
      Y = arenaH * 0.5
    else:
      Y = 320
    Angle = 0
    TargetAngle = 0
    VelocityX = BaseSpeed
    VelocityY = 0
    let meta = meta ?? services?.meta ?? typeof(Services) != "undefined" and Services.Meta and Services.Meta or MetaProgression.Instance
    let b = ClassConfig.BaseStats
    Stats = PlayerStats()
    Stats.MaxHp = b.MaxHp + meta and meta.Level("vitality") * 10 or 0
    Stats.Speed = b.Speed * 1 + meta and meta.Level("agility") * 0.04 or 0
    Stats.DashCooldown = Math.max(0.8, b.DashCooldown - meta and meta.Level("swiftness") * 0.15 or 0)
    Stats.BitePower = b.BitePower * 1 + meta and meta.Level("ferocity") * 0.06 or 0
    Stats.MagnetRadius = b.MagnetRadius * 1 + meta and meta.Level("magnet") * 0.15 or 0
    Stats.CritChance = b.CritChance
    Stats.CritMult = b.CritMult
    Stats.Armor = Math.min(0.8, b.Armor + meta and meta.Level("resilience") * 0.03 or 0)
    Stats.MaxShield = 0
    Stats.XpGain = 1
    Stats.ShardGain = 1
    Stats.ComboWindow = 1
    Stats.Thorns = 0
    Stats.SkillCooldown = ClassConfig.Skill.Cooldown
    if ClassId == "emerald":
      Stats.MagnetRadius = Stats.MagnetRadius * 1.3
    let segCount = initialSegments != undefined and initialSegments >= 0 and initialSegments or 2
    let baseSegHp = this.BaseSegmentHp
    HeadMaxHp = 2 * baseSegHp
    HeadHp = HeadMaxHp
    PeakLength = Segments.length
    this.RecalculateMaxHp()
    this.RecalculateHp()
    Stats.MaxHp = this.MaxHp
    let equippedHelmet = meta != nil and meta.GetEquippedHelmet and meta.GetEquippedHelmet() or nil
    EquippedHelmet = equippedHelmet
    if EquippedHelmet != nil and EquippedHelmet.Stats or EquippedHelmet.stats:
      let hs = EquippedHelmet.Stats or EquippedHelmet.stats
      let hHp = hs.MaxHp or hs.maxHp or 0
      if hHp > 0:
        Stats.MaxHp = Stats.MaxHp + hHp
        let extraPerPart = Math.round(Math)
        HeadMaxHp += 2 * extraPerPart
        HeadHp = HeadMaxHp
        for seg in Segments:
          seg.MaxHp = seg.MaxHp + extraPerPart
          seg.Hp = seg.MaxHp
        this.RecalculateMaxHp()
        this.RecalculateHp()
      if hs.Armor or hs.armor:
        Stats.Armor = Math.min(0.85, Stats.Armor + hs.Armor or hs.armor or 0)
      if hs.Speed or hs.speed:
        Stats.Speed = Stats.Speed + hs.Speed or hs.speed or 0
      if hs.BitePower or hs.bitePower:
        Stats.BitePower = Stats.BitePower + hs.BitePower or hs.bitePower or 0
      if hs.MagnetRadius or hs.magnetRadius:
        Stats.MagnetRadius = Stats.MagnetRadius + hs.MagnetRadius or hs.magnetRadius or 0
      if hs.CritChance or hs.critChance:
        Stats.CritChance = Math.min(1, Stats.CritChance + hs.CritChance or hs.critChance or 0)
      if hs.CritMult or hs.critMult:
        Stats.CritMult = Stats.CritMult + hs.CritMult or hs.critMult or 0
      if hs.DashCooldown or hs.dashCooldown:
        Stats.DashCooldown = Math.max(0.6, Stats.DashCooldown - hs.DashCooldown or hs.dashCooldown or 0)
      if hs.Thorns or hs.thorns:
        Stats.Thorns = Stats.Thorns + hs.Thorns or hs.thorns or 0
      if hs.XpMultiplier or hs.xpMultiplier:
        Stats.XpGain = Stats.XpGain + hs.XpMultiplier or hs.xpMultiplier or 0
      if hs.ShardMultiplier or hs.shardMultiplier:
        Stats.ShardGain = Stats.ShardGain + hs.ShardMultiplier or hs.shardMultiplier or 0
      if hs.HpRegen or hs.hpRegen:
        Stats.HpRegen = Stats.HpRegen + hs.HpRegen or hs.hpRegen or 0
      if hs.Shield or hs.shield:
        let sVal = hs.Shield or hs.shield or 0
        Shield = Shield or 0 + sVal
        Stats.MaxShield = Stats.MaxShield or 0 + sVal
    Shield = Shield or 0
    Xp = 0
    Level = 1
    XpToNext = 155
    _xpForNextLevel = 155
    PendingLevelUps = 0
    Alive = true
    Relics = GameData.newRelics()
    EyeBlinkTimer = Rng.Shared.range(2, 5)
  get BitePower() -> int:
    let mut p = Stats.BitePower * DamageBonus
    let adrenal = Relics["adrenal"] ?? 0
    if adrenal > 0 and this.Hp < Stats.MaxHp * 0.4:
      p *= 1 + 0.2 * adrenal
    p
  get bitePower = this.BitePower
  get MoveSpeed() -> int:
    let mut s = BaseSpeed * Stats.Speed
    let adrenal = Relics["adrenal"] ?? 0
    if adrenal > 0 and this.Hp < Stats.MaxHp * 0.4:
      s *= 1 + 0.35 * adrenal
    if IsDashing != nil:
      s *= DashSpeedMultiplier
    s
  get moveSpeed = this.MoveSpeed
  get EffectiveArmor() -> int:
    let mut a = Stats.Armor + this.SegmentArmorBonus
    if ArmorBuffTimer > 0:
      a += 0.25
    if HeadModules["spikes"]:
      a += 0.04 * HeadModules["spikes"]
    MathX.clamp(a, 0, 0.85)
  get effectiveArmor = this.EffectiveArmor
  get SkillReady = SkillCooldownTimer <= 0
  get skillReady = this.SkillReady
  get DashReady = DashCooldownTimer <= 0 and not IsDashing
  get dashReady = this.DashReady
  fn BiteHeads() -> [BiteHead]:
    _biteHeads.length = 0
    let currentR = this.headRadius
    _head0.X = X
    _head0.Y = Y
    _head0.R = currentR
    _head0.x = X
    _head0.y = Y
    _head0.r = currentR
    _head0.Mult = 1
    _head0.mult = 1
    _biteHeads.push(_head0)
    if ClassId == "hydra":
      let nx = Math.cos(Angle + Math.PI / 2)
      let ny = Math.sin(Angle + Math.PI / 2)
      let back = 6
      let bx = X - Math.cos(Angle) * back
      let by = Y - Math.sin(Angle) * back
      let h1x = bx + nx * 15
      let h1y = by + ny * 15
      _head1.X = h1x
      _head1.Y = h1y
      _head1.x = h1x
      _head1.y = h1y
      _biteHeads.push(_head1)
      let h2x = bx - nx * 15
      let h2y = by - ny * 15
      _head2.X = h2x
      _head2.Y = h2y
      _head2.x = h2x
      _head2.y = h2y
      _biteHeads.push(_head2)
    _biteHeads
  fn biteHeads() -> [BiteHead] = this.BiteHeads()
  fn OrbitalPositions() -> [Orbital]:
    let n = Relics["orbitalFangs"] ?? 0
    while _orbitalPositions.length < n:
      _orbitalPositions.push({ X: 0, Y: 0, A: 0, x: 0, y: 0, a: 0 })
    _orbitalPositions.length = n
    _orbitalPositions
  fn orbitalPositions() -> [Orbital] = this.OrbitalPositions()
  fn Update(dt:int, steer:ISteerInput, arenaW:int, arenaH:int, world:World) :
    if not Number.isFinite(dt) or dt <= 0:
      ret
    if not Number.isFinite(X):
      if arenaW > 0:
        X = arenaW * 0.5
      else:
        X = 480
    if not Number.isFinite(Y):
      if arenaH > 0:
        Y = arenaH * 0.5
      else:
        Y = 320
    if not Number.isFinite(Angle):
      Angle = 0
    if not Number.isFinite(TargetAngle):
      TargetAngle = Angle
    DashCooldownTimer = MathX.decayTimer(DashCooldownTimer, dt)
    SkillCooldownTimer = MathX.decayTimer(SkillCooldownTimer, dt)
    InvulnerableTimer = MathX.decayTimer(InvulnerableTimer, dt)
    ArmorBuffTimer = MathX.decayTimer(ArmorBuffTimer, dt)
    AgilitySurgeTimer = MathX.decayTimer(AgilitySurgeTimer, dt)
    HeadSelfHitCooldown = MathX.decayTimer(HeadSelfHitCooldown, dt)
    HurtFlash = MathX.decayTimer(HurtFlash, dt * 3)
    if TitanGorgingTimer > 0:
      TitanGorgingTimer = MathX.decayTimer(TitanGorgingTimer, dt)
      if TitanGorgingTimer <= 0:
        HeadRadiusMultiplier = 1
    if IsDashing != nil:
      DashTimer -= dt
      if DashTimer <= 0:
        IsDashing = false
        DashHitIds.clear()
    let steerActive = steer != nil and steer.Active ?? steer.active ?? false or false
    let steerX = steer != nil and steer.X ?? steer.x ?? 0 or 0
    let steerY = steer != nil and steer.Y ?? steer.y ?? 0 or 0
    if steerActive != nil:
      let len = Math.sqrt(steerX * steerX + steerY * steerY)
      if len > 0.001 and Number.isFinite(len):
        TargetAngle = Math.atan2(steerY, steerX)
    let turn = this.EffectiveTurnSpeed * IsDashing and 0.65 or 1
    let diff = MathX.angleDelta(Angle, TargetAngle)
    Angle += diff * MathX.clamp(turn * dt, 0, 1)
    if Angle > Math.PI:
      Angle -= MathX.Tau
    if Angle < -Math.PI:
      Angle += MathX.Tau
    let speed = this.MoveSpeed
    VelocityX = Math.cos(Angle) * speed
    VelocityY = Math.sin(Angle) * speed
    X += VelocityX * dt
    Y += VelocityY * dt
    let m = HeadRadius
    let hitLeft = X < m
    let hitRight = X > arenaW - m
    let hitTop = Y < m
    let hitBottom = Y > arenaH - m
    if hitLeft or hitRight != nil and hitTop or hitBottom:
      let nx = hitLeft != nil and 1 or -1
      let ny = hitTop != nil and 1 or -1
      if hitLeft != nil:
        X = m + 1
      else:
        X = arenaW - m - 1
      if hitTop != nil:
        Y = m + 1
      else:
        Y = arenaH - m - 1
      this.Deflect(nx * Math.SQRT1_2, ny * Math.SQRT1_2)
    else:
      if hitLeft != nil:
        X = m
        this.Deflect(1, 0)
      elif hitRight != nil:
        X = arenaW - m
        this.Deflect(-1, 0)
      if hitTop != nil:
        Y = m
        this.Deflect(0, 1)
      elif hitBottom != nil:
        Y = arenaH - m
        this.Deflect(0, -1)
    this.UpdateSegments(dt)
    if world != nil:
      this.UpdatePassives(dt, world)
      this.UpdateCosmetics(dt, world)
  fn update(dt:int, steer:ISteerInput, arenaW:int, arenaH:int, world:World) :
    this.Update(dt, steer, arenaW, arenaH, world)
  fn Deflect(nx:int, ny:int) :
    if not Number.isFinite(nx) or not Number.isFinite(ny):
      ret
    let nLen = Math.hypot(nx, ny)
    if not Number.isFinite(nLen) or nLen < 0.0001:
      ret
    nx /= nLen
    ny /= nLen
    let dot = Math.cos(Angle) * nx + Math.sin(Angle) * ny
    if dot >= 0:
      ret
    let tx = Math.cos(Angle) - dot * nx
    let ty = Math.sin(Angle) - dot * ny
    let len = Math.sqrt(tx * tx + ty * ty)
    if len > 0.01:
      Angle = Math.atan2(ty / len, tx / len)
      let tdot = Math.cos(TargetAngle) * nx + Math.sin(TargetAngle) * ny
      if tdot < 0:
        TargetAngle = Angle
    else:
      let tangentX = -ny
      let tangentY = nx
      Angle = Math.atan2(tangentY, tangentX)
      let tdot = Math.cos(TargetAngle) * nx + Math.sin(TargetAngle) * ny
      if tdot < 0:
        TargetAngle = Angle
  fn deflect(nx:int, ny:int) :
    this.Deflect(nx, ny)
  fn UpdateSegments(_dt:int) :
    let mut px = Number.isFinite(X) and X or 480
    let mut py = Number.isFinite(Y) and Y or 320
    let spacing = SegmentSpacing
    let spacingSq = spacing * spacing
    let n = Segments.length
    let segRadius = SegmentRadius
    let invN = n > 0 and 0.4 / n or 0
  fn updateSegments(dt:int) :
    this.UpdateSegments(dt)
  fn stepIK(dt:int) :
    this.UpdateSegments(dt)
  fn stepIk(dt:int) :
    this.UpdateSegments(dt)
  fn UpdatePassives(dt:int, world:World) :
    if Stats.HpRegen > 0:
      RegenTimer += dt
      if RegenTimer >= 3:
        RegenTimer -= 3
        let healAmt = Math.max(1, Math.round(Math))
        if this.Hp < Stats.MaxHp:
          this.Heal(healAmt)
          Services.Fx.AddText(X, Y - 18, "+" + String(healAmt), "#10b981", 12, false)
    elif ClassId == "emerald":
      RegenTimer += dt
      if RegenTimer >= 6:
        RegenTimer -= 6
        if this.Hp < Stats.MaxHp:
          this.Heal(1)
          Services.Fx.AddText(X, Y - 18, "+1", "#10b981", 12, false)
    let magmaStacks = ClassId == "solar" and 1 or 0 + Relics["moltenWake"] ?? 0
    let hazards = world != nil and world.Hazards or world.hazards or nil
    if magmaStacks > 0 and hazards:
      MagmaTimer += dt
      let interval = 0.34 / magmaStacks
      if MagmaTimer >= interval:
        MagmaTimer = 0
        if hazards.length < 90:
          let tail = Segments.length > 0 and Segments[Math.min(3, Segments.length - 1)] or nil
          let tx = tail != nil and tail.X or X
          let ty = tail != nil and tail.Y or Y
          hazards.push(Hazard(tx, ty, "magma", { Radius: 22, Life: 3.2, Dps: 26 * magmaStacks * DamageBonus, Owner: "player" }))
    if Stats.MaxShield > 0:
      if ShieldBrokenTimer > 0:
        ShieldBrokenTimer = Math.max(0, ShieldBrokenTimer - dt)
      if Shield < Stats.MaxShield and ShieldBrokenTimer <= 0:
        ShieldRechargeTimer += dt
        if ShieldRechargeTimer >= 8:
          ShieldRechargeTimer = 0
          Shield = Stats.MaxShield
          Services.Fx.RingShockwave(X, Y, "#3a86ff", 18, 0.035)
          Services.Sound.PlayShield()
    if Relics["orbitalFangs"] ?? 0 > 0:
      OrbitalAngle += dt * 3.4 % MathX.Tau
    if Relics["singularity"] ?? 0 > 0:
      VortexTimer += dt
    if SpitCooldown > 0:
      SpitCooldown -= dt
  fn updatePassives(dt:int, world:World) :
    this.UpdatePassives(dt, world)
  fn UpdateCosmetics(dt:int, world:World) :
    BodyPulse += dt * 2.4 % MathX.Tau
    EyeBlinkTimer -= dt
    if EyeBlinkTimer <= 0:
      EyeBlinking = not EyeBlinking
      if EyeBlinking != nil:
        EyeBlinkTimer = 0.12
      else:
        EyeBlinkTimer = Rng.Shared.range(2, 5)
    let nearest:Option[FoodItem] = world != nil and world.NearestFood or world.nearestFood or nil or nil
    if nearest != nil:
      let nx = nearest.X ?? nearest.x ?? 0
      let ny = nearest.Y ?? nearest.y ?? 0
      let d = MathX.safeLen(nx - X, ny - Y)
      if d < 80:
        MouthOpen = MathX.clamp(80 - d / 55, 0, 1)
      else:
        MouthOpen = 0
    else:
      MouthOpen *= Math.max(0, 1 - dt * 6)
    EmberTimer += dt
    let emberInterval = IsDashing != nil and 0.016 or 0.07
    while EmberTimer >= emberInterval:
      EmberTimer -= emberInterval
      Services.Fx.TrailEmbers(X + Rng.Shared.range(-5, 5), Y + Rng.Shared.range(-5, 5), ClassConfig.Color, IsDashing != nil and 4 or 2)
    if IsDashing != nil and ClassId == "stalker" and Afterimages.length < 14:
      Afterimages.push(Afterimage(X, Y, Angle, 0.35, 0.35))
  fn updateCosmetics(dt:int, world:World) :
    this.UpdateCosmetics(dt, world)
  fn TryDash() -> bool:
    if not this.DashReady:
      ret false
    IsDashing = true
    DashTimer = DashDuration
    DashCooldownTimer = Stats.DashCooldown
    DashHitIds.clear()
    let invulnWindow = ClassId == "stalker" and Math.min(0.4, Math.max(0.05, Stats.DashCooldown * 0.5 - DashDuration)) or 0.12
    InvulnerableTimer = Math.max(InvulnerableTimer, DashDuration + invulnWindow)
    Services.Sound.PlayDash()
    Services.Fx.RingShockwave(X, Y, ClassConfig.Color, 14, 0.05)
    true
  fn tryDash() -> bool = this.TryDash()
  fn TriggerDash() -> bool = this.TryDash()
  fn triggerDash() -> bool = this.TryDash()
  fn TriggerSkill(world:World, combat:CombatSystem) -> bool:
    if not this.SkillReady:
      ret false
    if combat != nil and world and typeof(combat.ActivateSkill) == "function":
      ret combat.ActivateSkill(world)
    if world != nil and world.Game?.Combat:
      ret world.Game.Combat.ActivateSkill(world)
    let stats = Stats
    let scooldown = stats.SkillCooldown ?? 20
    SkillCooldownTimer = scooldown
    Services.Sound.PlaySkill()
    let pcol = ClassConfig?.Color or "#00f0b5"
    Services.Fx.RingShockwave(X, Y, pcol, 24, 0.05)
    true
  fn triggerSkill(world:World, combat:CombatSystem) -> bool = this.TriggerSkill(world, combat)
  get BaseSegmentHp() -> int:
    let meta = meta ?? services?.meta ?? typeof(Services) != "undefined" and Services.Meta and Services.Meta or MetaProgression.Instance
    let base = ClassConfig != nil and ClassConfig.BaseStats.MaxHp or 100
    Math.max(15, Math.round(Math) + meta and meta.Level("vitality") * 5 or 0)
  get baseSegmentHp = this.BaseSegmentHp
  fn AddGrowth(count:int) :
    let mut lx = X
    let mut ly = Y
    let mut la = Angle
    if Segments.length > 0:
      let last = Segments[Segments.length - 1]
      lx = last.X
      ly = last.Y
      la = last.Angle
    let segHp = this.BaseSegmentHp
    PeakLength = Math.max(PeakLength, Segments.length)
    this.RecalculateMaxHp()
    this.RecalculateHp()
    Stats.MaxHp = this.MaxHp
  fn addGrowth(count:int) :
    this.AddGrowth(count)
  fn SetHeadAugment(augmentId:str, level:int) :
    HeadAugment = augmentId
    HeadAugmentLevel = Math.max(0, level)
    if augmentId == "fangs" and level > 0:
      Stats.BitePower = ClassConfig.BaseStats.BitePower * 1 + 0.15 * level
  fn setHeadAugment(augmentId:str, level:int) :
    this.SetHeadAugment(augmentId, level)
  fn SetHeadAugmentLevel(augmentId:str, level:int) :
    this.SetHeadAugment(augmentId, level)
  fn setHeadAugmentLevel(augmentId:str, level:int) :
    this.SetHeadAugment(augmentId, level)
  get SegmentArmorBonus = Math.min(0.5, Segments.length * 0.03)
  get segmentArmorBonus = this.SegmentArmorBonus
  fn AddBodySegment() :
    if Segments.length >= MaxSegments:
      ret
    this.AddGrowth(1)
  fn addBodySegment() :
    this.AddBodySegment()
  fn DamageHead(amount:int, applyArmor:unknown = true, setInvulnerable:unknown = true, silent:unknown = false) -> int:
    if not Alive or setInvulnerable != nil and InvulnerableTimer > 0 or not (amount > 0) or not Number.isFinite(amount):
      ret 0
    let dealt = applyArmor != nil and Math.max(1, MathX.roundJs(amount * 1 - this.EffectiveArmor)) or amount
    let mut toHp = dealt
    if Shield > 0:
      let toShield = Math.min(Shield, dealt)
      Shield -= toShield
      toHp = dealt - toShield
      if Shield <= 0:
        ShieldBrokenTimer = 2.5
      ShieldRechargeTimer = 0
    while toHp > 0 and Segments.length > 0:
      let lastIdx = Segments.length - 1
      let lastSeg = Segments[lastIdx]
      if lastSeg.Hp > toHp:
        lastSeg.Hp = lastSeg.Hp - toHp
        lastSeg.HitFlash = 1
        if not silent:
          Services.Fx.Burst(lastSeg.X, lastSeg.Y, "#ff3366", 6, 2, 2)
        toHp = 0
      else:
        toHp -= lastSeg.Hp
        if not silent:
          Services.Fx.Burst(lastSeg.X, lastSeg.Y, "#ff5400", 10, 4, 3)
          Services.Fx.AddText(lastSeg.X, lastSeg.Y - 20, "⚡ LIFE SOURCED", "#ffb703", 14, true)
        Segments.pop()
        this.RecalculateHp()
        this.RecalculateMaxHp()
        Stats.MaxHp = this.MaxHp
    if toHp > 0:
      HeadHp = Math.max(0, HeadHp - toHp)
    if setInvulnerable != nil:
      InvulnerableTimer = 0.6
    HurtFlash = 1
    if not silent:
      Services.Fx.Burst(X, Y, "#ff3366", 8, 3, 2)
      Services.Fx.AddText(X, Y - 18, "-" + String(Math.floor(Math)), "#ff3366", 16, true)
      Services.Sound.PlayHit()
    if Segments.length == 0 and HeadHp <= 0:
      HeadHp = 0
      let charges = Relics["phoenixCharges"] ?? 0
      if charges > 0:
        Relics["phoenixCharges"] = charges - 1
        HeadHp = HeadMaxHp
        if Segments.length == 0:
          this.AddGrowth(2)
        InvulnerableTimer = 3
        PendingRevive = true
        Services.Fx.AddText(X, Y - 46, "🔥 PHOENIX REBIRTH 🔥", "#ffb703", 22, true)
        Services.Sound.PlayRevive()
        this.RecalculateHp()
        ret dealt
      Alive = false
    this.RecalculateHp()
    dealt
  fn damageHead(amount:int, applyArmor:unknown = true, setInvulnerable:unknown = true, silent:unknown = false) -> int = this.DamageHead(amount, applyArmor, setInvulnerable, silent)
  fn DamageSegment(segmentIndex:int, amount:int, applyArmor:unknown = true, setInvulnerable:unknown = true, silent:unknown = false) -> int:
    if not Alive or setInvulnerable != nil and InvulnerableTimer > 0 or not (amount > 0) or not Number.isFinite(amount):
      ret 0
    if typeof(segmentIndex) != "number" or not Number.isInteger(segmentIndex) or segmentIndex < 0 or segmentIndex >= Segments.length:
      ret 0
    let seg = Segments[segmentIndex]
    let dealt = applyArmor != nil and Math.max(1, MathX.roundJs(amount * 1 - this.EffectiveArmor)) or amount
    let mut toHp = dealt
    if toHp > 0 and Shield > 0:
      let toShield = Math.min(Shield, toHp)
      Shield -= toShield
      toHp -= toShield
      if Shield <= 0:
        ShieldBrokenTimer = 2.5
      ShieldRechargeTimer = 0
    seg.Hp = seg.Hp - toHp
    seg.HitFlash = 1
    if setInvulnerable != nil:
      InvulnerableTimer = 0.6
    HurtFlash = 1
    if not silent:
      Services.Fx.Burst(seg.X, seg.Y, "#ff3366", 8, 3, 2)
      Services.Fx.AddText(seg.X, seg.Y - 18, "-" + String(Math.floor(Math)), "#ff3366", 16, true)
      Services.Sound.PlayHit()
    if seg.Hp <= 0:
      this.SeverFrom(segmentIndex)
    else:
      this.RecalculateHp()
    dealt
  fn damageSegment(segmentIndex:int, amount:int, applyArmor:unknown = true, setInvulnerable:unknown = true, silent:unknown = false) -> int = this.DamageSegment(segmentIndex, amount, applyArmor, setInvulnerable, silent)
  fn SeverFrom(index:int) :
    if typeof(index) != "number" or not Number.isInteger(index) or index < 0 or index >= Segments.length:
      ret
    let severCount = Segments.length - index
    if severCount > 10:
      let step = Math.max(1, Math.floor(Math))
      if Segments[index]:
        Services.Fx.AddText(Segments[index].X, Segments[index].Y - 24, "⚡ SEVERED (-" + String(severCount) + ")!", "#ff5400", 16, true)
    else:
      nil
    if Segments[index]:
      Services.Fx.RingShockwave(Segments[index].X, Segments[index].Y, "#ff3366", 22, 0.08)
    Services.Sound.PlayExplosion()
    Segments.splice(index)
    this.RecalculateHp()
    this.RecalculateMaxHp()
    Stats.MaxHp = this.MaxHp
    if Segments.length == 0 and HeadHp <= 0:
      let charges = Relics["phoenixCharges"] ?? 0
      if charges > 0:
        Relics["phoenixCharges"] = charges - 1
        HeadHp = HeadMaxHp
        this.AddGrowth(2)
        InvulnerableTimer = 3
        PendingRevive = true
        Services.Fx.AddText(X, Y - 46, "🔥 PHOENIX REBIRTH 🔥", "#ffb703", 22, true)
        Services.Sound.PlayRevive()
        this.RecalculateHp()
        ret
      Alive = false
  fn severFrom(index:int) :
    this.SeverFrom(index)
  fn SwapSegments(i:int, j:int) :
    if typeof(i) != "number" or not Number.isInteger(i) or typeof(j) != "number" or not Number.isInteger(j):
      ret
    if i < 0 or i >= Segments.length or j < 0 or j >= Segments.length or i == j:
      ret
    let temp = Segments[i]
    Segments[i] = Segments[j]
    Segments[j] = temp
  fn swapSegments(i:int, j:int) :
    this.SwapSegments(i, j)
  fn ReorderSegment(fromIndex:int, toIndex:int) :
    if typeof(fromIndex) != "number" or not Number.isInteger(fromIndex) or typeof(toIndex) != "number" or not Number.isInteger(toIndex):
      ret
    if fromIndex < 0 or fromIndex >= Segments.length or toIndex < 0 or toIndex >= Segments.length or fromIndex == toIndex:
      ret
    let item = Segments.splice(fromIndex, 1)[0]
    Segments.splice(toIndex, 0, item)
  fn reorderSegment(fromIndex:int, toIndex:int) :
    this.ReorderSegment(fromIndex, toIndex)
  static fn GetAddSegmentCost(currentSegmentCount:int) -> int = 35 + Math.max(0, currentSegmentCount - 2) * 15
  static fn getAddSegmentCost(currentSegmentCount:int) -> int = SnakePlayer.GetAddSegmentCost(currentSegmentCount)
  fn Heal(amount:int) -> int:
    if not Alive or not (amount > 0) or not Number.isFinite(amount):
      ret 0
    let mut remaining = amount
    let mut totalHealed = 0
    let headMissing = HeadMaxHp - HeadHp
    if headMissing > 0:
      let headAdd = Math.min(headMissing, remaining)
      HeadHp += headAdd
      remaining -= headAdd
      totalHealed += headAdd
    this.RecalculateHp()
    totalHealed
  fn heal(amount:int) -> int = this.Heal(amount)
  static fn CalibratedXpThreshold(level:int) -> int:
    if not Number.isFinite(level) or level <= 1:
      ret 0
    Math.floor(Math)
  static fn calibratedXpThreshold(level:int) -> int = SnakePlayer.CalibratedXpThreshold(level)
  fn GainXp(amount:int) -> bool:
    if not (amount > 0):
      ret false
    let earned = amount * (Stats?.XpGain ?? 1)
    Xp += earned
    TotalXpCollected += earned
    let mut levelled = false
    let mut guard = 0
    while TotalXpCollected >= _xpForNextLevel and guard < 50:
      Level += 1
      _xpForNextLevel = SnakePlayer.CalibratedXpThreshold(Level + 1)
      XpToNext = Math.max(1, _xpForNextLevel - SnakePlayer.CalibratedXpThreshold(Level))
      PendingLevelUps += 1
      levelled = true
    levelled
  fn gainXp(amount:int) -> bool = this.GainXp(amount)
  fn GainOuro(amount:int) -> bool = this.GainXp(amount)
  fn gainOuro(amount:int) -> bool = this.GainXp(amount)
  fn SpendOuro(cost:int) -> bool:
    if not Number.isFinite(cost):
      ret false
    if cost <= 0:
      ret true
    if Xp < cost:
      ret false
    Xp -= cost
    true
  fn spendOuro(cost:int) -> bool = this.SpendOuro(cost)
  fn AddOuro(amount:int) :
    if Number.isFinite(amount) and amount > 0:
      Xp += amount
      TotalXpCollected += amount
  fn addOuro(amount:int) :
    this.AddOuro(amount)
  fn TakeDamage(amount:int, _source:Option[str] = nil) -> int:
    if not Alive or InvulnerableTimer > 0 or not (amount > 0):
      ret 0
    if HeadModules["cloak"] and HeadModules["cloak"] > 0:
      if Math.random() < 0.15 * HeadModules["cloak"]:
        Services.Fx.AddText(X, Y - 24, "💨 EVADED!", "#a855f7", 15, true)
        InvulnerableTimer = 0.8
        ret 0
    if HeadModules["reactive"] and HeadModules["reactive"] > 0:
      Services.Fx.RingShockwave(X, Y, "#f97316", 36, 0.06)
      Services.Sound.PlayExplosion()
    let dealt = Math.max(1, MathX.roundJs(amount * 1 - this.EffectiveArmor))
    let mut toShield = 0
    let mut toHp = dealt
    if Shield > 0:
      toShield = Math.min(Shield, dealt)
      Shield -= toShield
      toHp = dealt - toShield
      if Shield <= 0:
        ShieldBrokenTimer = 2.5
      ShieldRechargeTimer = 0
    while toHp > 0 and Segments.length > 0:
      let lastIdx = Segments.length - 1
      let lastSeg = Segments[lastIdx]
      if lastSeg.Hp > toHp:
        lastSeg.Hp = lastSeg.Hp - toHp
        lastSeg.HitFlash = 1
        Services.Fx.Burst(lastSeg.X, lastSeg.Y, "#ff3366", 8, 3, 2)
        toHp = 0
      else:
        toHp -= lastSeg.Hp
        Services.Fx.Burst(lastSeg.X, lastSeg.Y, "#ff5400", 10, 4, 3)
        Services.Fx.AddText(lastSeg.X, lastSeg.Y - 20, "⚡ LIFE SOURCED", "#ffb703", 14, true)
        Segments.pop()
        this.RecalculateHp()
        this.RecalculateMaxHp()
        Stats.MaxHp = this.MaxHp
    if toHp > 0:
      HeadHp = Math.max(0, HeadHp - toHp)
    InvulnerableTimer = 0.6
    HurtFlash = 1
    if toShield > 0 and toHp == 0:
      Services.Fx.AddText(X, Y - 22, "-" + String(Math.floor(Math)) + " 🛡️", "#3a86ff", 14, true)
      Services.Sound.PlayShield()
    else:
      Services.Fx.AddText(X, Y - 22, "-" + String(Math.floor(Math)), "#ff3366", 17, true)
      Services.Fx.Shake(9, 12)
      Services.Sound.PlayHit()
    if Segments.length == 0 and HeadHp <= 0:
      let charges = Relics["phoenixCharges"] ?? 0
      if charges > 0:
        Relics["phoenixCharges"] = charges - 1
        HeadHp = HeadMaxHp
        this.AddGrowth(2)
        InvulnerableTimer = 3
        PendingRevive = true
        Services.Fx.AddText(X, Y - 46, "🔥 PHOENIX REBIRTH 🔥", "#ffb703", 22, true)
        Services.Sound.PlayRevive()
        ret 0
      Alive = false
    dealt
  fn takeDamage(amount:int, source:Option[str] = nil) -> int = this.TakeDamage(amount, source)
  fn Autotomy(world:World) -> int:
    if not Alive or Segments.length <= 1:
      ret 0
    let cutIndex = Math.max(1, Math.floor(Math))
    let severedCount = Segments.length - cutIndex
    let cutSegment = Segments[cutIndex]
    if cutSegment != nil:
      Services.Fx.RingShockwave(cutSegment.X, cutSegment.Y, "#ff5400", 32, 0.06)
      let combat = world != nil and world.combat ?? world.Combat ?? world.game?.combat ?? world.Game?.Combat or nil
      if world != nil and combat and typeof(combat.explodeAt) == "function":
        combat.explodeAt(world, cutSegment.X, cutSegment.Y, 140, 80 * DamageBonus, "#ff5400")
    Services.Sound.PlayExplosion(1.5)
    Services.Fx.Shake(12, 16)
    Segments.splice(cutIndex)
    this.RecalculateHp()
    this.RecalculateMaxHp()
    Stats.MaxHp = this.MaxHp
    InvulnerableTimer = 1.2
    AgilitySurgeTimer = 4
    severedCount
  fn autotomy(world:World) -> int = this.Autotomy(world)
  fn GetSegmentTangentialSpeed(segmentIndex:int) -> int:
    if typeof(segmentIndex) != "number" or not Number.isInteger(segmentIndex) or segmentIndex < 0 or segmentIndex >= Segments.length:
      ret BaseSpeed
    BaseSpeed + this.EffectiveTurnSpeed * segmentIndex * SegmentSpacing
  fn getSegmentTangentialSpeed(segmentIndex:int) -> int = this.GetSegmentTangentialSpeed(segmentIndex)
  fn GetTailWhipDamageMultiplier(segmentIndex:int) -> int:
    let v = this.GetSegmentTangentialSpeed(segmentIndex)
    let ratio = v / Math.max(1, BaseSpeed)
    1 + 0.85 * Math.pow(ratio, 2)
  fn getTailWhipDamageMultiplier(segmentIndex:int) -> int = this.GetTailWhipDamageMultiplier(segmentIndex)
  fn ResolveTailWhipCollision(segmentIndex:int, enemy:Enemy | IDamageable | unknown | Record | null) -> int:
    if typeof(segmentIndex) != "number" or not Number.isInteger(segmentIndex) or segmentIndex < 0 or segmentIndex >= Segments.length:
      ret 0
    if not enemy or typeof(enemy.takeDamage) != "function":
      ret 0
    let mult = this.GetTailWhipDamageMultiplier(segmentIndex)
    let rawDmg = Math.round(Math)
    let dealt = enemy.takeDamage(rawDmg, this)
    let seg = Segments[segmentIndex]
    if seg != nil and "x" == enemy and typeof(enemy.x) == "number" or "X" == enemy and typeof(enemy.X) == "number":
      let ex = "X" == enemy and typeof(enemy.X) == "number" and enemy.X or "x" == enemy and typeof(enemy.x) == "number" and enemy.x or 0
      let ey = "Y" == enemy and typeof(enemy.Y) == "number" and enemy.Y or "y" == enemy and typeof(enemy.y) == "number" and enemy.y or 0
      let dx = ex - seg.X
      let dy = ey - seg.Y
      let dist = Math.hypot(dx, dy)
      let nx = dist > 0.001 and Number.isFinite(dist) and dx / dist or Math.cos(Angle)
      let ny = dist > 0.001 and Number.isFinite(dist) and dy / dist or Math.sin(Angle)
      if Number.isFinite(nx) and Number.isFinite(ny):
        if "X" == enemy and typeof(enemy.X) == "number":
          enemy.X = enemy.X + nx * 180
        if "Y" == enemy and typeof(enemy.Y) == "number":
          enemy.Y = enemy.Y + ny * 180
        if "x" == enemy and typeof(enemy.x) == "number":
          enemy.x = enemy.X ?? enemy.x + nx * 180
        if "y" == enemy and typeof(enemy.y) == "number":
          enemy.y = enemy.Y ?? enemy.y + ny * 180
    let enemyCoordX = "X" == enemy and typeof(enemy.X) == "number" and enemy.X or "x" == enemy and typeof(enemy.x) == "number" and enemy.x or 0
    let enemyCoordY = "Y" == enemy and typeof(enemy.Y) == "number" and enemy.Y or "y" == enemy and typeof(enemy.y) == "number" and enemy.y or 0
    Services.Fx.Burst(enemyCoordX, enemyCoordY, "#38bdf8", 12, 4, 3)
    Services.Fx.AddText(enemyCoordX, enemyCoordY - 20, "WHIP! -" + String(Math.floor(Math)), "#38bdf8", 17, true)
    Services.Sound.PlayHit(1.2)
    Services.Fx.Shake(6, 8)
    dealt
  fn resolveTailWhipCollision(segmentIndex:int, enemy:Enemy | IDamageable | unknown) -> int = this.ResolveTailWhipCollision(segmentIndex, enemy)
  fn GetActiveAlchemicalFusions() -> [str]:
    let installed = Set()
    if HeadModules != nil:
      for [k, lvl] in Object.entries(HeadModules):
        if lvl > 0:
          installed.add(k.toLowerCase())
    let active:[str] = []
    for fusion in GameData.AlchemicalFusions:
      if installed.has(fusion.ModuleA.toLowerCase()) and installed.has(fusion.ModuleB.toLowerCase()):
        active.push(fusion.Id)
    active
  fn getActiveAlchemicalFusions() -> [str] = this.GetActiveAlchemicalFusions()
