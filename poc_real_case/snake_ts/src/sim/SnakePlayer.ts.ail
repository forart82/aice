pub class SnakeSegment:
  X: int
  Y: int
  Angle: int
  R: int
  Hp: int
  MaxHp: int
  HitFlash: int = 0
  SelfHitCooldown: int = 0
  BossHitCooldown: int = 0
  get x() -> int = this.X
  set x(v:int) = this.X = v
  get y() -> int = this.Y
  set y(v:int) = this.Y = v
  get angle() -> int = this.Angle
  set angle(v:int) = this.Angle = v
  get r() -> int = this.R
  set r(v:int) = this.R = v
  get hp() -> int = this.Hp
  set hp(v:int) = this.Hp = v
  get maxHp() -> int = this.MaxHp
  set maxHp(v:int) = this.MaxHp = v
  get hitFlash() -> int = this.HitFlash
  set hitFlash(v:int) = this.HitFlash = v
  get selfHitCooldown() -> int = this.SelfHitCooldown
  set selfHitCooldown(v:int) = this.SelfHitCooldown = v
  get bossHitCooldown() -> int = this.BossHitCooldown
  set bossHitCooldown(v:int) = this.BossHitCooldown = v
  fn constructor(x:int, y:int, angle:int, r:int, maxHp:unknown = 25):
    this.X = x
    this.Y = y
    this.Angle = angle
    this.R = r
    this.MaxHp = maxHp
    this.Hp = maxHp

type BiteHead:
  X:int
  Y:int
  R:int
  Mult:int
  x:Option[int]
  y:Option[int]
  r:Option[int]
  mult:Option[int]

type Orbital:
  X:int
  Y:int
  A:int
  x:Option[int]
  y:Option[int]
  a:Option[int]

pub class Afterimage:
  X: int
  Y: int
  Angle: int
  Life: int
  Max: int
  get x() -> int = this.X
  set x(v:int) = this.X = v
  get y() -> int = this.Y
  set y(v:int) = this.Y = v
  get angle() -> int = this.Angle
  set angle(v:int) = this.Angle = v
  get life() -> int = this.Life
  set life(v:int) = this.Life = v
  get max() -> int = this.Max
  set max(v:int) = this.Max = v
  fn constructor(x:unknown = 0, y:unknown = 0, angle:unknown = 0, life:unknown = 0, max:unknown = 0):
    this.X = x
    this.Y = y
    this.Angle = angle
    this.Life = life
    this.Max = max

