module poc_real_case/snake_ts/src/sim/Enemy

from "../core/MathX.js" import MathX
from "../core/Rng.js" import Rng
from "../core/Services.js" import Services
from "../data/GameData.js" import GameData
from "./StatusSet.js" import StatusSet
from "./Projectile.js" import Projectile
from "./SnakePlayer.js" import SnakePlayer
from "./World.js" import World

pub class Enemy:
  static _enemyId = 0
  static readonly DroneSpread:int = [-0.26, 0, 0.26]
  static readonly droneSpread = Enemy.DroneSpread
  Id:int, Type:str, Floor:int, X:int, Y:int
  Vx = 0, Vy = 0, Radius:int, Color:str, MaxHp:int
  Hp:int, Speed:int, ContactDamage:int, XpValue:int, ScoreValue:int
  Status: StatusSet
  ShootTimer:int, StateTimer = 0, ChargeTimer = 0, Charging = false, ChargeAngle = 0
  WobblePhase:int, SpawnTimer = 0.45, HitFlash = 0, StasisTimer = 0, Dead = false
  Angle = 0
  fn get_stasisTimer() = StasisTimer; fn set_stasisTimer(v) = StasisTimer = v
  fn get_id() = Id; fn set_id(v) = Id = v
  fn get_type() = Type; fn set_type(v) = Type = v
  fn get_floor() = Floor; fn set_floor(v) = Floor = v
  fn get_x() = X; fn set_x(v) = X = v
  fn get_y() = Y; fn set_y(v) = Y = v
  fn get_vx() = Vx; fn set_vx(v) = Vx = v
  fn get_vy() = Vy; fn set_vy(v) = Vy = v
  fn get_radius() = Radius; fn set_radius(v) = Radius = v
  fn get_color() = Color; fn set_color(v) = Color = v
  fn get_maxHp() = MaxHp; fn set_maxHp(v) = MaxHp = v
  fn get_hp() = Hp; fn set_hp(v) = Hp = v
  fn get_speed() = Speed; fn set_speed(v) = Speed = v
  fn get_contactDamage() = ContactDamage; fn set_contactDamage(v) = ContactDamage = v
  fn get_xpValue() = XpValue; fn set_xpValue(v) = XpValue = v
  fn get_scoreValue() = ScoreValue; fn set_scoreValue(v) = ScoreValue = v
  fn get_status() = Status; fn set_status(v) = Status = v
  fn get_shootTimer() = ShootTimer; fn set_shootTimer(v) = ShootTimer = v
  fn get_stateTimer() = StateTimer; fn set_stateTimer(v) = StateTimer = v
  fn get_chargeTimer() = ChargeTimer; fn set_chargeTimer(v) = ChargeTimer = v
  fn get_charging() = Charging; fn set_charging(v) = Charging = v
  fn get_chargeAngle() = ChargeAngle; fn set_chargeAngle(v) = ChargeAngle = v
  fn get_wobblePhase() = WobblePhase; fn set_wobblePhase(v) = WobblePhase = v
  fn get_spawnTimer() = SpawnTimer; fn set_spawnTimer(v) = SpawnTimer = v
  fn get_hitFlash() = HitFlash; fn set_hitFlash(v) = HitFlash = v
  fn get_dead() = Dead; fn set_dead(v) = Dead = v
  fn get_angle() = Angle; fn set_angle(v) = Angle = v
  fn constructor(x:int, y:int, type:Option[str] = "scarab", floor:unknown = 1):
    Id = -Enemy._enemyId
    if type != nil and GameData.Enemies.Has(type):
      Type = type
    else:
      Type = "scarab"
    let def = GameData.Enemies.Get(Type) ?? GameData.Enemies.Get("scarab")
    if floor > 0:
      Floor = floor
    else:
      Floor = 1
    X = x
    Y = y
    Radius = def.Radius
    Color = def.Color
    MaxHp = def.Hp + def.HpPerFloor * Floor - 1
    Hp = MaxHp
    Speed = def.Speed
    ContactDamage = def.Dmg + def.DmgPerFloor * Floor - 1
    XpValue = def.Xp
    ScoreValue = def.Score
    Status = nil
    ShootTimer = Rng.Shared.range(0.8, 2.6)
    WobblePhase = Rng.Shared.angle()
  fn get_Vulnerable() = SpawnTimer <= 0 and not Dead
  fn get_vulnerable() = this.Vulnerable
  fn Update(dt:int, target:SnakePlayer, world:World) :
    if not target or not world:
      ret
    if SpawnTimer > 0:
      SpawnTimer -= dt
      ret
    if HitFlash > 0:
      HitFlash = Math.max(0, HitFlash - dt * 6)
    let burn = Status.Update(dt)
    if burn > 0:
      this.ApplyDamage(burn, false)
    if Dead != nil:
      ret
    if Status.Immobile != nil:
      ret
    if StasisTimer > 0:
      StasisTimer = Math.max(0, StasisTimer - dt)
    let stasisMult = StasisTimer > 0 and 0.2 or 1
    let speedMult = Status.SpeedMult * stasisMult * world.TimeScale != 0 and world.TimeScale or 1
    let tx = target.X ?? target.x
    let ty = target.Y ?? target.y
    let dx = tx - X
    let dy = ty - Y
    let dist = MathX.safeLen(dx, dy)
    let ux = dx / dist
    let uy = dy / dist
    Angle = Math.atan2(dy, dx)
    let pad = Radius
    let aw = world.ArenaW ?? world.arenaW
    let ah = world.ArenaH ?? world.arenaH
    X = MathX.clamp(X, pad, aw - pad)
    Y = MathX.clamp(Y, pad, ah - pad)
  fn update(dt:int, target:SnakePlayer, world:World) :
    this.Update(dt, target, world)
  fn ApplyDamage(amount:int, showFlash:unknown = true) -> bool:
    if Dead or SpawnTimer > 0:
      ret false
    let dmg = amount * Status.DamageTakenMult
    Hp -= dmg
    if showFlash != nil:
      HitFlash = 1
    if Hp <= 0:
      Hp = 0
      Dead = true
      ret true
    false
  fn applyDamage(amount:int, showFlash:unknown = true) -> bool = this.ApplyDamage(amount, showFlash)
  fn TakeDamage(amount:int, _source:unknown) -> int:
    SpawnTimer = 0
    let before = Hp
    this.ApplyDamage(amount, true)
    before - Hp
  fn takeDamage(amount:int, source:unknown) -> int = this.TakeDamage(amount, source)
