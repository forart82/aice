module poc_real_case/snake_ts/src/sim/Enemy

from "../core/MathX.js" import MathX
from "../core/Rng.js" import Rng
from "../core/Services.js" import Services
from "../data/GameData.js" import GameData
from "./StatusSet.js" import StatusSet
from "./Projectile.js" import Projectile
from "./SnakePlayer.js" import SnakePlayer
from "./World.js" import World

pub class Enemy:
  static _enemyId = 0
  static readonly DroneSpread:int = [-0.26, 0, 0.26]
  static readonly droneSpread = Enemy.DroneSpread
  Id:int, Type:str, Floor:int, X:int, Y:int
  Vx = 0, Vy = 0, Radius:int, Color:str, MaxHp:int
  Hp:int, Speed:int, ContactDamage:int, XpValue:int, ScoreValue:int
  Status: StatusSet
  ShootTimer:int, StateTimer = 0, ChargeTimer = 0, Charging = false, ChargeAngle = 0
  WobblePhase:int, SpawnTimer = 0.45, HitFlash = 0, StasisTimer = 0, Dead = false
  Angle = 0
  fn get_stasisTimer() = this.StasisTimer; fn set_stasisTimer(v) = this.StasisTimer = v
  fn get_id() = this.Id; fn set_id(v) = this.Id = v
  fn get_type() = this.Type; fn set_type(v) = this.Type = v
  fn get_floor() = this.Floor; fn set_floor(v) = this.Floor = v
  fn get_x() = this.X; fn set_x(v) = this.X = v
  fn get_y() = this.Y; fn set_y(v) = this.Y = v
  fn get_vx() = this.Vx; fn set_vx(v) = this.Vx = v
  fn get_vy() = this.Vy; fn set_vy(v) = this.Vy = v
  fn get_radius() = this.Radius; fn set_radius(v) = this.Radius = v
  fn get_color() = this.Color; fn set_color(v) = this.Color = v
  fn get_maxHp() = this.MaxHp; fn set_maxHp(v) = this.MaxHp = v
  fn get_hp() = this.Hp; fn set_hp(v) = this.Hp = v
  fn get_speed() = this.Speed; fn set_speed(v) = this.Speed = v
  fn get_contactDamage() = this.ContactDamage; fn set_contactDamage(v) = this.ContactDamage = v
  fn get_xpValue() = this.XpValue; fn set_xpValue(v) = this.XpValue = v
  fn get_scoreValue() = this.ScoreValue; fn set_scoreValue(v) = this.ScoreValue = v
  fn get_status() = this.Status; fn set_status(v) = this.Status = v
  fn get_shootTimer() = this.ShootTimer; fn set_shootTimer(v) = this.ShootTimer = v
  fn get_stateTimer() = this.StateTimer; fn set_stateTimer(v) = this.StateTimer = v
  fn get_chargeTimer() = this.ChargeTimer; fn set_chargeTimer(v) = this.ChargeTimer = v
  fn get_charging() = this.Charging; fn set_charging(v) = this.Charging = v
  fn get_chargeAngle() = this.ChargeAngle; fn set_chargeAngle(v) = this.ChargeAngle = v
  fn get_wobblePhase() = this.WobblePhase; fn set_wobblePhase(v) = this.WobblePhase = v
  fn get_spawnTimer() = this.SpawnTimer; fn set_spawnTimer(v) = this.SpawnTimer = v
  fn get_hitFlash() = this.HitFlash; fn set_hitFlash(v) = this.HitFlash = v
  fn get_dead() = this.Dead; fn set_dead(v) = this.Dead = v
  fn get_angle() = this.Angle; fn set_angle(v) = this.Angle = v
  fn constructor(x:int, y:int, type:Option[str] = "scarab", floor:unknown = 1):
    this.Id = -Enemy._enemyId
    if type != nil and GameData.Enemies.Has(type):
      this.Type = type
    else:
      this.Type = "scarab"
    let def = GameData.Enemies.Get(this.Type) ?? GameData.Enemies.Get("scarab")
    if floor > 0:
      this.Floor = floor
    else:
      this.Floor = 1
    this.X = x
    this.Y = y
    this.Radius = def.Radius
    this.Color = def.Color
    this.MaxHp = def.Hp + def.HpPerFloor * this.Floor - 1
    this.Hp = this.MaxHp
    this.Speed = def.Speed
    this.ContactDamage = def.Dmg + def.DmgPerFloor * this.Floor - 1
    this.XpValue = def.Xp
    this.ScoreValue = def.Score
    this.Status = nil
    this.ShootTimer = Rng.Shared.range(0.8, 2.6)
    this.WobblePhase = Rng.Shared.angle()
  fn get_Vulnerable() = this.SpawnTimer <= 0 and not this.Dead
  fn get_vulnerable() = this.Vulnerable
  fn Update(dt:int, target:SnakePlayer, world:World) :
    if not target or not world:
      ret
    if this.SpawnTimer > 0:
      this.SpawnTimer = this.SpawnTimer - dt
      ret
    if this.HitFlash > 0:
      this.HitFlash = Math.max(0, this.HitFlash - dt * 6)
    let burn = this.Status.Update(dt)
    if burn > 0:
      this.ApplyDamage(burn, false)
    if this.Dead != nil:
      ret
    if this.Status.Immobile != nil:
      ret
    if this.StasisTimer > 0:
      this.StasisTimer = Math.max(0, this.StasisTimer - dt)
    let stasisMult = this.StasisTimer > 0 and 0.2 or 1
    let speedMult = this.Status.SpeedMult * stasisMult * world.TimeScale != 0 and world.TimeScale or 1
    let tx = target.X ?? target.x
    let ty = target.Y ?? target.y
    let dx = tx - this.X
    let dy = ty - this.Y
    let dist = MathX.safeLen(dx, dy)
    let ux = dx / dist
    let uy = dy / dist
    this.Angle = Math.atan2(dy, dx)
    let pad = this.Radius
    let aw = world.ArenaW ?? world.arenaW
    let ah = world.ArenaH ?? world.arenaH
    this.X = MathX.clamp(this.X, pad, aw - pad)
    this.Y = MathX.clamp(this.Y, pad, ah - pad)
  fn update(dt:int, target:SnakePlayer, world:World) :
    this.Update(dt, target, world)
  fn ApplyDamage(amount:int, showFlash:unknown = true) -> bool:
    if this.Dead or this.SpawnTimer > 0:
      ret false
    let dmg = amount * this.Status.DamageTakenMult
    this.Hp = this.Hp - dmg
    if showFlash != nil:
      this.HitFlash = 1
    if this.Hp <= 0:
      this.Hp = 0
      this.Dead = true
      ret true
    false
  fn applyDamage(amount:int, showFlash:unknown = true) -> bool = this.ApplyDamage(amount, showFlash)
  fn TakeDamage(amount:int, _source:unknown) -> int:
    this.SpawnTimer = 0
    let before = this.Hp
    this.ApplyDamage(amount, true)
    before - this.Hp
  fn takeDamage(amount:int, source:unknown) -> int = this.TakeDamage(amount, source)
