module poc_real_case/snake_ts/src/sim/Hazard

from "../core/Rng.js" import Rng

type HazardOpts:
  Radius:Option[int], Life:Option[int], Dps:Option[int], Owner:Option[str], Telegraph:Option[int]
  ImpactDamage:Option[int], radius:Option[int], life:Option[int], dps:Option[int], owner:Option[str]
  telegraph:Option[int], impactDamage:Option[int]

pub class Hazard:
  X:int, Y:int, Type:str, Radius:int, MaxLife:int
  Life:int, Dps:int, Owner:str, Telegraph:int, ImpactDamage:int
  Detonated:bool, Pulse:int, Dead:bool, TelegraphMax = 0
  fn get_x() = X; fn set_x(v) = X = v
  fn get_y() = Y; fn set_y(v) = Y = v
  fn get_type() = Type; fn set_type(v) = Type = v
  fn get_radius() = Radius; fn set_radius(v) = Radius = v
  fn get_maxLife() = MaxLife; fn set_maxLife(v) = MaxLife = v
  fn get_life() = Life; fn set_life(v) = Life = v
  fn get_dps() = Dps; fn set_dps(v) = Dps = v
  fn get_owner() = Owner; fn set_owner(v) = Owner = v
  fn get_telegraph() = Telegraph; fn set_telegraph(v) = Telegraph = v
  fn get_impactDamage() = ImpactDamage; fn set_impactDamage(v) = ImpactDamage = v
  fn get_detonated() = Detonated; fn set_detonated(v) = Detonated = v
  fn get_pulse() = Pulse; fn set_pulse(v) = Pulse = v
  fn get_dead() = Dead; fn set_dead(v) = Dead = v
  fn get_telegraphMax() = TelegraphMax; fn set_telegraphMax(v) = TelegraphMax = v
  fn constructor(xOrOpts:int | unknown, y:unknown = 0, type:unknown = "magma", opts:HazardOpts = {  }):
    if typeof(xOrOpts) == "object" and xOrOpts != nil:
      let o = xOrOpts
      X = o.X ?? o.x ?? 0
      Y = o.Y ?? o.y ?? 0
      Type = o.Type ?? o.type ?? "magma"
      Radius = Hazard.or(o.Radius ?? o.radius, 26)
      MaxLife = Hazard.or(o.Life ?? o.life, 3)
      Life = MaxLife
      Dps = Hazard.or(o.Dps ?? o.dps, 0)
      let ow = o.Owner ?? o.owner
      if ow != nil and ow.length > 0:
        Owner = ow
      else:
        Owner = "enemy"
      Telegraph = Hazard.or(o.Telegraph ?? o.telegraph, 0)
      TelegraphMax = Telegraph
      ImpactDamage = Hazard.or(o.ImpactDamage ?? o.impactDamage, 0)
    else:
      X = xOrOpts
      Y = y
      Type = type
      Radius = Hazard.or(opts.Radius ?? opts.radius, 26)
      MaxLife = Hazard.or(opts.Life ?? opts.life, 3)
      Life = MaxLife
      Dps = Hazard.or(opts.Dps ?? opts.dps, 0)
      let ow = opts.Owner ?? opts.owner
      if ow != nil and ow.length > 0:
        Owner = ow
      else:
        Owner = "enemy"
      Telegraph = Hazard.or(opts.Telegraph ?? opts.telegraph, 0)
      TelegraphMax = Telegraph
      ImpactDamage = Hazard.or(opts.ImpactDamage ?? opts.impactDamage, 0)
    Detonated = false
    Pulse = Rng.Shared.angle()
    Dead = false
  static fn or(v:Option[int], fallback:int) -> int:
    if v != undefined and not Number.isNaN(v):
      v
    else:
      fallback
  fn get_Armed() = Telegraph <= 0
  fn get_armed() = this.Armed
  fn Update(dt:int) :
    Pulse += dt * 5
    if Telegraph > 0:
      Telegraph -= dt
      if Telegraph <= 0:
        Telegraph = 0
      ret
    Life -= dt
    if Life <= 0:
      Dead = true
  fn update(dt:int) :
    this.Update(dt)
