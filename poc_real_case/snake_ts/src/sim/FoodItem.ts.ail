module poc_real_case/snake_ts/src/sim/FoodItem

from "../core/MathX.js" import MathX
from "../core/Rng.js" import Rng
from "../data/GameData.js" import GameData

pub class FoodItem:
  X:int, Y:int, Type:str, Color:str, XpValue:int
  ScoreValue:int, Radius:int, HealAmount:int, Vx:int, Vy:int
  Pulse:int, SpawnScale:int, Life:int, Dead:bool
  fn get_x() = X; fn set_x(v) = X = v
  fn get_y() = Y; fn set_y(v) = Y = v
  fn get_type() = Type; fn set_type(v) = Type = v
  fn get_color() = Color; fn set_color(v) = Color = v
  fn get_xpValue() = XpValue; fn set_xpValue(v) = XpValue = v
  fn get_scoreValue() = ScoreValue; fn set_scoreValue(v) = ScoreValue = v
  fn get_radius() = Radius; fn set_radius(v) = Radius = v
  fn get_healAmount() = HealAmount; fn set_healAmount(v) = HealAmount = v
  fn get_vx() = Vx; fn set_vx(v) = Vx = v
  fn get_vy() = Vy; fn set_vy(v) = Vy = v
  fn get_pulse() = Pulse; fn set_pulse(v) = Pulse = v
  fn get_spawnScale() = SpawnScale; fn set_spawnScale(v) = SpawnScale = v
  fn get_life() = Life; fn set_life(v) = Life = v
  fn get_dead() = Dead; fn set_dead(v) = Dead = v
  fn constructor(x:int, y:int, type:str):
    X = x
    Y = y
    if GameData.Foods.Has(type):
      Type = type
    else:
      Type = "apple"
    def := GameData.Foods.Get(Type) ?? GameData.Foods.Get("apple")
    Color = def.Color
    XpValue = def.Xp
    ScoreValue = def.Score
    Radius = def.Radius
    HealAmount = def.Heal
    Vx = Rng.Shared.range(-30, 30)
    Vy = Rng.Shared.range(-30, 30)
    Pulse = Rng.Shared.angle()
    SpawnScale = 0
    Life = 0
    Dead = false
  fn Cook() -> bool:
    if Type != "apple":
      ret false
    Type = "golden"
    def := GameData.Foods.Get("golden")
    Color = def.Color
    XpValue = def.Xp
    ScoreValue = def.Score
    Radius = def.Radius
    true
  fn cook() -> bool = this.Cook()
  fn Update(dt:int, px:int, py:int, magnetRadius:int, extraPull:int) :
    Pulse += dt * 4.2
    Life += dt
    if SpawnScale < 1:
      SpawnScale = Math.min(1, SpawnScale + dt * 5)
    dx := px - X
    dy := py - Y
    dist := MathX.safeLen(dx, dy)
    if dist < magnetRadius:
      force := 1 - dist / magnetRadius * 620
      Vx += dx / dist * force * dt
      Vy += dy / dist * force * dt
    if extraPull > 0:
      Vx += dx / dist * extraPull * dt
      Vy += dy / dist * extraPull * dt
    X += Vx * dt
    Y += Vy * dt
    drag := MathX.decay(0.92, dt)
    Vx *= drag
    Vy *= drag
  fn update(dt:int, px:int, py:int, magnetRadius:int, extraPull:int) :
    this.Update(dt, px, py, magnetRadius, extraPull)
