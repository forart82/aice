# dof.combat.LootRolls.cpp

fn calculateQualityLowerBound(qFloor:int) -> int:
  clampedFloor:int := clamp(qFloor, 0, 99)
  ret max(1, clampedFloor)

fn calculateItemLevelBounds(enemyLevel:int) -> [int]:
  upper:int := max(1, enemyLevel)
  lower:int := max(1, (enemyLevel + 1) / 2)
  ret [lower, upper]

fn calculateStatQualityLowerBound(biasFloor:int) -> int:
  floorVal:int := clamp(biasFloor, 0, 99)
  ret max(1, floorVal)
