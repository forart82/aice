# dof.combat.DamageFormula.cpp

type DamageResult:
  damage: float
  sumFaces: int
  productMultipliers: float
  dronMultiplier: float
  isCritical: bool

fn computeDamage(baseDamage:float, diceFaces:[int], diceMultipliers:[float], dronMultiplier:float, critMultiplier:float, isCritical:bool, diceProductFloor:float, damageFloor:float) -> DamageResult:
  sum:int ::= 0
  for face in diceFaces:
    sum = sum + face
  product:float ::= 1.0
  for mult in diceMultipliers:
    product = product * mult
  sumClamped:float ::= sum.toFloat()
  if sum < 1:
    sumClamped = 1.0
  productClamped:float ::= product
  if product < diceProductFloor:
    productClamped = diceProductFloor
  dronClamped:float ::= dronMultiplier
  if dronMultiplier < 1.0:
    dronClamped = 1.0
  damage:float ::= baseDamage * sumClamped * productClamped * dronClamped
  if damage < damageFloor:
    damage = damageFloor
  isCriticalApplied:bool := isCritical and (critMultiplier > 1.0)
  if isCriticalApplied:
    damage = damage * critMultiplier
  ret DamageResult(damage, sum, product, dronMultiplier, isCriticalApplied)
