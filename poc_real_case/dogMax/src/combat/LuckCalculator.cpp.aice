# dof.combat.LuckCalculator.cpp

fn sumLuck(luckPerDice:[int]) -> int:
  total:int ::= 0
  for luck in luckPerDice:
    total = total + luck
  ret total

fn qualityFloor(luckTotal:int, scale:float) -> int:
  if (luckTotal <= 0) or (scale <= 0.0):
    ret 0
  sqrtLuck:float := sqrt(luckTotal.toFloat())
  raw:int := floor(sqrtLuck * scale)
  ret clamp(raw, 0, 99)

fn effectiveMinFace(luckTotal:int, scale:float) -> int:
  if (luckTotal <= 0) or (scale <= 0.0):
    ret 1
  raw:int := floor(luckTotal.toFloat() * scale)
  ret max(1, raw)
