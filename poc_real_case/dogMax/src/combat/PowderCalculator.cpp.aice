# dof.combat.PowderCalculator.cpp

fn finaliseHarvest(statSum:float, statFactor:float, perDestroyCap:int) -> int:
  rounded:int := round(statSum * statFactor)
  ret clamp(rounded, 1, perDestroyCap)

fn calculateWeaponPowder(baseDamage:float, aps:float, crit:float, critChance:float, range:float, rangeScale:float, statFactor:float, perDestroyCap:int) -> int:
  sum:float := baseDamage + aps + crit + critChance + (range * rangeScale)
  ret finaliseHarvest(sum, statFactor, perDestroyCap)

fn calculateDicePowder(damageMultiplier:float, crit:float, critChance:float, critChanceScale:float, luck:int, statFactor:float, perDestroyCap:int) -> int:
  sum:float := damageMultiplier + crit + (critChance * critChanceScale) + luck.toFloat() + 1.0
  ret finaliseHarvest(sum, statFactor, perDestroyCap)
