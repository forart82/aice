# dof.combat.TierCadence.hpp

type TierCadencePair:
  rare: int
  uncommon: int

class TierCadence:
  bands: [TierCadencePair] = []

  fn quintileFor(progress:float) -> int:
    if progress <= 0.0:
      ret 0
    if progress >= 1.0:
      ret 4
    band:int := floor(progress * 5.0)
    ret clamp(band, 0, 4)

  fn cadenceFor(progress:float) -> TierCadencePair:
    idx:int := this.quintileFor(progress)
    ret this.bands[idx]
