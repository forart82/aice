# dof.combat.EnemyExplosion.cpp

type ExplosionRing:
  radius: float
  alpha: float

type ExplosionShard:
  offsetX: float
  offsetY: float
  rotationDegrees: float
  alpha: float

fn computeExplosionRing(lifetimeRatio:float, startRadius:float, endRadius:float, startAlpha:float) -> ExplosionRing:
  t:float := clamp(lifetimeRatio, 0.0, 1.0)
  rad:float := startRadius + ((endRadius - startRadius) * t)
  alp:float := max(0.0, startAlpha * (1.0 - t))
  ret ExplosionRing(rad, alp)

fn computeExplosionShard(shardIndex:int, shardCount:int, lifetimeRatio:float, speed:float, startAlpha:float, spinDegPerLifetime:float) -> ExplosionShard:
  if shardCount <= 0:
    ret ExplosionShard(0.0, 0.0, 0.0, 0.0)
  t:float := clamp(lifetimeRatio, 0.0, 1.0)
  angle:float := 6.28318530718 * (shardIndex.toFloat() / shardCount.toFloat())
  distance:float := max(0.0, speed * t)
  offX:float := cos(angle) * distance
  offY:float := sin(angle) * distance
  rot:float := spinDegPerLifetime * t
  alp:float := max(0.0, startAlpha * (1.0 - t))
  ret ExplosionShard(offX, offY, rot, alp)
