# dof.combat.EnemyLevelCurve.cpp

class EnemyLevelCurve:
  maxLevelValue: int = 99
  cumulative: [float] = []

  fn init(linearStep:float, linearEnd:int, exp1Factor:float, exp1End:int, exp2Factor:float, maxLvl:int) -> void:
    this.maxLevelValue = max(1, maxLvl)
    i:int ::= 0
    while i <= this.maxLevelValue:
      this.cumulative.push(0.0)
      i = i + 1

    lvl:int ::= 2
    while (lvl <= linearEnd) and (lvl <= this.maxLevelValue):
      this.cumulative[lvl] = this.cumulative[lvl - 1] + linearStep
      lvl = lvl + 1

    while (lvl <= exp1End) and (lvl <= this.maxLevelValue):
      exponent:float := (lvl - linearEnd).toFloat()
      step:float := linearStep * pow(exp1Factor, exponent)
      this.cumulative[lvl] = this.cumulative[lvl - 1] + step
      lvl = lvl + 1

    stepAtExp1End:float := linearStep * pow(exp1Factor, (exp1End - linearEnd).toFloat())
    while lvl <= this.maxLevelValue:
      exponent:float := (lvl - exp1End).toFloat()
      step:float := stepAtExp1End * pow(exp2Factor, exponent)
      this.cumulative[lvl] = this.cumulative[lvl - 1] + step
      lvl = lvl + 1

  fn levelFromDistance(distance:float) -> int:
    if distance <= 0.0:
      ret 1
    lvl:int ::= this.maxLevelValue
    while lvl >= 1:
      if distance >= this.cumulative[lvl]:
        ret lvl
      lvl = lvl - 1
    ret 1

  fn cumulativeForLevel(level:int) -> float:
    if level <= 1:
      ret 0.0
    if level > this.maxLevelValue:
      ret this.cumulative[this.maxLevelValue]
    ret this.cumulative[level]

  fn maxLevel() -> int:
    ret this.maxLevelValue
