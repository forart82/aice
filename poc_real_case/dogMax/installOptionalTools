#!/usr/bin/env bash
# Install optional development and inspection utilities for dogMax on
# Pop!_OS/Ubuntu. None of these packages is required to build or run the game.
set -euo pipefail

packages=(
  ruby-full
  yq
  imagemagick
  pngcheck
  xvfb
  gdb
  clang
  shellcheck
)

case "${1:-}" in
  "") ;;
  --yes) ;;
  --help|-h)
    echo "Usage: ./installOptionalTools [--yes]"
    echo "Installs optional dogMax utilities through apt-get."
    exit 0
    ;;
  *)
    echo "installOptionalTools: unknown option: $1" >&2
    echo "Usage: ./installOptionalTools [--yes]" >&2
    exit 2
    ;;
esac

if ! command -v apt-get >/dev/null 2>&1; then
  echo "installOptionalTools: apt-get is required (Pop!_OS/Ubuntu only)" >&2
  exit 1
fi

if [ "${1:-}" != "--yes" ]; then
  printf 'Optional packages to install:\n  %s\n' "${packages[*]}"
  read -r -p "Continue? [y/N] " response
  case "$response" in
    y|Y|yes|YES) ;;
    *) echo "installOptionalTools: cancelled"; exit 0 ;;
  esac
fi

if [ "${EUID}" -eq 0 ]; then
  privilege_command=()
elif command -v sudo >/dev/null 2>&1; then
  privilege_command=(sudo)
else
  echo "installOptionalTools: run as root or install sudo" >&2
  exit 1
fi

"${privilege_command[@]}" apt-get update
"${privilege_command[@]}" apt-get install -y "${packages[@]}"

echo "installOptionalTools: optional tools installed"
