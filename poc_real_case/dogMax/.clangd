# clangd configuration for dogmax — controls the diagnostics clangd surfaces
# live in editors / IDE-integrated agents. This is SEPARATE from .clang-tidy,
# which still governs explicit `clang-tidy -p build` lint runs and CI gates.
#
# Goal: kill the false-positive noise that clangd injects after every edit
# (IncludeCleaner "unused/missing include" heuristics and a couple of
# opinionated readability checks) WITHOUT losing the real bug-catching
# diagnostics (compiler errors, bugprone-*, clang-analyzer-*).

# NOTE: do NOT pin CompileFlags.CompilationDatabase to a relative "build" —
# git worktrees (.claude/worktrees/*) have no build/ of their own, so a
# relative pin makes clangd fail to load any database and fall back to
# flagless parsing, flooding every file with false "file not found" /
# "undeclared identifier" errors. clangd's default upward search already
# locates the main checkout's build/compile_commands.json, which is exactly
# what we want from both the main tree and any worktree.

Diagnostics:
  # IncludeCleaner is heuristic and notoriously wrong on transitive/SFML
  # and template headers — it produced the "cmath is not used directly"
  # false positive. Off for both directions.
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    # Remove the inline checks that fire as noise against this codebase's
    # conventions while keeping bugprone-* / clang-analyzer-* signal.
    # readability-inconsistent-declaration-parameter-name fired on a clean
    # ctor whose decl/def param names intentionally differ.
    Remove:
      - readability-inconsistent-declaration-parameter-name
