# Increments the game's build counter on every dogmax relink.
#
# Invoked from the dogmax POST_BUILD step (after the configs/assets copy) as:
#   cmake -DVERSION_BUILD_FILE=<build>/configs/version_build.yaml -P this
#
# The target file is DEST-ONLY: it does not exist in the source configs/ tree,
# so `cmake -E copy_directory configs -> build/configs` never overwrites it and
# the live counter survives the dogmax copy. render::VersionOverlay loads it
# like any other .yaml and reads VERSION_BUILD; it falls back to 0 when the
# file is absent.

if(NOT DEFINED VERSION_BUILD_FILE)
    message(FATAL_ERROR "BumpBuildNumber: VERSION_BUILD_FILE not set")
endif()

set(current_build 0)
if(EXISTS "${VERSION_BUILD_FILE}")
    file(READ "${VERSION_BUILD_FILE}" existing_contents)
    if(existing_contents MATCHES "VERSION_BUILD: ([0-9]+)")
        set(current_build "${CMAKE_MATCH_1}")
    endif()
endif()

math(EXPR next_build "${current_build} + 1")
string(TIMESTAMP buildTime "%Y-%m-%d %H:%M UTC" UTC)

file(WRITE "${VERSION_BUILD_FILE}"
"# AUTO-GENERATED by cmake/BumpBuildNumber.cmake on each dogmax relink.
# Dest-only (never committed to source configs/), so copy_directory leaves it
# intact and it never churns git. render::VersionOverlay reads VERSION_BUILD.
VERSION_BUILD: ${next_build}
VERSION_BUILD_TIME: ${buildTime}
")

message(STATUS "dogmax build number -> ${next_build} (${buildTime})")
