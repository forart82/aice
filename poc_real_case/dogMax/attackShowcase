#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: ./attackShowcase <pitchfork|longsword|greatsword|halberd|quarterstaff|knives|dagger|mace|warhammer|bigaxe> [game arguments...]" >&2
    exit 2
fi

weapon="${1,,}"
shift
case "$weapon" in
    pitchfork|longsword|greatsword|halberd|quarterstaff|knives|dagger|mace|warhammer|bigaxe) ;;
    *) echo "unknown weapon: $weapon" >&2; exit 2 ;;
esac

repo_dir="$(cd "$(dirname "$0")" && pwd)"
config_dir="$(mktemp -d /tmp/dogmax-attack-showcase.XXXXXX)"
trap 'rm -rf "$config_dir"' EXIT
cp -R "$repo_dir/configs/." "$config_dir/"

# One immortal test target, one enemy, one weapon, no dice. The normal manager,
# cooldown, wind-up, range check, damage attempt, indicators, audio, and VFX all
# remain live; only random loadout selection and population noise are removed.
sed -i 's/^ENEMY_ARMED_PROBABILITY:.*/ENEMY_ARMED_PROBABILITY: 1.0/' "$config_dir/enemy_combat.yaml"
sed -i 's/^ENEMY_MAX_WEAPONS:.*/ENEMY_MAX_WEAPONS: 1/' "$config_dir/enemy_combat.yaml"
sed -i 's/^ENEMY_WEAPON_COUNT_WEIGHT_1:.*/ENEMY_WEAPON_COUNT_WEIGHT_1: 1/' "$config_dir/enemy_combat.yaml"
sed -i 's/^ENEMY_WEAPON_COUNT_WEIGHT_2:.*/ENEMY_WEAPON_COUNT_WEIGHT_2: 0/' "$config_dir/enemy_combat.yaml"
sed -i 's/^ENEMY_DICE_COUNT_MIN:.*/ENEMY_DICE_COUNT_MIN: 0/' "$config_dir/enemy_combat.yaml"
sed -i 's/^ENEMY_DICE_COUNT_MAX:.*/ENEMY_DICE_COUNT_MAX: 0/' "$config_dir/enemy_combat.yaml"
sed -i 's/^ENEMY_DASH_OFFENSIVE_CHANCE:.*/ENEMY_DASH_OFFENSIVE_CHANCE: 0.0/' "$config_dir/enemy_dash.yaml"
sed -i 's/^ENEMY_JUMP_CHANCE:.*/ENEMY_JUMP_CHANCE: 0.0/' "$config_dir/enemy_mind.yaml"

binary="${DOGMAX_SHOWCASE_BINARY:-$repo_dir/build/dogmax}"
if [[ ! -x "$binary" ]]; then
    echo "release binary missing; run ./bt first" >&2
    exit 1
fi

echo "attack showcase: $weapon"
"$binary" --config-dir="$config_dir" --perf-enemies=1 \
    --attack-showcase-weapon="$weapon" "$@"
