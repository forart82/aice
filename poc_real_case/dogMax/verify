#!/usr/bin/env bash
# ============================================================================
# ./verify — the Automated Quality Gate (AGENTS.md Rule 14).
#
# The C++/SFML equivalent of the original protocol's `npm run verify`:
#   1. configure + build the test target with warnings-as-errors
#   2. run the full headless doctest suite through CTest
#   3. build the release game binary (the bundle-validation equivalent)
#
# Exits non-zero on ANY failure. A quality gate that can pass while something is
# broken is worse than no gate at all, because it manufactures confidence.
# ============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

GEN=""
if command -v ninja >/dev/null 2>&1; then GEN="-G Ninja"; fi

echo "── 1/3  configure + build tests ───────────────────────────────────────"
# shellcheck disable=SC2086
cmake -S . -B build-test $GEN -DDOGMAX_TESTS=ON -DCMAKE_BUILD_TYPE=Debug >/dev/null
cmake --build build-test --target dogmax_tests

echo "── 2/3  headless test suite ───────────────────────────────────────────"
ctest --test-dir build-test --output-on-failure

echo "── 3/3  release build ─────────────────────────────────────────────────"
# DOGMAX_NO_AUTORUN keeps the gate headless: a plain ./bt ends by launching a
# visible game window, which makes the gate unusable in CI or a background agent.
DOGMAX_NO_AUTORUN=1 ./bt >/dev/null

echo
echo "VERIFY PASSED — tests green, release build clean."
