# In-tree build outputs (when CMake is run from the repo root)
/dogmax

# Rotating build artifacts: ./bt copies each game build to the root as
# dogmax-<UTC timestamp> (last 5 kept). The binaries are transient, never tracked;
# the ./runGame launcher (previously .runGame) IS tracked.
/dogmax-*

# Reference / scratch artifacts
/test_shot.png

# Crash-handler dumps written on abort/SIGABRT — transient debugging artifacts
# from local runs, never build inputs or project content.
crash-dumps/

# Python bytecode cache
__pycache__/
*.pyc

# Compile databases
compile_commands.json
.cache/
.ccls-cache/

