coverage/
Testing/

# Logs / temp
*.log
tmp/

# Aperant data directory
.auto-claude/

# graphify-ts generated knowledge graph. Regenerate SCOPED TO src/ (never `.` —
# that pulls examples/designOne + third_party noise into the graph). The MCP reads
# the root graphify-out/, so copy the src-scoped output up:
#   graphify-ts generate src && rm -rf graphify-out && mv src/graphify-out graphify-out
graphify-out/
src/graphify-out/
/dogmax_smoke.png

# Merge-queue runtime coordination state (transient, never tracked)
.claude/MERGE_QUEUE
.claude/MERGE_QUEUE.tmp
.claude/MERGE_QUEUE.lock

# /cu deferred-snapshot coordination: a game-file merge flags SNAPSHOT_PENDING,
# and whoever drains the queue stamps the -O3 dogmax-<ts> snapshot once under
# SNAPSHOT.lock. Both transient, never tracked.
.claude/SNAPSHOT_PENDING
.claude/SNAPSHOT.lock

# Agent worktrees live here (git worktree add .claude/worktrees/<name>). They are
# transient per-agent checkouts, never committed — and being untracked they used
# to make `git status` on the primary report dirty, which false-tripped the /cu
# primary-clean safety gate. Ignore them.
.claude/worktrees/

# Obsidian editor workspace state for archived design drafts churns constantly
# (open panes, scroll positions) and is not project content.
archive/design-drafts/.obsidian/
