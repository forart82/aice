/* DogMax — inventory.rcss  ·  layout & chrome for the inventory document.
   Pairs with theme.rcss. RCSS notes: spacing uses margins (no `gap`); the panel
   uses straight neon borders (no clip-path); the 7x8 grid is built from 7 flex
   columns whose cells share 1px border lines (border-right/bottom) so there is
   NO gap — a die fills one cell, a weapon fills a 1-wide x 2-tall cell. */

/* ---- panel chrome ---- */
.panel {
  width: 530px;
  decorator: linear-gradient(160deg, #0e131d, #0a0d15);
  border: 1px #50e6ff59;
  box-shadow: 0px 0px 40px #00000099;
}
.titlebar {
  height: 30px;
  display: flex; align-items: center;
  padding: 0px 16px;
  decorator: linear-gradient(0deg, #50e6ff00, #50e6ff1f);
  border-bottom: 1px #50e6ff38;
}
.ttext {
  font-family: "Chakra Petch";
  font-weight: bold; font-size: 11px; letter-spacing: 3px;
  color: #50e6ff;
  font-effect: glow(2px #50e6ff);
}
.pbody { padding: 16px; display: block; }
.pbody > div { margin-bottom: 12px; }
.pbody > div:last-child { margin-bottom: 0px; }

/* ---- toolbar ---- */
.toolbar { display: flex; align-items: center; justify-content: space-between; }
.tabs { display: flex; }
.tab {
  display: flex; align-items: center; height: 22px; padding: 0px 10px;
  margin-right: 6px;
  font-weight: 600; font-size: 9px; letter-spacing: 1.2px;
  color: #8b93a6; background-color: #50e6ff10; border: 1px #50e6ff33;
}
.tab.on { color: #06223a; background-color: #50e6ff; border: 1px #50e6ffe6; }
.used { font-weight: 600; font-size: 9px; letter-spacing: 1px; color: #8b93a6; }

/* ---- main row: powder column + grid ---- */
.main { display: flex; align-items: stretch; }
.powder { width: 108px; margin-right: 12px; display: block; }
.powder > * { margin-bottom: 8px; }
.plabel { display: block; font-weight: 600; font-size: 8px; letter-spacing: 1.6px; color: #50e6ffb3; }

.pbtn { display: flex; align-items: center; padding: 7px 8px; background-color: #50c8ff0d; }
.shard { width: 16px; height: 16px; margin-right: 8px; transform: rotate(45deg);
  background-color: #ffffff1f; border: 2px #ffffff; }
.pbtext { display: block; }
.pn { display: block; font-weight: bold; font-size: 8.5px; letter-spacing: 0.8px; white-space: nowrap; }
.pd { display: block; font-weight: 500; font-size: 7.5px; color: #8b93a6; white-space: nowrap; }

.ptotal { display: flex; align-items: center; justify-content: space-between; }
.ptotaln { font-weight: bold; font-size: 9px; color: #ffffff; }

.stash { padding: 10px 8px; background-color: #080a1099; border: 1px #50e6ff24; display: block; }
.prow { display: flex; align-items: center; margin-bottom: 9px; }
.prow:last-child { margin-bottom: 0px; }
.pdot { width: 9px; height: 9px; margin-right: 6px; transform: rotate(45deg); }
.pname { width: 60px; font-weight: 600; font-size: 7px; color: #8b93a6; }
.pcount { font-weight: bold; font-size: 8.5px; color: #d6dce8; }

/* ---- the 7x8 grid (cells share borders, NO gap) ---- */
.grid { display: flex; border-top: 1px #50e6ff33; border-left: 1px #50e6ff33; background-color: #080a1080; }
.col { display: block; }
.cell {
  position: relative; width: 54px; height: 54px;
  border-right: 1px #50e6ff33; border-bottom: 1px #50e6ff33;
}
.cell.weapon { height: 108px; }
.cell.empty { background-color: #ffffff03; }

/* slot tier fill, inset so the grid lines stay visible (colours in theme.rcss) */
.slot {
  position: absolute; top: 3px; right: 3px; bottom: 3px; left: 3px;
  display: flex; align-items: center; justify-content: center;
}

/* weapon: glyph centred across its 2 cells; seam marks the cell boundary */
.wico { position: absolute; top: 0px; right: 0px; bottom: 0px; left: 0px;
  display: flex; align-items: center; justify-content: center; z-index: 2; }
.wpn { width: 38px; height: 38px; }
.seam { position: absolute; left: 0px; right: 0px; top: 50%; height: 1px;
  background-color: #50e6ff33; z-index: 1; }

/* dice diamond + upright number */
.die { width: 34px; height: 34px; transform: rotate(45deg);
  display: flex; align-items: center; justify-content: center;
  border: 2px #ffffff; background-color: #ffffff0f; }
.dn { transform: rotate(-45deg); font-weight: bold; font-size: 12px; color: #ffffff; }

/* equipped flag */
.eq { position: absolute; top: 3px; right: 3px; width: 5px; height: 5px; transform: rotate(45deg);
  background-color: #50e6ff; box-shadow: 0px 0px 5px #50e6ff; z-index: 3; }

/* ---- footer legend ---- */
.footer { display: flex; font-weight: 600; font-size: 8px; letter-spacing: 0.8px; color: #8b93a6; }
.fitem { margin-right: 16px; }
.fkey { color: #50e6ffcc; font-weight: bold; }
.fkey.eqk { color: #50e6ff; }
