/* DogMax — theme.rcss · shared tokens for the Weapon Slots sidebar (RmlUI).
   RCSS notes: no clip-path, no `gap` (use margins), gradients via `decorator`,
   text glow via `font-effect`, colours as #rrggbb / #rrggbbaa. Register fonts
   in C++ before loading:  Rml::LoadFontFace("JetBrainsMono-Bold.ttf"); etc. */

body { font-family: "JetBrains Mono"; color: #d6dce8; background-color: transparent; }

/* tier strip colour */
.t-common  .tier { background-color: #b4b4c8; box-shadow: 0px 0px 8px #b4b4c8; }
.t-uncommon .tier { background-color: #50c8ff; box-shadow: 0px 0px 8px #50c8ff; }
.t-rare    .tier { background-color: #ffd732; box-shadow: 0px 0px 8px #ffd732; }

/* charge-bar fill colour (gold overrides on a ready row) */
.t-common  .cfill { background-color: #b4b4c8; }
.t-uncommon .cfill { background-color: #50c8ff; }
.t-rare    .cfill { background-color: #ffd732; }
.row.ready .cfill { background-color: #ffd750; }

/* dice colours (diamond border + value number) */
.d-4  { border-color: #ff4646; } .d-4  .dn { color: #ff4646; }
.d-6  { border-color: #f0c846; } .d-6  .dn { color: #f0c846; }
.d-8  { border-color: #50dcf0; } .d-8  .dn { color: #50dcf0; }
.d-12 { border-color: #50f078; } .d-12 .dn { color: #50f078; }
.d-20 { border-color: #5090ff; } .d-20 .dn { color: #5090ff; }
