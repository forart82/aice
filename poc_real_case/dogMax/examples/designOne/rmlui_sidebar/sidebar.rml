<rml>
<head>
  <title>DogMax - Weapon Slots</title>
  <link type="text/rcss" href="theme.rcss"/>
  <link type="text/rcss" href="sidebar.rcss"/>
</head>
<body>
  <div class="panel">
    <div class="titlebar"><span class="ttext">WEAPON SLOTS</span></div>
    <div class="pbody">
      <div class="row t-rare ready">
        <div class="tier"></div>
        <div class="wzone">
          <svg src="icons/warhammer.svg" class="wpn"/>
          <span class="wname">Warhammer</span>
          <span class="wlv">LV 6</span>
        </div>
        <div class="dzone">
          <div class="dice"><div class="die d-6"><span class="dn">5</span></div><div class="die d-6"><span class="dn">5</span></div><div class="die d-6"><span class="dn">5</span></div><div class="die d-6"><span class="dn">5</span></div><div class="die d-6"><span class="dn">5</span></div><div class="die d-6"><span class="dn">5</span></div></div>
          <div class="charge"><div class="cfill" style="width:100%;"></div></div>
        </div>
        <div class="dron"><span class="dmult">x40</span><span class="dlabel" style="color:#ffd750;">HEXADRON</span></div>
      </div>
      <div class="row t-uncommon">
        <div class="tier"></div>
        <div class="wzone">
          <svg src="icons/big_axe.svg" class="wpn"/>
          <span class="wname">Big Axe</span>
          <span class="wlv">LV 4</span>
        </div>
        <div class="dzone">
          <div class="dice"><div class="die d-8"><span class="dn">4</span></div><div class="die d-8"><span class="dn">4</span></div><div class="die d-8"><span class="dn">4</span></div><div class="die d-12"><span class="dn">9</span></div><div class="die d-12"><span class="dn">7</span></div><div class="die d-20"><span class="dn">11</span></div></div>
          <div class="charge"><div class="cfill" style="width:66%;"></div></div>
        </div>
        <div class="dron"><span class="dmult">x6</span><span class="dlabel" style="color:#f0c878;">TRIDRON</span></div>
      </div>
      <div class="row t-uncommon">
        <div class="tier"></div>
        <div class="wzone">
          <svg src="icons/long_sword.svg" class="wpn"/>
          <span class="wname">Long Sword</span>
          <span class="wlv">LV 3</span>
        </div>
        <div class="dzone">
          <div class="dice"><div class="die d-4"><span class="dn">3</span></div><div class="die d-4"><span class="dn">3</span></div><div class="die empty"></div></div>
          <div class="charge"><div class="cfill" style="width:30%;"></div></div>
        </div>
        <div class="dron"><span class="rolling">ROLLING</span></div>
      </div>
      <div class="row t-common">
        <div class="tier"></div>
        <div class="wzone">
          <svg src="icons/knives.svg" class="wpn"/>
          <span class="wname">Knives</span>
          <span class="wlv">LV 2</span>
        </div>
        <div class="dzone">
          <div class="dice"><div class="die d-4"><span class="dn">3</span></div><div class="die d-6"><span class="dn">3</span></div><div class="die d-8"><span class="dn">7</span></div><div class="die d-4"><span class="dn">1</span></div><div class="die d-6"><span class="dn">5</span></div></div>
          <div class="charge"><div class="cfill" style="width:50%;"></div></div>
        </div>
        <div class="dron"><span class="dmult">x2</span><span class="dlabel" style="color:#dc965a;">DUODRON</span></div>
      </div>
      <div class="row t-common">
        <div class="tier"></div>
        <div class="wzone">
          <svg src="icons/halberd.svg" class="wpn"/>
          <span class="wname">Halberd</span>
          <span class="wlv">LV 2</span>
        </div>
        <div class="dzone">
          <div class="dice"><div class="die d-20"><span class="dn">14</span></div><div class="die empty"></div><div class="die empty"></div><div class="die empty"></div></div>
          <div class="charge"><div class="cfill" style="width:15%;"></div></div>
        </div>
        <div class="dron"><span class="rolling">ROLLING</span></div>
      </div>
      <div class="row t-common">
        <div class="tier"></div>
        <div class="wzone">
          <svg src="icons/quarterstaff.svg" class="wpn"/>
          <span class="wname">Quarterstaff</span>
          <span class="wlv">LV 1</span>
        </div>
        <div class="dzone">
          <div class="dice"><div class="die d-20"><span class="dn">7</span></div><div class="die empty"></div><div class="die empty"></div></div>
          <div class="charge"><div class="cfill" style="width:80%;"></div></div>
        </div>
        <div class="dron"><span class="rolling">ROLLING</span></div>
      </div>
      <div class="row t-uncommon">
        <div class="tier"></div>
        <div class="wzone">
          <svg src="icons/dagger.svg" class="wpn"/>
          <span class="wname">Dagger</span>
          <span class="wlv">LV 1</span>
        </div>
        <div class="dzone">
          <div class="dice"><div class="die d-4"><span class="dn">2</span></div><div class="die d-4"><span class="dn">2</span></div><div class="die empty"></div><div class="die disabled"></div><div class="die disabled"></div></div>
          <div class="charge"><div class="cfill" style="width:40%;"></div></div>
        </div>
        <div class="dron"><span class="rolling">ROLLING</span></div>
      </div>
      <div class="row t-common">
        <div class="tier"></div>
        <div class="wzone">
          <svg src="icons/pitchfork.svg" class="wpn"/>
          <span class="wname">Pitchfork</span>
          <span class="wlv">LV 1</span>
        </div>
        <div class="dzone">
          <div class="dice"><div class="die d-4"><span class="dn">3</span></div><div class="die empty"></div></div>
          <div class="charge"><div class="cfill" style="width:60%;"></div></div>
        </div>
        <div class="dron"><span class="rolling">ROLLING</span></div>
      </div>
    </div>
  </div>
</body>
</rml>
