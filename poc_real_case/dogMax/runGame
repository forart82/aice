#!/usr/bin/env bash
# Launch the most recently copied game build.
#
# ./bt copies each game build to the repo root as dogmax-<UTC timestamp> and keeps
# the last 5. This script finds the newest such snapshot and runs it.
#
# Config resolution is EXE-RELATIVE, not cwd-relative: AppOptions derives the
# config directory from argv[0]'s parent (see src/app/AppOptions.cpp). Since the
# snapshot binary lives at the repo root, that would resolve to the SOURCE
# configs/ — which lacks the dest-only build/configs/version_build.yaml, so the
# on-screen version HUD would read v0.1.0 with no build number/timestamp.
# We therefore point the snapshot at build/configs/ explicitly with --config-dir,
# AND launch from build/ (assets + any other cwd-relative paths resolve there).
set -e

cd "$(dirname "$0")"

latest=$(ls -1t dogmax-* 2>/dev/null | head -1)
if [ -z "$latest" ]; then
  # If no pre-compiled executable snapshot matches the naming pattern `dogmax-*`,
  # we cannot launch the game. We abort execution and direct the user to build first
  # using `./bt`, which compiles the binary and stages it in the workspace root.
  echo "runGame: no dogmax-<timestamp> snapshot found at repo root — run ./bt first" >&2
  exit 1
fi
if [ ! -d build ]; then
  # The game requires configurations and asset files relative to its working directory.
  # These are populated inside `build/` by CMake's POST_BUILD steps. If `build/` is
  # missing, the game binary will fail to find its assets upon loading.
  echo "runGame: build/ is missing (needs configs+assets) — run ./bt first" >&2
  exit 1
fi

# Print status information to stdout indicating which dated build artifact is being run.
echo "runGame: launching $latest"
# Resolve the snapshot + the build/configs dir to absolute paths BEFORE cd, then
# run from build/ with config resolution pinned to build/configs (see header).
snapshot="$PWD/$latest"
configdir="$PWD/build/configs"
cd build
exec "$snapshot" --config-dir="$configdir" "$@"
