type Dimension: key:!s, value:!s
type MetricPoint: metricName:!s, metricValue:!f, unit:!s, timestampNano:!i, dimensions:[Dimension]
type SpanContext: traceId:!s, spanId:!s, parentSpanId:!s, sampled:!b
type LogRecord: logId:!s, level:!s, message:!s, serviceName:!s, timestampMs:!i, spanContext:SpanContext
type SensorReading: sensorId:!s, deviceType:!s, temperatureCelsius:!f, pressureKPa:!f, humidityPercent:!f, batteryVolts:!f, timestampSeconds:!i
type DeviceMetadata: deviceId:!s, firmwareVersion:!s, hardwareRevision:!s, locationZone:!s, isOnline:!b, lastHeartbeatTimestamp:!i
type PartitionKey: partitionId:!i, shardKey:!s, assignedBrokerId:!s, replicaCount:!i
type BatchMetadata: batchId:!s, recordCount:!i, byteSize:!i, compressedByteSize:!i, codec:!s, createdTimestamp:!i
type SchemaDefinition: schemaName:!s, versionMajor:!i, versionMinor:!i, compatibilityMode:!s, isLocked:!b
type DataQualityReport: reportId:!s, totalRecordsChecked:!i, nullValueCount:!i, schemaViolations:!i, outlierCount:!i, passedQualityScore:!i, isApprovedForPublishing:!b
type AggregationBucket: bucketId:!s, metricName:!s, startEpochSeconds:!i, endEpochSeconds:!i, count:!i, sumValue:!f, minValue:!f, maxValue:!f
type TimeSeriesSummary: metricName:!s, bucketStart:!i, pointCount:!i, mean:!f, stdDev:!f, p50:!f, p95:!f, p99:!f
type AnomalyThreshold: metricName:!s, warningLevel:!f, criticalLevel:!f, consecutiveWindowCount:!i
type AlertRule: ruleId:!s, metricName:!s, condition:!s, threshold:!f, durationSeconds:!i, targetChannel:!s, isActive:!b
type SinkConfig: sinkId:!s, destinationType:!s, endpointUrl:!s, batchSizeLimit:!i, flushIntervalMs:!i, maxRetries:!i
type PipelineCheckpoint: pipelineId:!s, sourceOffset:!i, processedRecordCount:!i, savedTimestamp:!i, checkpointDigest:!s
type RetryPolicy: maxAttempts:!i, initialDelayMs:!i, backoffMultiplier:!i, maxDelayMs:!i
type ThroughputStats: sourceId:!s, recordsPerSecond:!i, bytesPerSecond:!i, droppedRecords:!i, lagSeconds:!i

fn createDimension(k:!s, v:!s) -> Dimension = Dimension(k, v)

fn createMetricPoint(name:!s, numericVal:!f, unit:!s, nowNano:!i) -> MetricPoint = MetricPoint(name, numericVal, unit, nowNano, [])

fn formatMetricKey(metric:MetricPoint) -> !s = metric.metricName + ":" + metric.unit

fn parseLogLevel(raw:!s) -> !s:
  clean := raw.trim()
  if clean == "DEBUG" or clean == "INFO" or clean == "WARN" or clean == "ERROR" or clean == "FATAL":
    ret clean
  ret "INFO"

fn isErrorLog(log:LogRecord) -> !b = log.level == "ERROR" or log.level == "FATAL"

fn shouldSampleTrace(traceId:!s, sampleRateBasisPoints:!i) -> !b:
  if sampleRateBasisPoints >= 10000:
    ret true
  if sampleRateBasisPoints <= 0:
    ret false
  ret traceId.len > 0

fn celsiusToFahrenheit(celsius:!f) -> !f = (celsius * 1.8) + 32.0

fn fahrenheitToCelsius(fahrenheit:!f) -> !f = (fahrenheit - 32.0) / 1.8

fn isDeviceStale(device:DeviceMetadata, currentTimestamp:!i, timeoutSeconds:!i) -> !b:
  if not device.isOnline:
    ret true
  elapsed := currentTimestamp - device.lastHeartbeatTimestamp
  ret elapsed > timeoutSeconds

fn computeCompressionRatioBps(originalBytes:!i, compressedBytes:!i) -> !i:
  if originalBytes == 0:
    ret 10000
  ret ((compressedBytes * 10000) / originalBytes).floor()

fn computeMovingAverage(values:[!f]) -> !f:
  if values.len == 0:
    ret 0.0
  sum ::= 0.0
  for v in values:
    sum = sum + v
  ret sum / (values.len * 1.0)

fn isOutlierReading(reading:SensorReading, maxAllowedTemp:!f, minAllowedTemp:!f) -> !b:
  if reading.temperatureCelsius > maxAllowedTemp:
    ret true
  if reading.temperatureCelsius < minAllowedTemp:
    ret true
  if reading.humidityPercent < 0.0 or reading.humidityPercent > 100.0:
    ret true
  ret false

fn calculatePartitionSlot(shardKey:!s, partitionCount:!i) -> !i:
  if partitionCount <= 1:
    ret 0
  length := shardKey.len
  ret length % partitionCount

fn validateSchemaVersion(schema:SchemaDefinition, requiredMajor:!i) -> !b:
  if schema.versionMajor != requiredMajor:
    ret false
  ret not schema.isLocked

fn evaluateQualityScore(totalRecords:!i, errorCount:!i) -> !i:
  if totalRecords == 0:
    ret 100
  validRecords := totalRecords - errorCount
  if validRecords < 0:
    ret 0
  ret ((validRecords * 100) / totalRecords).floor()

fn createQualityReport(reportId:!s, checked:!i, nulls:!i, violations:!i, outliers:!i) -> DataQualityReport:
  totalErrors := nulls + violations + outliers
  score := evaluateQualityScore(checked, totalErrors)
  isApproved := score >= 85
  report := DataQualityReport(reportId, checked, nulls, violations, outliers, score, isApproved)
  report

fn initAggregationBucket(bucketId:!s, metricName:!s, startEpoch:!i, endEpoch:!i) -> AggregationBucket:
  bucket := AggregationBucket(bucketId, metricName, startEpoch, endEpoch, 0, 0.0, 999999999.0, -999999999.0)
  bucket

fn updateAggregationBucket(bucket:AggregationBucket, incomingValue:!f) -> AggregationBucket:
  minVal ::= bucket.minValue
  if incomingValue < minVal:
    minVal = incomingValue
  maxVal ::= bucket.maxValue
  if incomingValue > maxVal:
    maxVal = incomingValue
  updated := {
    ...bucket,
    count: bucket.count + 1,
    sumValue: bucket.sumValue + incomingValue,
    minValue: minVal,
    maxValue: maxVal
  }
  updated

fn computeBucketMean(bucket:AggregationBucket) -> !f:
  if bucket.count == 0:
    ret 0.0
  bucket.sumValue / (bucket.count * 1.0)

fn createTimeSeriesSummary(bucket:AggregationBucket) -> TimeSeriesSummary:
  meanVal := computeBucketMean(bucket)
  summary := TimeSeriesSummary(bucket.metricName, bucket.startEpochSeconds, bucket.count, meanVal, 0.0, meanVal, bucket.maxValue, bucket.maxValue)
  summary

fn shouldTriggerAlert(summary:TimeSeriesSummary, rule:AlertRule) -> !b:
  if not rule.isActive:
    ret false
  if summary.metricName != rule.metricName:
    ret false
  if rule.condition == "GT":
    ret summary.mean > rule.threshold
  elif rule.condition == "LT":
    ret summary.mean < rule.threshold
  elif rule.condition == "GTE":
    ret summary.mean >= rule.threshold
  elif rule.condition == "LTE":
    ret summary.mean <= rule.threshold
  else:
    ret false

fn calculateExponentialBackoffMs(attempt:!i, policy:RetryPolicy) -> !i:
  if attempt <= 1:
    ret policy.initialDelayMs
  delay ::= policy.initialDelayMs
  i ::= 1
  while i < attempt:
    delay = delay * policy.backoffMultiplier
    i = i + 1
  if delay > policy.maxDelayMs:
    ret policy.maxDelayMs
  ret delay

fn isSinkFlushDue(recordCount:!i, elapsedMs:!i, config:SinkConfig) -> !b:
  if recordCount >= config.batchSizeLimit:
    ret true
  if elapsedMs >= config.flushIntervalMs and recordCount > 0:
    ret true
  ret false

fn createCheckpoint(pipelineId:!s, offset:!i, recordCount:!i, now:!i) -> PipelineCheckpoint:
  digest := pipelineId + "-" + offset.toString() + "-" + now.toString()
  cp := PipelineCheckpoint(pipelineId, offset, recordCount, now, digest)
  cp

fn verifyCheckpointIntegrity(cp:PipelineCheckpoint) -> bool:
  if cp.sourceOffset < 0:
    ret false
  if cp.processedRecordCount < 0:
    ret false
  if cp.checkpointDigest.len == 0:
    ret false
  ret true

fn calculateThroughputLag(stats:ThroughputStats, thresholdLagSeconds:int) -> bool = stats.lagSeconds > thresholdLagSeconds

fn computeAverageRecordSize(byteSize:int, count:int) -> int:
  if count == 0:
    ret 0
  ret (byteSize / count).floor()

fn sanitizeLogMessage(rawMessage:str) -> str:
  clean := rawMessage.trim()
  if clean.len > 1024:
    ret clean.slice(0, 1024)
  ret clean

fn parseDeviceZone(zone:str) -> str:
  clean := zone.trim()
  if clean == "US_EAST" or clean == "US_WEST" or clean == "EU_CENTRAL" or clean == "AP_SOUTH":
    ret clean
  ret "GLOBAL_DEFAULT"

fn isBatteryLevelCritical(batteryVolts:float, cutoffVolts:float) -> bool = batteryVolts <= cutoffVolts

fn evaluatePipelineHealth(droppedRecords:int, errorLogs:int) -> str:
  if droppedRecords > 1000 or errorLogs > 100:
    ret "CRITICAL"
  if droppedRecords > 100 or errorLogs > 10:
    ret "DEGRADED"
  ret "HEALTHY"

fn generateAlertFingerprint(ruleId:str, metricName:str, timestampWindow:int) -> str = "FP-" + ruleId + "-" + metricName + "-" + timestampWindow.toString()

fn createDefaultRetryPolicy() -> RetryPolicy:
  pol := RetryPolicy(5, 200, 2, 10000)
  pol

fn createDefaultSinkConfig(endpoint:!s) -> SinkConfig:
  cfg := SinkConfig("DEFAULT_SINK", "CLICKHOUSE", endpoint, 1000, 5000, 3)
  cfg

fn formatThroughputTelemetry(stats:ThroughputStats) -> !s = "Source " + stats.sourceId + ": " + stats.recordsPerSecond.toString() + " rec/s, " + stats.bytesPerSecond.toString() + " B/s, Lag: " + stats.lagSeconds.toString() + "s"

fn calculateWindowDurationSeconds(startEpoch:!i, endEpoch:!i) -> !i = endEpoch - startEpoch

fn isWindowComplete(windowStart:!i, windowSizeSeconds:!i, currentEpoch:!i) -> !b = currentEpoch >= (windowStart + windowSizeSeconds)

fn createAlertRule(ruleId:!s, metric:!s, cond:!s, thresh:!f, chan:!s) -> AlertRule:
  rule := AlertRule(ruleId, metric, cond, thresh, 60, chan, true)
  rule

fn toggleAlertRule(rule:AlertRule, activeState:!b) -> AlertRule:
  updated := { ...rule, isActive: activeState }
  updated

fn computeSignalToNoiseRatio(signalPower:!f, noisePower:!f) -> !f:
  if noisePower <= 0.0:
    ret 999.0
  ret signalPower / noisePower

fn evaluateDeviceHealthIndex(readings:[SensorReading], maxTemp:!f) -> !i:
  if readings.len == 0:
    ret 100
  anomalousCount ::= 0
  for r in readings:
    if r.temperatureCelsius > maxTemp:
      anomalousCount = anomalousCount + 1
  goodCount := readings.len - anomalousCount
  ret ((goodCount * 100) / readings.len).floor()

fn generateBatchSummary(batch:BatchMetadata) -> !s:
  ratio := computeCompressionRatioBps(batch.byteSize, batch.compressedByteSize)
  ret "Batch " + batch.batchId + ": " + batch.recordCount.toString() + " records (" + batch.byteSize.toString() + " bytes -> " + batch.compressedByteSize.toString() + " bytes, ratio: " + ratio.toString() + " bps)"

fn shouldCompactCheckpoints(lastCheckpointTimestamp:!i, nowTimestamp:!i, retentionSeconds:!i) -> !b = (nowTimestamp - lastCheckpointTimestamp) > retentionSeconds

fn createSensorReading(sensorId:!s, devType:!s, temp:!f, pressure:!f, hum:!f, batt:!f, now:!i) -> SensorReading = SensorReading(sensorId, devType, temp, pressure, hum, batt, now)

fn buildLogRecord(logId:!s, lvl:!s, msg:!s, svc:!s, nowMs:!i, traceId:!s, spanId:!s) -> LogRecord:
  span := SpanContext(traceId, spanId, "", true)
  ret LogRecord(logId, parseLogLevel(lvl), sanitizeLogMessage(msg), svc, nowMs, span)

type SinkHealthRecord: sinkId:!s, endpointUrl:!s, latencyMs:!i, isHealthy:!b, consecutiveFailures:!i, lastCheckedTimestamp:!i
type DeadLetterRecord: recordId:!s, originalSource:!s, payloadDigest:!s, failureReason:!s, retryCount:!i, failedAtTimestamp:!i

fn createSinkHealthRecord(sId:!s, url:!s, latency:!i, ok:!b, fails:!i, now:!i) -> SinkHealthRecord:
  r := SinkHealthRecord(sId, url, latency, ok, fails, now)
  r

fn isSinkDegraded(health:SinkHealthRecord, maxAcceptableLatencyMs:!i) -> !b:
  if health.isHealthy == false:
    ret true
  if health.latencyMs > maxAcceptableLatencyMs:
    ret true
  if health.consecutiveFailures > 2:
    ret true
  ret false

fn buildDeadLetterRecord(recId:!s, src:!s, digest:!s, reason:!s, retries:!i, now:!i) -> DeadLetterRecord:
  dlq := DeadLetterRecord(recId, src, digest, reason, retries, now)
  dlq

fn shouldQuarantineDeadLetter(dlq:DeadLetterRecord, maxAllowedRetries:!i) -> !b = dlq.retryCount >= maxAllowedRetries

fn validatePartitionDistribution(partitionCount:!i, activeBrokers:!i) -> !b:
  if activeBrokers <= 0:
    ret false
  if partitionCount <= 0:
    ret false
  ret partitionCount >= activeBrokers

fn estimatePartitionCapacity(totalPartitions:!i, maxRecordsPerPartition:!i) -> !i = totalPartitions * maxRecordsPerPartition
