type HealthResponse:
  status: str
  uptime: int
  version: str

type Config:
  host: str
  port: int
  debug: bool

fn checkStatus(healthy: bool) -> str:
  if healthy:
    ret "HEALTHY"
  else:
    ret "DEGRADED"

fn getSystemHealth(uptimeSeconds: int) -> HealthResponse:
  let statusText = checkStatus(uptimeSeconds > 0)
  let res = {
    status: statusText,
    uptime: uptimeSeconds,
    version: "2.0.0"
  }
  ret res
