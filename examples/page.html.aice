component LandingPage():
  html(lang: "en"):
    head:
      meta(charset: "utf-8")
      meta(name: "viewport", content: "width=device-width, initial-scale=1")
      title: "AICE 2.0 Web Application"
      link(rel: "stylesheet", href: "style.css")
    body:
      header.site-header:
        h1: "Welcome to AICE"
        p: "The high-entropy token-efficient programming language."
      main.content:
        section.features:
          h2: "Features"
          p: "Lossless roundtripping and zero-hallucination canonical APIs."
