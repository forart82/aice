module examples/auth_service

type UserSession:
  sessionId:str
  userId:str
  role:str
  createdAt:int

type AuthRequest:
  username:str
  password:str
  rememberMe:bool

fn sanitize(raw:str) -> str = raw.slice(0, 24)

fn validatePassword(pass:str) -> unknown | unknown:
  if pass.length < 8:
    ret { ok: false, error: "Password too short" }
  { ok: true, value: true }

fn authenticateUser(req:AuthRequest) -> unknown | unknown:
  let valid = validatePassword(req.password).value
  let cleanUser = sanitize(req.username)
  let session = { sessionId: "sess_" + cleanUser, userId: cleanUser, role: "member", createdAt: 1711929600 }
  { ok: true, value: session }
