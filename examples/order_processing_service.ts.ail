from "./ecommerce_domain.js" import Address, Money, TaxRate, DiscountCode, ProductVariant, InventoryItem, CustomerProfile, CartItem, ShoppingCart, ShippingRate, PaymentDetails, FraudScore, AuditEntry, InvoiceItem, InvoiceSummary, WarehouseLocation, CarrierConfig, createMoney, formatCurrency, addMoney, subtractMoney, multiplyMoney, calculateSalesTax, validateSku, calculateDiscount, evaluateCustomerTier, calculateLoyaltyPoints, isStockAvailable, reserveStock, releaseStock, commitStock, checkReorderNeeded, calculateItemTotal, calculateCartSubtotalCents, calculateCartWeightGrams, calculateShippingCost, validateOrderTransition, calculateRiskScore, generateInvoiceNumber, calculateLineItemTotal, buildInvoiceSummary, formatAuditEntry, isWarehouseOverCapacity, calculateWarehouseLoadPercent, generateTrackingUrl, createCustomer, updateCustomerSpend, suspendCustomer, reinstateCustomer, sanitizeAddress, isDomesticShipment, estimateDeliveryDate, createProductVariant, createDigitalProductVariant, computeBulkDiscount, calculateFinalCartItemPrice, isEligibleForFreeShipping, applyTaxExemption, calculateCompoundedTax, formatReceiptLine, parseCurrencyCode, calculateRestockingFee, computeNetRefundCents

type CheckoutSession: sessionId:!s, cartId:!s, customerId:!s, shippingAddress:Address, billingAddress:Address, selectedCarrier:!s, promoCode:!s, createdAtTimestamp:!i, expiresAtTimestamp:!i, isCompleted:!b
type OrderValidationResult: isValid:!b, blockingErrors:[!s], warningNotes:[!s], subtotalCents:!i, taxCents:!i, shippingCents:!i, discountCents:!i, finalTotalCents:!i
type PaymentTransaction: transactionId:!s, orderId:!s, provider:!s, amountCents:!i, status:!s, authCode:!s, capturedAtTimestamp:!i
type WarehouseAllocation: orderId:!s, sku:!s, allocatedWarehouseId:!s, allocatedQuantity:!i, routePriority:!i
type FulfillmentBatch: batchId:!s, warehouseId:!s, assignedCarrier:!s, orderIds:[!s], totalPackages:!i, isDispatched:!b, dispatchedTimestamp:!i
type ShippingManifest: manifestId:!s, carrierCode:!s, trackingNumbers:[!s], totalWeightGrams:!i, destinationHub:!s, generatedTimestamp:!i
type RefundRequest: refundId:!s, orderId:!s, customerId:!s, itemSkus:[!s], reason:!s, requestedAmountCents:!i, isRestockingFeeApplied:!b
type RefundReceipt: receiptId:!s, orderId:!s, refundedCents:!i, restockingFeeCents:!i, issuedTimestamp:!i, gatewayReference:!s
type OrderNotification: notificationId:!s, recipientEmail:!s, subject:!s, bodyText:!s, channel:!s, isSent:!b
type DisputeRecord: disputeId:!s, orderId:!s, chargebackCents:!i, reasonCode:!s, evidenceDueDate:!i, isResolved:!b
type BatchShipmentSummary: batchId:!s, successfulCount:!i, failedCount:!i, totalPostageCents:!i
type DailyFulfillmentMetrics: dateKey:!s, ordersReceived:!i, ordersDispatched:!i, ordersDelivered:!i, averageProcessingMinutes:!i, grossRevenueCents:!i
type SlaEvaluationResult: orderId:!s, targetDispatchTimestamp:!i, isBreached:!b, breachReason:!s

type ReconciliationReport: reportId:!s, batchId:!s, expectedTotalCents:!i, settledTotalCents:!i, discrepancyCents:!i, isBalanced:!b

fn createCheckoutSession(sessId: str, cart: ShoppingCart, shipAddr: Address, billAddr: Address, now: int) -> CheckoutSession:
  let session = {
    sessionId: sessId,
    cartId: cart.cartId,
    customerId: cart.customerId,
    shippingAddress: shipAddr,
    billingAddress: billAddr,
    selectedCarrier: "STANDARD_GROUND",
    promoCode: cart.appliedDiscount,
    createdAtTimestamp: now,
    expiresAtTimestamp: now + 3600,
    isCompleted: false
  }
  session

fn isSessionExpired(session: CheckoutSession, now: int) -> bool = now > session.expiresAtTimestamp

fn validateCheckoutItems(items: [CartItem]) -> Result[bool, str]:
  if items.len == 0:
    ret Err("Cart cannot be empty for checkout")
  for item in items:
    if item.quantity <= 0:
      ret Err("Invalid item quantity")
    if item.unitPriceCents < 0:
      ret Err("Invalid unit price")
  Ok(true)

fn validateSession(session: CheckoutSession, cart: ShoppingCart, now: int) -> OrderValidationResult:
  let mut errors: [str] = []
  let mut warnings: [str] = []
  if isSessionExpired(session, now):
    errors = errors.append("Checkout session expired")
  if cart.items.len == 0:
    errors = errors.append("Shopping cart is empty")
  let subtotal = calculateCartSubtotalCents(cart.items)
  if subtotal > 5000000:
    warnings = warnings.append("Large order requires secondary fraud review")
  let mut valid = true
  if errors.len > 0:
    valid = false
  let res = {
    isValid: valid,
    blockingErrors: errors,
    warningNotes: warnings,
    subtotalCents: subtotal,
    taxCents: 0,
    shippingCents: 0,
    discountCents: 0,
    finalTotalCents: subtotal
  }
  res

fn resolveBestWarehouse(sku: str, requiredQty: int, warehouses: [WarehouseLocation]) -> Result[str, str]:
  let mut bestWarehouse = ""
  let mut lowestLoad = 1000
  for wh in warehouses:
    if not isWarehouseOverCapacity(wh):
      let load = calculateWarehouseLoadPercent(wh)
      if load < lowestLoad:
        lowestLoad = load
        bestWarehouse = wh.warehouseId
  if bestWarehouse.len == 0:
    ret Err("No warehouse with available capacity found")
  Ok(bestWarehouse)

fn allocateOrderInventory(orderId: str, items: [CartItem], warehouses: [WarehouseLocation]) -> Result[[WarehouseAllocation], str]:
  let mut allocations: [WarehouseAllocation] = []
  for item in items:
    let whId = resolveBestWarehouse(item.sku, item.quantity, warehouses)?
    let alloc = {
      orderId: orderId,
      sku: item.sku,
      allocatedWarehouseId: whId,
      allocatedQuantity: item.quantity,
      routePriority: 1
    }
    allocations = allocations.append(alloc)
  Ok(allocations)

fn processCardPayment(txId: str, orderId: str, provider: str, amountCents: int, now: int) -> Result[PaymentTransaction, str]:
  if amountCents <= 0:
    ret Err("Payment amount must be positive")
  let tx = {
    transactionId: txId,
    orderId,
    provider,
    amountCents,
    status: "CAPTURED",
    authCode: "AUTH-" + txId,
    capturedAtTimestamp: now
  }
  Ok(tx)

fn voidPayment(tx: PaymentTransaction) -> PaymentTransaction:
  let updated = { ...tx, status: "VOIDED" }
  updated

fn evaluateOrderRisk(profile: CustomerProfile, totalCents: int, isDomestic: bool) -> FraudScore = calculateRiskScore(profile, totalCents, not isDomestic)

fn prepareFulfillmentBatch(batchId: str, whId: str, carrier: str, orders: [str], now: int) -> FulfillmentBatch:
  let batch = {
    batchId,
    warehouseId: whId,
    assignedCarrier: carrier,
    orderIds: orders,
    totalPackages: orders.len,
    isDispatched: false,
    dispatchedTimestamp: 0
  }
  batch

fn dispatchFulfillmentBatch(batch: FulfillmentBatch, now: int) -> FulfillmentBatch:
  let updated = { ...batch, isDispatched: true, dispatchedTimestamp: now }
  updated

fn createShippingManifest(manifestId: str, carrier: str, trackingNums: [str], weightGrams: int, hub: str, now: int) -> ShippingManifest:
  let manifest = {
    manifestId,
    carrierCode: carrier,
    trackingNumbers: trackingNums,
    totalWeightGrams: weightGrams,
    destinationHub: hub,
    generatedTimestamp: now
  }
  manifest

fn processCustomerRefund(request: RefundRequest, isOpened: bool, now: int) -> RefundReceipt:
  let mut fee = 0
  if request.isRestockingFeeApplied:
    fee = calculateRestockingFee(request.requestedAmountCents, isOpened)
  let netRefund = computeNetRefundCents(request.requestedAmountCents, fee)
  let receipt = {
    receiptId: "REC-" + request.refundId,
    orderId: request.orderId,
    refundedCents: netRefund,
    restockingFeeCents: fee,
    issuedTimestamp: now,
    gatewayReference: "GATEWAY-REF-" + request.refundId
  }
  receipt

fn buildOrderConfirmationEmail(orderId: str, email: str, totalCents: int, trackingNumber: str) -> OrderNotification:
  let dollars = (totalCents / 100).floor()
  let body = "Thank you for your order #" + orderId + ". Total: $" + dollars.toString() + ". Tracking: " + trackingNumber
  let notif = {
    notificationId: "NOTIF-" + orderId,
    recipientEmail: email,
    subject: "Order Confirmation - #" + orderId,
    bodyText: body,
    channel: "EMAIL",
    isSent: false
  }
  notif

fn buildShippingNotification(orderId: str, email: str, carrier: str, trackingUrl: str) -> OrderNotification:
  let body = "Your order #" + orderId + " has shipped via " + carrier + ". Track package: " + trackingUrl
  let notif = {
    notificationId: "SHIP-NOTIF-" + orderId,
    recipientEmail: email,
    subject: "Your Package is on the Way - #" + orderId,
    bodyText: body,
    channel: "EMAIL",
    isSent: false
  }
  notif

fn recordAuditTrail(action: str, entityType: str, entityId: str, actorId: str, now: int) -> AuditEntry:
  let entry = {
    auditId: "AUDIT-" + entityId + "-" + now.toString(),
    action,
    entityType,
    entityId,
    actorId,
    timestamp: now
  }
  entry

fn logDisputeFiled(disputeId: str, orderId: str, chargebackCents: int, reason: str, dueDate: int) -> DisputeRecord:
  let disp = {
    disputeId,
    orderId,
    chargebackCents,
    reasonCode: reason,
    evidenceDueDate: dueDate,
    isResolved: false
  }
  disp

fn resolveDispute(dispute: DisputeRecord) -> DisputeRecord:
  let updated = { ...dispute, isResolved: true }
  updated

fn calculateDailyMetrics(dateKey: str, received: int, dispatched: int, delivered: int, revenue: int) -> DailyFulfillmentMetrics:
  let m = {
    dateKey,
    ordersReceived: received,
    ordersDispatched: dispatched,
    ordersDelivered: delivered,
    averageProcessingMinutes: 45,
    grossRevenueCents: revenue
  }
  m

fn calculateFulfillmentEfficiency(metrics: DailyFulfillmentMetrics) -> int:
  if metrics.ordersReceived == 0:
    ret 100
  ((metrics.ordersDispatched * 100) / metrics.ordersReceived).floor()
fn verifyCheckoutPreconditions(session: CheckoutSession, profile: CustomerProfile) -> Result[bool, str]:
  if profile.isSuspended:
    ret Err("Suspended customer cannot initiate checkout")
  if session.isCompleted:
    ret Err("Checkout session already completed")
  Ok(true)

fn finalizeOrderCheckout(
  session: CheckoutSession,
  profile: CustomerProfile,
  cart: ShoppingCart,
  warehouses: [WarehouseLocation],
  carrier: ShippingRate,
  now: int
) -> Result[InvoiceSummary, str]:
  verifyCheckoutPreconditions(session, profile)?
  validateCheckoutItems(cart.items)?

  let subtotal = calculateCartSubtotalCents(cart.items)
  let weight = calculateCartWeightGrams(cart.items, 350)
  let shippingMoney = calculateShippingCost(weight, 50, carrier)

  let risk = evaluateOrderRisk(profile, subtotal, isDomesticShipment(session.shippingAddress, "USA"))
  if risk.riskLevel == "CRITICAL":
    ret Err("Order rejected by automated risk engine")

  let allocs = allocateOrderInventory(session.sessionId, cart.items, warehouses)?
  let payment = processCardPayment("TX-" + session.sessionId, session.sessionId, "STRIPE", subtotal + shippingMoney.amountInCents, now)?

  let invNum = generateInvoiceNumber(session.sessionId, now)
  let inv = buildInvoiceSummary(invNum, session.sessionId, subtotal, 0, shippingMoney.amountInCents, now)
  Ok(inv)

fn cancelOrderSession(session: CheckoutSession, reason: str, now: int) -> AuditEntry:
  let audit = recordAuditTrail("CANCEL_CHECKOUT", "CheckoutSession", session.sessionId, "SYSTEM", now)
  audit

fn computePackageVolumeCm3(lengthCm: int, widthCm: int, heightCm: int) -> int:
  lengthCm * widthCm * heightCm

fn computeDimensionalWeightGrams(lengthCm: int, widthCm: int, heightCm: int, divisor: int) -> int:
  let vol = computePackageVolumeCm3(lengthCm, widthCm, heightCm)
  ((vol * 1000) / divisor).floor()

fn determineBillableWeightGrams(actualWeightGrams: int, dimWeightGrams: int) -> int:
  if dimWeightGrams > actualWeightGrams:
    dimWeightGrams
  else:
    actualWeightGrams

fn formatCarrierTrackingUrl(config: CarrierConfig, trackingNum: str) -> str = generateTrackingUrl(config.trackingUrlTemplate, trackingNum)

fn shouldTriggerRestock(item: InventoryItem) -> bool = checkReorderNeeded(item)

fn generateRestockOrderSummary(item: InventoryItem, targetStock: int) -> int:
  let currentNet = item.availableQuantity - item.reservedQuantity
  let needed = targetStock - currentNet
  if needed < 0:
    0
  else:
    needed

fn computeGrossMarginBps(revenueCents: int, costCents: int) -> int:
  if revenueCents == 0:
    ret 0
  let profit = revenueCents - costCents
  ((profit * 10000) / revenueCents).floor()

fn validateCarrierAccount(config: CarrierConfig) -> bool:
  if config.carrierCode.len == 0:
    ret false
  if config.apiUrl.len == 0:
    ret false
  if config.accountNumber.len == 0:
    ret false
  true

fn calculateBatchPostageCost(manifest: ShippingManifest, costPerKgCents: int) -> int:
  let kg = (manifest.totalWeightGrams / 1000).floor()
  kg * costPerKgCents

fn isManifestFullyDelivered(manifest: ShippingManifest, deliveredTrackingCodes: [str]) -> bool:
  for track in manifest.trackingNumbers:
    if not deliveredTrackingCodes.contains(track):
      ret false
  true

fn createDefaultShippingRate(carrierName: str, basePriceCents: int) -> ShippingRate:
  let rate = {
    carrier: carrierName,
    serviceLevel: "EXPEDITED",
    baseCostCents: basePriceCents,
    perKilogramCents: 250,
    estimatedDays: 3
  }
  rate

fn calculateEstimatedFulfillmentHours(distanceKm: int, isExpress: bool) -> int:
  if isExpress:
    ret 24
  if distanceKm < 500:
    ret 48
  72

fn summarizeBatchShipment(batch: FulfillmentBatch, postageCents: int) -> BatchShipmentSummary:
  let summary = {
    batchId: batch.batchId,
    successfulCount: batch.totalPackages,
    failedCount: 0,
    totalPostageCents: postageCents
  }
  summary

fn shouldAutoReconcileDispute(record: DisputeRecord, autoSettleMaxCents: int) -> bool:
  if record.isResolved:
    ret false
  record.chargebackCents <= autoSettleMaxCents

fn computeTotalTaxOnCart(cart: ShoppingCart, rate: TaxRate) -> int:
  let subtotal = calculateCartSubtotalCents(cart.items)
  ((subtotal * rate.basisPoints) / 10000).floor()

fn formatNotificationPreview(notif: OrderNotification) -> str = "[" + notif.channel + "] To: " + notif.recipientEmail + " | " + notif.subject

fn markNotificationSent(notif: OrderNotification) -> OrderNotification:
  let updated = { ...notif, isSent: true }
  updated

fn evaluateExpressEligibility(subtotalCents: int, customerTier: str) -> bool:
  if customerTier == "PLATINUM":
    ret true
  subtotalCents >= 20000

fn buildWarehouseStatusReport(warehouse: WarehouseLocation) -> str:
  let load = calculateWarehouseLoadPercent(warehouse)
  let mut status = "NORMAL"
  if load >= 90:
    status = "OVERLOADED"
  elif load >= 75:
    status = "HIGH_TRAFFIC"
  warehouse.warehouseId + " (" + warehouse.name + ") Load: " + load.toString() + "% [" + status + "]"

fn canProcessImmediateRefund(profile: CustomerProfile, refundCents: int) -> bool:
  if profile.isSuspended:
    ret false
  if profile.tier == "PLATINUM":
    ret refundCents <= 50000
  if profile.tier == "GOLD":
    ret refundCents <= 25000
  refundCents <= 10000

fn calculateFulfillmentSla(orderId: str, createdAt: int, isExpress: bool, actualShippedAt: int) -> SlaEvaluationResult:
  let mut allowedHours = 48
  if isExpress:
    allowedHours = 24
  let targetTimestamp = createdAt + (allowedHours * 3600)
  let isBreached = actualShippedAt > targetTimestamp
  let mut reason = "ON_TIME"
  if isBreached:
    reason = "PROCESSING_DELAY"
  let res = {
    orderId: orderId,
    targetDispatchTimestamp: targetTimestamp,
    isBreached: isBreached,
    breachReason: reason
  }
  res

fn reconcilePaymentBatch(reportId: str, batchId: str, expectedCents: int, settledCents: int) -> ReconciliationReport:
  let diff = expectedCents - settledCents
  let isBalanced = diff == 0
  let rep = {
    reportId: reportId,
    batchId: batchId,
    expectedTotalCents: expectedCents,
    settledTotalCents: settledCents,
    discrepancyCents: diff,
    isBalanced: isBalanced
  }
  rep

fn checkCarrierRateExpired(rate: ShippingRate, quoteTimestamp: int, currentTimestamp: int) -> bool:
  let maxAgeSeconds = 86400
  (currentTimestamp - quoteTimestamp) > maxAgeSeconds
