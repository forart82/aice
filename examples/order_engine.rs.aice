enum PaymentMethod:
  CreditCard(str)
  BankTransfer(str)
  Crypto(str)

enum OrderStatus:
  Pending
  Confirmed
  Shipped(str)
  Cancelled(str)

type Order:
  id: str
  customerId: str
  subtotal: flt
  taxRate: flt
  isPriority: bool
  tags: [str]

fn calculateTotal(order: Order, discount: flt) -> Result[flt, str]:
  if discount < 0.0:
    ret Err("Discount rate cannot be negative")
  if discount > 0.5:
    ret Err("Maximum allowed discount rate is 50%")
  base: flt := order.subtotal * (1.0 - discount)
  tax: flt := base * order.taxRate
  ret Ok(base + tax)

fn validateOrderId(rawId: str) -> Result[str, str]:
  clean: str := rawId.trim()
  if clean.isEmpty():
    ret Err("Order ID cannot be empty")
  if !clean.contains("-"):
    ret Err("Order ID must follow standard format with hyphen delimiter")
  ret Ok(clean)

fn processOrder(rawId: str, order: Order, discount: flt) -> Result[flt, str]:
  validId: str := validateOrderId(rawId)?
  total: flt := calculateTotal(order, discount)?
  ret Ok(total)

fn getStatusCode(status: OrderStatus) -> int:
  match status:
    Pending => 100
    Confirmed => 200
    Shipped(tracking) => 300
    Cancelled(reason) => 400
    _ => 0
