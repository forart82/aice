component EnterprisePortal():
  html(lang: "en"):
    head:
      meta(charset: "utf-8")
      meta(name: "viewport", content: "width=device-width, initial-scale=1.0")
      meta(name: "description", content: "Unified Cloud Observability and Stream Processing Control Plane")
      title: "Enterprise Cloud Observability & Stream Control Plane"
      link(rel: "stylesheet", href: "enterprise_theme.css")
      script(src: "enterprise_portal.js", defer: true)
    body.app-shell:
      header.top-navbar:
        .navbar-brand-section:
          .brand-logo-wrapper:
            _.brand-icon: "⚡"
            _.brand-name: "AICE CloudOps"
          _.badge.badge-env-prod: "PRODUCTION"
          _.badge.badge-region: "us-east-1 (N. Virginia)"
        .navbar-search-section:
          .search-input-wrapper:
            _.search-icon: "🔍"
            input.search-input(type: "text", placeholder: "Search services, traces, metrics, deployments (Press ⌘K)")
            _.shortcut-hint: "⌘K"
        .navbar-actions-section:
          button.btn.btn-icon#btn-theme-toggle:
            _.icon: "🌙"
          button.btn.btn-icon.notification-bell#btn-notifications:
            _.icon: "🔔"
            _.notification-count-badge: "3"
          .cluster-selector-dropdown:
            _.cluster-status-dot.dot-online: "●"
            _.cluster-label: "k8s-prod-us-east-core-01"
            _.dropdown-chevron: "▾"
          .user-profile-widget:
            .avatar-circle: "FA"
            .user-meta:
              _.user-display-name: "Principal Staff SRE"
              _.tenant-badge: "FinTech Platform Core"
      .layout-workspace:
        aside.navigation-sidebar:
          .sidebar-section:
            _.section-heading: "OBSERVABILITY"
            ul.nav-menu:
              .nav-item.active:
                _.nav-icon: "📊"
                _.nav-label: "Live Telemetry"
              .nav-item:
                _.nav-icon: "🌊"
                _.nav-label: "Stream Pipelines"
              .nav-item:
                _.nav-icon: "📡"
                _.nav-label: "Service Mesh"
              .nav-item:
                _.nav-icon: "🔍"
                _.nav-label: "Distributed Traces"
              .nav-item:
                _.nav-icon: "📝"
                _.nav-label: "Structured Logs"
          .sidebar-section:
            _.section-heading: "INFRASTRUCTURE"
            ul.nav-menu:
              .nav-item:
                _.nav-icon: "☸️"
                _.nav-label: "Kubernetes Clusters"
              .nav-item:
                _.nav-icon: "📦"
                _.nav-label: "Pod Replicas"
              .nav-item:
                _.nav-icon: "💾"
                _.nav-label: "Storage Volumes"
              .nav-item:
                _.nav-icon: "🌐"
                _.nav-label: "Ingress Load Balancers"
          .sidebar-section:
            _.section-heading: "INCIDENT RESPONSE"
            ul.nav-menu:
              .nav-item:
                _.nav-icon: "🚨"
                _.nav-label: "PagerDuty Alerts"
                _.pill-badge-alert: "2 Active"
              .nav-item:
                _.nav-icon: "📖"
                _.nav-label: "Automated Runbooks"
              .nav-item:
                _.nav-icon: "🛡️"
                _.nav-label: "Chaos Engineering"
          .sidebar-section:
            _.section-heading: "GOVERNANCE & SETTINGS"
            ul.nav-menu:
              .nav-item:
                _.nav-icon: "🔐"
                _.nav-label: "IAM & Access Roles"
              .nav-item:
                _.nav-icon: "📜"
                _.nav-label: "Compliance Audits"
              .nav-item:
                _.nav-icon: "⚙️"
                _.nav-label: "Platform Config"
          .sidebar-footer:
            .system-status-indicator:
              _.status-pulse-dot: "●"
              _.status-text: "All 42 Systems Operational"
            _.agent-version: "AICE Runtime v2.4.0-rc3"
        main.main-content-viewport:
          .page-header-row:
            .header-title-block:
              h1.page-heading: "Global Streaming Telemetry & Mesh Fleet"
              p.page-subheading: "Real-time distributed stream ingestion, microservice P99 SLAs, and automated anomaly routing"
            .header-action-group:
              button.btn.btn-secondary#btn-export-telemetry:
                _.btn-icon: "📥"
                _.btn-text: "Export Telemetry (CSV)"
              button.btn.btn-primary#btn-trigger-checkpoint:
                _.btn-icon: "💾"
                _.btn-text: "Trigger Checkpoint"
              button.btn.btn-danger#btn-quarantine-mode:
                _.btn-icon: "⚠️"
                _.btn-text: "Quarantine Shards"
          section.kpi-grid-container:
            .kpi-card:
              .kpi-top-row:
                _.kpi-title: "INGESTION THROUGHPUT"
                _.kpi-badge.badge-trend-up: "+14.6%"
              .kpi-value-row:
                _.kpi-metric-number: "842,510"
                _.kpi-metric-unit: "events/sec"
              .kpi-progress-bar-track:
                .kpi-progress-fill(style: "width: 78%")
              .kpi-bottom-legend:
                _.kpi-subtitle: "Peak: 1,050,000 rps"
                _.kpi-status-ok: "Nominal"
            .kpi-card:
              .kpi-top-row:
                _.kpi-title: "SERVICE MESH P99 LATENCY"
                _.kpi-badge.badge-trend-down: "-3.2ms"
              .kpi-value-row:
                _.kpi-metric-number: "14.2"
                _.kpi-metric-unit: "milliseconds"
              .kpi-progress-bar-track:
                .kpi-progress-fill.progress-fill-emerald(style: "width: 24%")
              .kpi-bottom-legend:
                _.kpi-subtitle: "SLA Target: < 45.0ms"
                _.kpi-status-ok: "Within SLO"
            .kpi-card:
              .kpi-top-row:
                _.kpi-title: "ERROR BUDGET BURN RATE"
                _.kpi-badge.badge-trend-stable: "0.02x"
              .kpi-value-row:
                _.kpi-metric-number: "99.994"
                _.kpi-metric-unit: "% availability"
              .kpi-progress-bar-track:
                .kpi-progress-fill.progress-fill-blue(style: "width: 98%")
              .kpi-bottom-legend:
                _.kpi-subtitle: "Budget Remaining: 89.4%"
                _.kpi-status-ok: "30-Day Window"
            .kpi-card:
              .kpi-top-row:
                _.kpi-title: "ACTIVE STREAM WORKERS"
                _.kpi-badge.badge-nodes: "128 / 128"
              .kpi-value-row:
                _.kpi-metric-number: "100"
                _.kpi-metric-unit: "% online"
              .kpi-progress-bar-track:
                .kpi-progress-fill.progress-fill-purple(style: "width: 100%")
              .kpi-bottom-legend:
                _.kpi-subtitle: "0 Failed Replicas"
                _.kpi-status-ok: "Autoscaling Idle"
          section.toolbar-filter-section:
            .filter-control-group:
              label.filter-label: "Service Filter:"
              select.filter-select#filter-service-tier:
                option(value: "all"): "All Microservices (18 Services)"
                option(value: "tier0"): "Tier 0 Critical Path"
                option(value: "tier1"): "Tier 1 Streaming & Queues"
                option(value: "tier2"): "Tier 2 Analytical Ingestion"
            .filter-control-group:
              label.filter-label: "Time Window:"
              .button-toggle-group:
                button.btn-toggle.active: "15m"
                button.btn-toggle: "1h"
                button.btn-toggle: "6h"
                button.btn-toggle: "24h"
                button.btn-toggle: "7d"
            .filter-control-group:
              label.filter-label: "Region:"
              select.filter-select#filter-region:
                option(value: "all"): "Global Multi-Region"
                option(value: "us-east-1"): "us-east-1 (Virginia)"
                option(value: "eu-central-1"): "eu-central-1 (Frankfurt)"
                option(value: "ap-northeast-1"): "ap-northeast-1 (Tokyo)"
          section.data-table-container:
            .table-header-bar:
              .table-title-area:
                h2.table-title: "Microservice Fleet Health & Latency Budget"
                _.table-subtitle: "Auto-refreshed every 2000ms via WebSocket telemetry stream"
              .table-actions:
                input.table-quick-search(type: "search", placeholder: "Quick filter table...")
            .table-responsive-wrapper:
              table.enterprise-table:
                thead:
                  tr:
                    th: "SERVICE NAME"
                    th: "VERSION"
                    th: "TIER"
                    th: "REPLICAS"
                    th: "P50 LATENCY"
                    th: "P95 LATENCY"
                    th: "P99 LATENCY"
                    th: "ERROR RATE"
                    th: "THROUGHPUT"
                    th: "STATUS"
                    th: "ACTIONS"
                tbody:
                  tr:
                    .col-service-name:
                      _.service-name-text: "auth-identity-service"
                      _.service-type-tag: "gRPC"
                    td: "v3.18.2"
                    td:
                      _.badge.badge-tier-0: "Tier 0"
                    td: "16 / 16"
                    td: "1.8ms"
                    td: "4.2ms"
                    td: "8.9ms"
                    td: "0.001%"
                    td: "64,200 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "order-orchestrator-api"
                      _.service-type-tag: "REST"
                    td: "v4.2.0"
                    td:
                      _.badge.badge-tier-0: "Tier 0"
                    td: "24 / 24"
                    td: "4.6ms"
                    td: "11.2ms"
                    td: "18.4ms"
                    td: "0.003%"
                    td: "48,150 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "stream-processor-engine"
                      _.service-type-tag: "AICE Pipeline"
                    td: "v2.4.0"
                    td:
                      _.badge.badge-tier-0: "Tier 0"
                    td: "32 / 32"
                    td: "0.9ms"
                    td: "2.1ms"
                    td: "5.4ms"
                    td: "0.000%"
                    td: "420,000 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "payment-gateway-relay"
                      _.service-type-tag: "TLS / PCI"
                    td: "v2.9.1"
                    td:
                      _.badge.badge-tier-0: "Tier 0"
                    td: "12 / 12"
                    td: "12.4ms"
                    td: "28.5ms"
                    td: "42.1ms"
                    td: "0.012%"
                    td: "8,920 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "fraud-scoring-evaluator"
                      _.service-type-tag: "ML / Rust"
                    td: "v1.14.7"
                    td:
                      _.badge.badge-tier-1: "Tier 1"
                    td: "20 / 20"
                    td: "3.2ms"
                    td: "7.8ms"
                    td: "14.6ms"
                    td: "0.002%"
                    td: "32,400 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "telemetry-collector-agent"
                      _.service-type-tag: "OTel / Go"
                    td: "v0.94.0"
                    td:
                      _.badge.badge-tier-1: "Tier 1"
                    td: "64 / 64"
                    td: "0.4ms"
                    td: "1.1ms"
                    td: "2.8ms"
                    td: "0.000%"
                    td: "850,000 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "inventory-ledger-worker"
                      _.service-type-tag: "EventStore"
                    td: "v3.0.4"
                    td:
                      _.badge.badge-tier-1: "Tier 1"
                    td: "10 / 10"
                    td: "5.1ms"
                    td: "12.8ms"
                    td: "22.3ms"
                    td: "0.004%"
                    td: "19,800 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "dead-letter-quarantine"
                      _.service-type-tag: "DLQ SQS"
                    td: "v1.2.0"
                    td:
                      _.badge.badge-tier-2: "Tier 2"
                    td: "4 / 4"
                    td: "1.2ms"
                    td: "3.4ms"
                    td: "6.8ms"
                    td: "0.000%"
                    td: "142 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "audit-compliance-logger"
                      _.service-type-tag: "WORM S3"
                    td: "v2.1.1"
                    td:
                      _.badge.badge-tier-2: "Tier 2"
                    td: "8 / 8"
                    td: "6.4ms"
                    td: "15.0ms"
                    td: "31.2ms"
                    td: "0.001%"
                    td: "55,200 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
                  tr:
                    .col-service-name:
                      _.service-name-text: "notification-dispatch-bus"
                      _.service-type-tag: "Kafka"
                    td: "v2.6.5"
                    td:
                      _.badge.badge-tier-2: "Tier 2"
                    td: "12 / 12"
                    td: "2.3ms"
                    td: "5.8ms"
                    td: "11.7ms"
                    td: "0.005%"
                    td: "14,300 rps"
                    td:
                      _.status-pill.status-healthy: "HEALTHY"
                    td:
                      button.btn-table-action: "Inspect"
          section.dashboard-dual-split-section:
            .panel-box.panel-anomalies:
              .panel-header:
                .panel-title-group:
                  _.panel-icon: "⚠️"
                  h3.panel-title: "Live Z-Score Anomaly Feed"
                _.badge.badge-warning: "4 Detected in 1h"
              ul.anomaly-list:
                .anomaly-item:
                  .anomaly-meta:
                    _.anomaly-time: "14:22:04.118"
                    _.badge.badge-danger: "Critical (z=4.2)"
                  p.anomaly-desc: "Metric stream-processor-engine.varianceSpike exceeded 3-sigma tolerance (+4.2σ)"
                  .anomaly-footer:
                    _.trace-link: "Trace ID: 7f8a91c0b4d241ea"
                    button.btn-ack: "Acknowledge"
                .anomaly-item:
                  .anomaly-meta:
                    _.anomaly-time: "14:18:51.842"
                    _.badge.badge-warning: "Warning (z=3.1)"
                  p.anomaly-desc: "Metric payment-gateway-relay.p99Latency rose to 42.1ms (Historical baseline 18.0ms)"
                  .anomaly-footer:
                    _.trace-link: "Trace ID: 1a92e4fc88031d2b"
                    button.btn-ack: "Acknowledge"
                .anomaly-item:
                  .anomaly-meta:
                    _.anomaly-time: "14:02:11.390"
                    _.badge.badge-info: "Notice (z=2.8)"
                  p.anomaly-desc: "Late event watermark lag spike in partition-04: 12.4s delayed arrival"
                  .anomaly-footer:
                    _.trace-link: "Trace ID: c824b01fe4882199"
                    button.btn-ack: "Acknowledge"
            .panel-box.panel-incidents:
              .panel-header:
                .panel-title-group:
                  _.panel-icon: "🚨"
                  h3.panel-title: "Active Incident Command & Runbooks"
                _.badge.badge-neutral: "Zero P1 Outages"
              .incident-card-container:
                .incident-card.incident-card-low:
                  .incident-card-top:
                    _.badge.badge-sev-p3: "SEV-3"
                    _.incident-id: "INC-8842"
                    _.incident-duration: "Elapsed: 28m"
                  h4.incident-card-heading: "Minor Kafka Lag on Consumer Group analytics-batch-indexer"
                  p.incident-card-body: "Lag reached 14,200 records on partition 11. Consumer instances auto-healing."
                  .incident-assignee:
                    _.assignee-avatar: "JD"
                    _.assignee-name: "John Doe (On-Call SRE)"
                  .incident-action-row:
                    button.btn.btn-sm.btn-outline: "View War Room"
                    button.btn.btn-sm.btn-primary: "Execute Auto-Scale Runbook"
          section.partition-checkpoint-section:
            .panel-box:
              .panel-header:
                h3.panel-title: "Stream Partition Watermarks & Checkpoint Offsets"
                _.checkpoint-badge: "Last Epoch Checkpoint: 42s ago"
              .partition-table-wrapper:
                table.partition-table:
                  thead:
                    tr:
                      th: "PARTITION"
                      th: "LEADER BROKER"
                      th: "HEAD OFFSET"
                      th: "COMMITTED"
                      th: "LAG"
                      th: "WATERMARK LAG"
                      th: "HEALTH"
                  tbody:
                    tr:
                      td: "shard-partition-00"
                      td: "broker-us-east-1a"
                      td: "18,492,010"
                      td: "18,492,010"
                      td: "0 records"
                      td: "120ms"
                      td:
                        _.tag-online: "ACTIVE"
                    tr:
                      td: "shard-partition-01"
                      td: "broker-us-east-1a"
                      td: "19,104,821"
                      td: "19,104,815"
                      td: "6 records"
                      td: "140ms"
                      td:
                        _.tag-online: "ACTIVE"
                    tr:
                      td: "shard-partition-02"
                      td: "broker-us-east-1b"
                      td: "17,820,443"
                      td: "17,820,443"
                      td: "0 records"
                      td: "115ms"
                      td:
                        _.tag-online: "ACTIVE"
                    tr:
                      td: "shard-partition-03"
                      td: "broker-us-east-1c"
                      td: "21,049,180"
                      td: "21,049,178"
                      td: "2 records"
                      td: "135ms"
                      td:
                        _.tag-online: "ACTIVE"
          footer.app-footer:
            .footer-left:
              _.legal-text: "© 2026 AICE Autonomous Infrastructure Labs. All rights reserved."
              _.footer-divider: "|"
              _.soc2-badge: "SOC-2 Type II Certified"
              _.footer-divider: "|"
              _.iso-badge: "ISO/IEC 27001 Compliant"
            .footer-right:
              _.telemetry-ping: "Edge Ping: 3ms"
              _.engine-hash: "Build: sha-e84b12c"
              _.runtime-env: "Cluster: k8s-prod-us-east-core-01"
      .modal-backdrop.hidden#modal-create-alert:
        .modal-dialog:
          .modal-header:
            h3.modal-title: "Create Automated Anomaly Alert Rule"
            button.modal-close-btn: "✕"
          .modal-body:
            .form-group:
              label.form-label: "Target Metric Stream"
              input.form-input(type: "text", placeholder: "e.g. stream-processor-engine.varianceEma")
            .form-group:
              label.form-label: "Threshold Standard Deviations (Sigma)"
              input.form-input(type: "number", value: "3.5", step: "0.1")
            .form-group:
              label.form-label: "Notification Target Channel"
              select.form-select:
                option: "#sre-critical-incidents"
                option: "#stream-telemetry-alerts"
                option: "PagerDuty P1 On-Call Service"
          .modal-footer:
            button.btn.btn-secondary: "Cancel"
            button.btn.btn-primary: "Save and Arm Alert"
