;; High-throughput Real-time Telemetry & Metrics Aggregator
(@module analytics/pipeline
  (: MetricEntry
    (% timestamp !i metricName !s value !f tag !s)
  )

  (: SummaryReport
    (% count !i totalValue !f averageValue !f primaryTag !s)
  )

  (! sanitizeTag (-> (rawTag !s) !s)
    (str:slice rawTag 0 16)
  )

  (! addPoint (-> (points [MetricEntry] newPoint MetricEntry) [MetricEntry])
    (arr:append points newPoint)
  )

  (! calculateAverage (-> (total !f count !i) !f)
    (/ total count)
  )

  (! createEntry (-> (time !i name !s val !f rawTag !s) MetricEntry)
    (do
      (:= cleanTag (sanitizeTag rawTag))
      (% timestamp time metricName name value val tag cleanTag)
    )
  )
)
