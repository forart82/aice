{
  "name": "tree-sitter-aice",
  "version": "1.0.0",
  "description": "Tree-sitter grammar for AICE (AI Context Engine)",
  "main": "bindings/node",
  "keywords": [
    "parser",
    "lexer",
    "tree-sitter",
    "aice"
  ],
  "author": "Antigravity",
  "license": "Apache-2.0",
  "dependencies": {
    "nan": "^2.20.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.22.6"
  },
  "tree-sitter": [
    {
      "scope": "source.aice",
      "file-types": [
        "aice",
        "ts.aice",
        "tsx.aice",
        "py.aice",
        "html.aice",
        "css.aice"
      ],
      "highlights": "queries/highlights.scm"
    }
  ]
}
